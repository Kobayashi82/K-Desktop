<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the web view: the logo shows from the first instant, before the web view has drawn anything. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window" />
    <item>
        <bitmap android:src="@drawable/splash_logo" android:gravity="center" />
    </item>
</layer-list>
