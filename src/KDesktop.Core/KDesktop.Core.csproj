<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KDesktop.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- Only the .NET wrapper: it uses the onnxruntime.dll that sherpa-onnx already ships (1.28.2; the C API is
         backward compatible), so there is a single native runtime. Keep it at or below that version. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
    <!-- SpeexDSP's echo canceller (native only; Voice/EchoCanceller.cs). BSD (Xiph.org). -->
    <PackageReference Include="SpeexDSPSharp.Natives" Version="1.3.0" />
  </ItemGroup>

  <!-- Built-in languages and sounds travel inside the assembly (and so inside the single-file exe).
       Files in %APPDATA%\K-Desktop 5\Languages and \Sounds add to them and win on duplicates. -->
  <ItemGroup>
    <None Remove="Languages\*.json" />
    <EmbeddedResource Include="Languages\*.json" LogicalName="Languages/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Sounds/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The remote web app (PWA), served by Remote/Web/WebServer. -->
  <ItemGroup>
    <None Remove="Web\**" />
    <EmbeddedResource Include="Web\**" LogicalName="Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
