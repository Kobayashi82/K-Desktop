<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KDesktop.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Recording video (F2): the frames of Windows.Graphics.Capture on Direct3D 11 -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- and the clicks drawn on them -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- Only the .NET wrapper: it uses the onnxruntime.dll that sherpa-onnx already ships (1.28.2; the C API is
         backward compatible), so there is a single native runtime. Keep it at or below that version. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
    <!-- SpeexDSP's echo canceller (native only; Voice/EchoCanceller.cs). BSD (Xiph.org). -->
    <PackageReference Include="SpeexDSPSharp.Natives" Version="1.3.0" />
    <!-- SentencePiece tokenizer of EmbeddingGemma (Voice/TextEmbedder.cs). MIT (.NET Foundation). -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <!-- DPAPI: secret headers of «Petición web» (Platform/Secrets.cs). MIT (.NET Foundation). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- WMI: the brightness of a laptop's own screen («Pantalla», Platform/DisplayTools.cs). MIT (.NET Foundation). -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- JSON Schema: checking assistant packages (Assistant/Packages). MIT up to 8.x (9 is not). Its global «Json»
         namespace would hide K-Desktop's Json class in the projects that use Core: only its runtime goes on. -->
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" PrivateAssets="compile" />
    <!-- The mail (Mail/): IMAP with IDLE and SMTP, with XOAUTH2 for Google and Microsoft. MIT (Jeffrey Stedfast). -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <!-- Telegram with an account with a phone number (Remote/Telegram/TelegramUserConnection: MTProto). MIT (Wizou).
         Only Core sees its types (TL.*): the rest of the projects only get its runtime. -->
    <PackageReference Include="WTelegramClient" Version="4.4.9" PrivateAssets="compile" />
  </ItemGroup>

  <!-- Types shared with the assistant process: gestures for the choreography map (Assistant/). -->
  <ItemGroup>
    <ProjectReference Include="..\KDesktop.Assistant.Sdk\KDesktop.Assistant.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KDesktop.Core.Tests" />
  </ItemGroup>

  <!-- Built-in languages and sounds travel inside the assembly (and so inside the single-file exe).
       Files in %APPDATA%\K-Desktop 5\Languages and \Sounds add to them and win on duplicates. -->
  <ItemGroup>
    <None Remove="Languages\*.json" />
    <EmbeddedResource Include="Languages\*.json" LogicalName="Languages/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Sounds/%(Filename)%(Extension)" />
    <!-- «bench.es.json» is not a resource for Spanish culture (a satellite assembly): it goes in like the rest. -->
    <EmbeddedResource Include="Assistant\Bench\*.json" LogicalName="AssistantBench/%(Filename)%(Extension)" WithCulture="false" />
    <!-- The files of Kokoro and espeak-ng (pinned commit and package, sizes and hashes): the assistants' voice (5.0.94). -->
    <EmbeddedResource Include="Assistant\Voice\kokoro.json" LogicalName="AssistantVoice/kokoro.json" />
    <!-- The publishers whose signed assistants are «verificados» (stage 12): their name and public key. -->
    <EmbeddedResource Include="Assistant\Packages\trusted-publishers.json" LogicalName="AssistantPackages/trusted-publishers.json" />
    <!-- The Piper voices (pinned commit of rhasspy/piper-voices, sizes and hashes): the second natural voice (5.0.110). -->
    <EmbeddedResource Include="Assistant\Voice\piper.json" LogicalName="AssistantVoice/piper.json" />
    <!-- K-Desktop's six voice profiles (stage 5.5). -->
    <EmbeddedResource Include="Assistant\Voice\voice-profiles.json" LogicalName="AssistantVoice/voice-profiles.json" />
  </ItemGroup>

  <!-- The schemas of assistant packages (docs\assistant\schemas): K-Desktop checks a package with them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\assistant\schemas\*.schema.json" LogicalName="AssistantSchemas/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The remote web app (PWA), served by Remote/Web/WebServer. -->
  <ItemGroup>
    <None Remove="Web\**" />
    <EmbeddedResource Include="Web\**" LogicalName="Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The Android app travels inside too: K-Desktop offers it to phones with an older one (api/android). A Release
    build makes it first (tools\android\build-apk.ps1, only when android\ changed and the JDK and the SDK are on this
    PC); any build carries the last one made, if there is one.
  -->
  <PropertyGroup>
    <_AndroidDir>$(MSBuildThisFileDirectory)..\..\android\</_AndroidDir>
    <_AndroidApk>$(MSBuildThisFileDirectory)..\..\artifacts\android\KDesktop.apk</_AndroidApk>
    <_AndroidScript>$(MSBuildThisFileDirectory)..\..\tools\android\build-apk.ps1</_AndroidScript>
    <_AndroidJdk Condition="'$(JAVA_HOME)' != ''">$(JAVA_HOME)</_AndroidJdk>
    <_AndroidJdk Condition="'$(JAVA_HOME)' == ''">$(LOCALAPPDATA)\Programs\jdk-17</_AndroidJdk>
    <_AndroidSdk Condition="'$(ANDROID_HOME)' != ''">$(ANDROID_HOME)</_AndroidSdk>
    <_AndroidSdk Condition="'$(ANDROID_HOME)' == ''">$(LOCALAPPDATA)\Android\Sdk</_AndroidSdk>
  </PropertyGroup>

  <Target Name="BuildAndroidApp" BeforeTargets="BeforeBuild"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and Exists('$(_AndroidJdk)\bin\javac.exe') and Exists('$(_AndroidSdk)\build-tools\34.0.0')"
          Inputs="@(_AndroidSources);$(MSBuildThisFileDirectory)..\..\Directory.Build.props;$(_AndroidScript)" Outputs="$(_AndroidApk);$(_AndroidApk).json"
          DependsOnTargets="_AndroidSources">
    <Message Importance="high" Text="KDesktop.Core -&gt; creando la app de Android..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_AndroidScript)&quot;" StandardOutputImportance="low" />
  </Target>

  <Target Name="_AndroidSources">
    <ItemGroup>
      <_AndroidSources Include="$(_AndroidDir)**\*" />
      <!-- The look its own pages share with the web app (copied into its assets) -->
      <_AndroidSources Include="$(MSBuildThisFileDirectory)Web\kd.css" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedAndroidApp" BeforeTargets="BeforeBuild" AfterTargets="BuildAndroidApp" Condition="Exists('$(_AndroidApk).json')">
    <ItemGroup>
      <EmbeddedResource Include="$(_AndroidApk)" LogicalName="Android/KDesktop.apk" />
      <EmbeddedResource Include="$(_AndroidApk).json" LogicalName="Android/KDesktop.apk.json" />
    </ItemGroup>
  </Target>

</Project>
