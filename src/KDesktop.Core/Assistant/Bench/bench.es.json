{
  "about": "Banco de pruebas de los asistentes: órdenes y lo que se espera de cada una. «tool»: una herramienta (o una lista: vale cualquiera) que debe usar; «noTool»: que conteste sin herramientas; «answerContains»: algo que debe decir (vale cualquiera de la lista); «command»: uno de tus comandos de K-Desktop que debe ejecutar, por su nombre (o una lista). Las herramientas que hacen algo no lo hacen de verdad durante la prueba.",
  "cases": [
    { "say": "¿qué hora es?", "expect": { "tool": "get_time" } },
    { "say": "¿qué día es hoy?", "expect": { "tool": "get_time" } },
    { "say": "pon un temporizador de 10 minutos", "expect": { "tool": "set_timer" } },
    { "say": "avísame dentro de un ratito largo, como tres cuartos de hora", "expect": { "tool": "set_timer" } },
    { "say": "despiértame a las siete y media", "expect": { "tool": "set_timer" } },
    { "say": "pon una alarma para dentro de veinte minutos para sacar la ropa", "expect": { "tool": "set_timer" } },
    { "say": "¿cuánto le queda al temporizador?", "expect": { "tool": "get_time" } },
    { "say": "quita el temporizador", "expect": { "tool": "cancel_timer" } },
    { "say": "apunta que tengo que comprar pilas", "expect": { "tool": "save_note" } },
    { "say": "guárdame esta idea: una app para regar las plantas", "expect": { "tool": "save_note" } },
    { "say": "apúntame en la lista de la compra leche y huevos", "expect": { "tool": "save_note" } },
    { "say": "¿qué tenía que comprar?", "expect": { "tool": "find_notes" } },
    { "say": "léeme mis notas", "expect": { "tool": "find_notes" } },
    { "say": "¿tengo algo apuntado sobre el dentista?", "expect": { "tool": "find_notes" } },
    { "say": "¿cuánto es el 18 por ciento de 240?", "expect": { "tool": "calculate", "answerContains": ["43,2", "43.2"] } },
    { "say": "divide 1500 entre 7", "expect": { "tool": "calculate", "answerContains": ["214"] } },
    { "say": "¿qué día de la semana fue el 1 de enero de 2026?", "expect": { "tool": "date_math", "answerContains": ["jueves"] } },
    { "say": "si salgo a las 17:40 y tardo dos horas y tres cuartos, ¿a qué hora llego?", "expect": { "tool": "date_math", "answerContains": ["20:25"] } },
    { "say": "¿cuántos días tiene el año 2028?", "expect": { "answerContains": ["366"] } },
    { "say": "si me gasto 37 euros de 120, ¿cuánto me queda?", "expect": { "answerContains": ["83"] } },
    { "say": "¿cuánto son 3 elevado a 5?", "expect": { "answerContains": ["243"] } },
    { "say": "abre youtube", "expect": { "tool": "open_web" } },
    { "say": "entra en la web de la Wikipedia", "expect": { "tool": ["open_web", "search_web"] } },
    { "say": "busca recetas de lentejas", "expect": { "tool": "search_web" } },
    { "say": "mira en internet cuándo es el próximo eclipse", "expect": { "tool": ["look_up_web", "search_web"] } },
    { "say": "busca en google el horario del Mercadona", "expect": { "tool": ["search_web", "look_up_web"] } },
    { "say": "abre la calculadora", "expect": { "tool": "open_app" } },
    { "say": "ábreme el bloc de notas", "expect": { "tool": "open_app" } },
    { "say": "recuerda que mi jefe se llama Luis", "expect": { "tool": "remember" } },
    { "say": "ten en cuenta que soy alérgico a las nueces", "expect": { "tool": "remember" } },
    { "say": "¿qué tal estás?", "expect": { "noTool": true } },
    { "say": "cuéntame un chiste corto", "expect": { "noTool": true } },
    { "say": "gracias, majo", "expect": { "noTool": true } },
    { "say": "¿cuál es la capital de Australia?", "expect": { "noTool": true, "answerContains": ["Canberra"] } },
    { "say": "¿cuántos minutos tiene un día?", "expect": { "answerContains": ["1440", "1.440"] } },
    { "say": "búscame el pdf de la factura de la luz", "expect": { "tool": "find_files" } },
    { "say": "¿dónde guardé las fotos de la boda?", "expect": { "tool": "find_files" } },
    { "say": "abre lo último que descargué", "expect": { "tool": ["open_file", "find_files"] } },
    { "say": "¿qué error me sale en esta ventana?", "expect": { "tool": "look_at_screen" } },
    { "say": "resúmeme la página que tengo abierta", "expect": { "tool": "read_web" } }
  ]
}
