{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdesktop/assistant/mcp.schema.json",
  "title": "MCP servers",
  "description": "<data>\\Assistant\\mcp.json: the mcpServers format of other MCP clients (Claude Desktop, mcpo…), plus disabled, timeout and idleMinutes. Values accept {{secret:name}}.",
  "type": "object",
  "required": ["mcpServers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "mcpServers": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
      "additionalProperties": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "strings": { "type": "object", "additionalProperties": { "type": "string" } },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1, "description": "The program: node, npx, uvx, uv, python, an .exe…" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "$ref": "#/$defs/strings", "description": "Environment variables; secrets as {{secret:name}}" },
        "cwd": { "type": "string", "description": "Folder it starts in" },
        "url": { "type": "string", "pattern": "^https?://", "description": "A server over HTTP instead of a program" },
        "headers": { "$ref": "#/$defs/strings" },
        "type": { "enum": ["stdio", "http", "streamable_http", "streamable-http", "sse"], "description": "sse: the old transport; without it, it is found out" },
        "disabled": { "type": "boolean" },
        "timeout": { "type": "number", "minimum": 5, "maximum": 600, "description": "Seconds at most per call (60)" },
        "idleMinutes": { "type": "number", "minimum": 0.5, "maximum": 240, "description": "It stops after this long unused (5)" }
      },
      "oneOf": [
        { "required": ["command"], "not": { "required": ["url"] } },
        { "required": ["url"], "not": { "required": ["command"] } }
      ]
    }
  }
}
