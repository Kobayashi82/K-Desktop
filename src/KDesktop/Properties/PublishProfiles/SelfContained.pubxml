<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación self-contained en un solo ejecutable (no necesita .NET instalado).

  Opciones elegidas para reducir los falsos positivos de los antivirus:
    · EnableCompressionInSingleFile = false  → el bundle NO se comprime. La compresión
      sube la entropía del archivo y las heurísticas la confunden con un "packer" de malware.
    · PublishReadyToRun = true               → el código va precompilado a nativo; evita que
      el antivirus vea generación/compilación de código en tiempo de ejecución (otra heurística).
    · PublishReadyToRunComposite = false     → cada ensamblado con su código nativo (los de .NET ya vienen así).
    · PublishTrimmed = false                 → no se reescribe la IL (WPF no soporta bien el
      recorte y además la reescritura también levanta sospechas).
    · DebugType = none                        → sin PDB junto al ejecutable.

  El modo de verdad para que NINGÚN antivirus proteste es FIRMAR el .exe con un
  certificado de firma de código (Authenticode). Descartado: sin certificados de pago, el exe va sin firmar.

  Uso:
    dotnet publish src\KDesktop\KDesktop.csproj -c Release -p:PublishProfile=SelfContained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Not one composite image (the default of a single file): it compiles all of .NET again, while its own assemblies already
         come precompiled. Measured with WinRT (5.0.143): 224 MB instead of 288, 9 MB less memory, 0,13 s more to start. -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>neutral</SatelliteResourceLanguages>
    <PublishDir>..\..\artifacts\portable</PublishDir>
  </PropertyGroup>
</Project>
