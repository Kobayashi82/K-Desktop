<UserControl x:Class="KDesktop.Views.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             HorizontalAlignment="Left">
    <UserControl.Resources>
        <!-- Day, month and year: digits only, no box of their own (the frame around them is the box), as in TimeField -->
        <Style x:Key="Part" TargetType="TextBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Kd.Accent}" />
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="Frame" MinHeight="34" CornerRadius="4" BorderThickness="1" Padding="10,0,2,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <StackPanel Orientation="Horizontal">
                <!-- The three parts, in the order of the language (built in code) -->
                <StackPanel x:Name="Parts" Orientation="Horizontal" />
                <ui:Button x:Name="ClearButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" Padding="5" Visibility="Collapsed"
                           ToolTip="{l:Tr event.dateClear}" AutomationProperties.Name="{l:Tr event.dateClear}" Click="OnClear">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                </ui:Button>
                <ui:Button Style="{StaticResource IconButton}" Margin="2,0,0,0" Padding="6" ToolTip="{l:Tr time.calendar}"
                           AutomationProperties.Name="{l:Tr time.calendar}" Click="OnCalendar">
                    <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </Border>
        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=Frame}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade">
            <Calendar x:Name="Picker" Style="{StaticResource SolidCalendar}" Margin="0,4,0,0" SelectedDatesChanged="OnPicked" />
        </Popup>
    </Grid>
</UserControl>
