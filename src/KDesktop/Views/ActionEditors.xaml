    </DataTemplate>

    <!-- ── Dictar ──────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:DictateAction}">
        <StackPanel>
            <StackPanel Style="{StaticResource EdRow}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                <ComboBox ItemsSource="{x:Static v:Lookups.DictateModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.dictateHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Asistente: acción ───────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AssistantExtraAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAskWho}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.AssistantList}}" SelectedValuePath="Id"
                              SelectedValue="{Binding Assistant}" AutomationProperties.Name="{l:Tr editor.assistantAskWho}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:AssistantChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantExtra}" />
                    <ComboBox x:Name="ExtraBox" ItemsSource="{Binding Assistant, Converter={StaticResource AssistantActions}}" SelectedValuePath="Id"
                              SelectedValue="{Binding Extra}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="420"
                              AutomationProperties.Name="{l:Tr editor.assistantExtra}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:ExtraChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="Description" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="{Binding SelectedItem.Description, ElementName=ExtraBox}" />
            <TextBlock x:Name="Missing" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource Kd.Warning}"
                       Text="{Binding Summary}" />
            <CheckBox x:Name="BringOutCheck" Style="{StaticResource EdCheck}" Content="{l:Tr editor.assistantBringOut}" IsChecked="{Binding BringOut}"
                      ToolTip="{l:Tr editor.assistantBringOutHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding SelectedItem.HasDescription, ElementName=ExtraBox}" Value="True">
                <Setter TargetName="Description" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ExtraName}" Value="{x:Null}">
                <Setter TargetName="Missing" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Extra}" Value="">
                <Setter TargetName="Missing" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsShowOrHide}" Value="True">
                <Setter TargetName="BringOutCheck" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Asistente: preguntar ────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AssistantAskAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAskWho}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.AssistantList}}" SelectedValuePath="Id"
                              SelectedValue="{Binding Assistant}" AutomationProperties.Name="{l:Tr editor.assistantAskWho}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:AssistantChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAnswer}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.AssistantAnswers}" DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding Answer}" AutomationProperties.Name="{l:Tr editor.assistantAnswer}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAskText}" />
            <ui:TextBox Margin="0,0,0,8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.assistantAskTextHint}"
                        AutomationProperties.Name="{l:Tr editor.assistantAskText}" MaxLength="500" />
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.assistantBringOut}" IsChecked="{Binding BringOut}"
                      ToolTip="{l:Tr editor.assistantBringOutHint}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.assistantAskHint}" />
            <TextBlock x:Name="AnswerHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:Tr editor.assistantAnswerHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Answer}" Value="Say">
                <Setter TargetName="AnswerHint" Property="Text" Value="{l:Tr editor.assistantAnswerSayHint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Asistente: decir ────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AssistantSayAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAskWho}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{Binding Source={x:Static v:Lookups.AssistantList}}" SelectedValuePath="Id"
                      SelectedValue="{Binding Assistant}" AutomationProperties.Name="{l:Tr editor.assistantAskWho}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:AssistantChoice}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantSayText}" />
            <ui:TextBox Margin="0,0,0,8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.assistantSayTextHint}"
                        AutomationProperties.Name="{l:Tr editor.assistantSayText}" MaxLength="500" />
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.assistantSayCatchEye}" IsChecked="{Binding CatchEye}" />
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.assistantBringOut}" IsChecked="{Binding BringOut}"
                      ToolTip="{l:Tr editor.assistantBringOutHint}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.assistantSayHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Asistente: cerebro ──────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AssistantBrainAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
            <ComboBox Margin="0,0,0,8" ItemsSource="{x:Static v:Lookups.AssistantBrainOps}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Op}" AutomationProperties.Name="{l:Tr editor.mode}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.assistantBrainHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Asistente: chat ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AssistantChatAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.AssistantChatModes}" DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding Mode}" AutomationProperties.Name="{l:Tr editor.mode}" />
                </StackPanel>
                <StackPanel x:Name="WhoPanel" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantChatWho}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.AssistantChatList}}" SelectedValuePath="Id"
                              SelectedValue="{Binding Assistant}" AutomationProperties.Name="{l:Tr editor.assistantChatWho}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:AssistantChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.assistantChatHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="Close">
                <Setter TargetName="WhoPanel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Asistente: usar una herramienta ─────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AssistantToolAction}">
        <v:ToolActionFields />
    </DataTemplate>

    <!-- ── Si… ─────────────────────────────────────────────────────────── -->
    <!-- What «Si…» looks at: also each check of an event's «Solo si» (5.0.340) -->
    <DataTemplate x:Key="ConditionFields" DataType="{x:Type m:ConditionAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifCondition}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.ConditionKinds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Condition}"
                              MaxDropDownHeight="460" />
                </StackPanel>
                <CheckBox Grid.Column="1" Margin="16,0,0,4" VerticalAlignment="Bottom" Content="{l:Tr editor.ifNegate}" IsChecked="{Binding Negate}"
                          ToolTip="{l:Tr editor.ifNegateHint}" />
            </Grid>

            <!-- what it looks at -->
            <StackPanel x:Name="ProcessRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ProcessLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.process}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                              ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" v:ProcessCombo.Running="True" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Cursor24}" ToolTip="{l:Tr picker.tooltip}"
                               AutomationProperties.Name="{l:Tr picker.button}" Command="{x:Static v:EditorCommands.PickWindow}" CommandParameter="{Binding}" />
                </Grid>
            </StackPanel>
            <StackPanel x:Name="DeviceRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.audioDevice}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.ConnectedGadgetNames}}" MaxDropDownHeight="420" />
            </StackPanel>
            <StackPanel x:Name="AudioRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.audioDevice}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.AudioDeviceNames}}" />
            </StackPanel>
            <StackPanel x:Name="NetworkRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.networkName}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.ConnectedNetworksNow}}" />
            </StackPanel>
            <StackPanel x:Name="PathRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifPath}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="%USERPROFILE%\Desktop\…"
                                AutomationProperties.Name="{l:Tr editor.ifPath}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Document24}" ToolTip="{l:Tr editor.ifPickFile}"
                               AutomationProperties.Name="{l:Tr editor.ifPickFile}" Command="{x:Static v:EditorCommands.BrowseFile}" CommandParameter="{Binding}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.chooseFolder}"
                               AutomationProperties.Name="{l:Tr editor.chooseFolder}" Command="{x:Static v:EditorCommands.BrowseFolder}" CommandParameter="{Binding}" />
                </Grid>
            </StackPanel>
            <StackPanel x:Name="TextRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="TextLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifText}" />
                <ui:TextBox x:Name="TextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
            </StackPanel>
            <StackPanel x:Name="VariableRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifValue}" />
                <ui:TextBox Margin="0,0,0,8" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True"
                            AutomationProperties.Name="{l:Tr editor.ifValue}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{x:Static v:Lookups.VariableTests}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Test}"
                              AutomationProperties.Name="{l:Tr editor.ifTest}" />
                    <ui:TextBox x:Name="CompareBox" Grid.Column="2" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True"
                                PlaceholderText="{l:Tr editor.ifCompareHint}" AutomationProperties.Name="{l:Tr editor.ifCompareHint}" />
                </Grid>
            </StackPanel>
            <StackPanel x:Name="ScheduleRow" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.from}" />
                        <v:TimeField Time="{Binding TimeFrom, Mode=TwoWay}" Optional="True" AutomationProperties.Name="{l:Tr event.from}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.to}" />
                        <v:TimeField Time="{Binding TimeTo, Mode=TwoWay}" Optional="True" AutomationProperties.Name="{l:Tr event.to}" />
                    </StackPanel>
                </StackPanel>
                <v:WeekDaysPicker Days="{Binding Days}" />
            </StackPanel>
            <StackPanel x:Name="PowerRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifPower}" />
                <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{x:Static v:Lookups.PowerSources}" DisplayMemberPath="Name"
                          SelectedValuePath="Value" SelectedValue="{Binding PowerSource}" />
            </StackPanel>
            <StackPanel x:Name="LoadRow" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.loadResource}" />
                    <ComboBox Width="260" ItemsSource="{x:Static v:Lookups.LoadResources}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Resource}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifAbove}" />
                    <ui:TextBox Width="100" Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" />
                </StackPanel>
            </StackPanel>
            <!-- «Nivel de batería» (below this %) and «Pantallas» (at least this many) share Percent -->
            <StackPanel x:Name="NumberRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="NumberLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifBatteryBelow}" />
                <ui:TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" />
            </StackPanel>
            <TextBlock x:Name="DaylightHint" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed" Text="{l:Tr editor.ifDaylightHint}" />

        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Condition}" Value="Variable">
                <Setter TargetName="VariableRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Test}" Value="NotEmpty">
                <Setter TargetName="CompareBox" Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="ProcessRunning">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Foreground">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="ProcessLabel" Property="Text" Value="{l:Tr editor.ifForeground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="AudioPlaying">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="ProcessLabel" Property="Text" Value="{l:Tr editor.ifAudioPlaying}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Schedule">
                <Setter TargetName="ScheduleRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Device">
                <Setter TargetName="DeviceRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="AudioOutput">
                <Setter TargetName="AudioRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Network">
                <Setter TargetName="NetworkRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="PowerSource">
                <Setter TargetName="PowerRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="HostReachable">
                <Setter TargetName="TextRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="TextLabel" Property="Text" Value="{l:Tr editor.ifHost}" />
                <Setter TargetName="TextBox" Property="PlaceholderText" Value="192.168.1.150" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="FileExists">
                <Setter TargetName="PathRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Clipboard">
                <Setter TargetName="TextRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="TextLabel" Property="Text" Value="{l:Tr editor.ifClipboard}" />
                <Setter TargetName="TextBox" Property="PlaceholderText" Value="{l:Tr editor.ifClipboardHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Load">
                <Setter TargetName="LoadRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="BatteryLevel">
                <Setter TargetName="NumberRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Screens">
                <Setter TargetName="NumberRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="NumberLabel" Property="Text" Value="{l:Tr editor.ifScreens}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Daylight">
                <Setter TargetName="DaylightHint" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type m:ConditionAction}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConditionFields}" Focusable="False" />
            <!-- otherwise -->
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifElse}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.ConditionElses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Else}" />
                </StackPanel>
                <StackPanel x:Name="SkipRow" Grid.Column="2" Visibility="Hidden">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifSkipCount}" />
                    <ui:TextBox Text="{Binding SkipCount, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="99" />
                </StackPanel>
            </Grid>
            <!-- «Ejecutar otro comando en su lugar» -->
            <ui:Button x:Name="ElseCommandBox" Margin="0,-4,0,12" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="11,8"
                       AutomationProperties.Name="{l:Tr editor.ifElseCommand}" ToolTip="{l:Tr editor.ifElseCommand}"
                       Command="{x:Static v:EditorCommands.PickCommand}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding ElseCommandId, Converter={StaticResource PickedItem}, ConverterParameter=commandIcon}" Style="{StaticResource PickedIcon}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding ElseCommandId, Converter={StaticResource PickedItem}, ConverterParameter=command}" />
                    <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="ChevronDown24" FontSize="12" />
                </Grid>
            </ui:Button>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.ifHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Else}" Value="Skip">
                <Setter TargetName="SkipRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Else}" Value="RunCommand">
                <Setter TargetName="ElseCommandBox" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
