            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                <ComboBox ItemsSource="{x:Static v:Lookups.CommandControlModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            </StackPanel>
