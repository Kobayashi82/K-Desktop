<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core"
                    xmlns:v="clr-namespace:KDesktop.Views"
                    xmlns:l="clr-namespace:KDesktop.Localization">

    <!-- Editors for every action type. Each one is picked automatically by its DataType. -->

    <v:InverseBoolConverter x:Key="InverseBool" />
    <v:AudioDeviceStatusConverter x:Key="AudioStatus" />
    <v:AudioDeviceSymbolConverter x:Key="AudioSymbol" />
    <v:ActionIconConverter x:Key="ActionIconEd" />
    <v:LocKeyConverter x:Key="LocKey" />
    <v:SettingsTextConverter x:Key="SettingsText" />
    <v:PickedItemConverter x:Key="PickedItem" />
    <v:AssistantActionsConverter x:Key="AssistantActions" />
    <!-- The icon of a pick box, gone while nothing is picked -->
    <Style x:Key="PickedIcon" TargetType="Image">
        <Style.Triggers>
            <Trigger Property="Source" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EdRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="EdCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,0,24,6" />
    </Style>

    <!-- ── Ejecutar aplicación ─────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:RunAppAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.path}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.pathHint}" />
                <ui:Button VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}" AutomationProperties.Name="{l:Tr editor.browse}"
                           Command="{x:Static v:EditorCommands.BrowseFile}" CommandParameter="{Binding}" />
            </Grid>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.arguments}" />
                    <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.workingDir}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.workingDirHint}" />
                        <ui:Button VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}"
                                   Command="{x:Static v:EditorCommands.BrowseWorkingDirectory}" CommandParameter="{Binding}" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.window}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.WindowModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding WindowMode}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.priority}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.Priorities}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Priority}" />
                </StackPanel>
            </Grid>
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.runAsAdmin}" IsChecked="{Binding RunAsAdmin}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.topMost}" IsChecked="{Binding TopMost}" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── Abrir carpeta ───────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:OpenFolderAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.location}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.FolderTargets}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Special}" MaxDropDownHeight="420" />
            <Grid x:Name="PathRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.folderHint}" />
                <ui:Button VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}" AutomationProperties.Name="{l:Tr editor.browse}"
                           Command="{x:Static v:EditorCommands.BrowseFolder}" CommandParameter="{Binding}" />
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Special, TargetNullValue=''}" Value="">
                <Setter TargetName="PathRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Página web ──────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:OpenUrlAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="URL" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="https://…" Icon="{ui:SymbolIcon Globe24}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.browser}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.BrowserOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Browser}" />
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.newWindow}" IsChecked="{Binding NewWindow}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.incognito}" IsChecked="{Binding Incognito}" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── Controlar aplicación ────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AppControlAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.AppControlModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.process}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                                  ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" v:ProcessCombo.Running="True" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Cursor24}" ToolTip="{l:Tr picker.tooltip}"
                                   AutomationProperties.Name="{l:Tr picker.button}" Command="{x:Static v:EditorCommands.PickWindow}" CommandParameter="{Binding}" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid x:Name="TopMostRow" Style="{StaticResource EdRow}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.topMost}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.TopMostChanges}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding TopMost}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="WaitRow" Style="{StaticResource EdRow}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.waitUntil}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.WaitConditions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding WaitFor}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.timeout}" />
                    <ui:TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="3600" />
                </StackPanel>
            </Grid>
            <CheckBox x:Name="ForceCheck" Style="{StaticResource EdCheck}" Content="{l:Tr editor.waitForeground}" IsChecked="{Binding Force}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="Close">
                <Setter TargetName="ForceCheck" Property="Content" Value="{l:Tr editor.forceClose}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="TopMost">
                <Setter TargetName="ForceCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TopMostRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="WaitFor">
                <Setter TargetName="ForceCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="WaitRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Script ──────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:RunScriptAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.shell}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.ScriptShells}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Shell}" />
                </StackPanel>
                <StackPanel x:Name="WindowColumn" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.window}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.WindowModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding WindowMode}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Script" />
            <TextBox Margin="0,0,0,12" Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" AcceptsReturn="True" AcceptsTab="True"
                     MinHeight="120" MaxHeight="360" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13" />
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.runAsAdmin}" IsChecked="{Binding RunAsAdmin}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.waitForExit}" IsChecked="{Binding WaitForExit}" />
            </WrapPanel>
            <TextBlock x:Name="ResultHint" Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap" Text="{l:Tr editor.scriptResult}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <!-- wscript has no window of its own: the script shows its own messages (and gives nothing back) -->
            <DataTrigger Binding="{Binding Shell}" Value="VBScript">
                <Setter TargetName="WindowColumn" Property="Visibility" Value="Hidden" />
                <Setter TargetName="ResultHint" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Petición web ────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:HttpRequestAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.httpMethod}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.HttpVerbs}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Method}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="URL" />
                    <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="http://homeassistant.local:8123/api/services/light/turn_off" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.httpHeaders}" VerticalAlignment="Bottom" />
                <ui:Button HorizontalAlignment="Right" Content="{l:Tr editor.httpAddHeader}" Icon="{ui:SymbolIcon Add24}"
                           Command="{x:Static v:EditorCommands.AddHttpHeader}" CommandParameter="{Binding}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Headers}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:HttpHeader}">
                        <StackPanel Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Authorization" />
                                <ui:TextBox x:Name="PlainBox" Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.httpHeaderValue}" />
                                <ui:PasswordBox x:Name="SecretBox" Grid.Column="2" Visibility="Collapsed" Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{l:Tr editor.httpHeaderValue}" />
                                <CheckBox Grid.Column="3" Margin="10,0,0,0" MinWidth="0" Content="{l:Tr editor.httpSecret}" IsChecked="{Binding Secret}"
                                          ToolTip="{l:Tr editor.httpSecretHint}" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="4" Margin="4,0,0,0" Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}" VerticalAlignment="Center"
                                           Command="{x:Static v:EditorCommands.RemoveHttpHeader}" CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                </ui:Button>
                            </Grid>
                            <TextBlock x:Name="UnreadableHint" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{l:Tr editor.httpUnreadable}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Secret}" Value="True">
                                <Setter TargetName="PlainBox" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SecretBox" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Unreadable}" Value="True">
                                <Setter TargetName="UnreadableHint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="BodyPanel">
                <Grid Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{l:Tr editor.httpBody}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{x:Static v:Lookups.ContentTypes}"
                              Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="application/json" />
                </Grid>
                <TextBox Margin="0,0,0,6" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" AcceptsReturn="True" AcceptsTab="True"
                         MinHeight="80" MaxHeight="300" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{l:Tr editor.httpVariables}" />

            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.timeout}" />
                    <ui:TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="300" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.httpShowResult}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.HttpResultDisplays}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding ShowResult}" />
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.httpInsecure}" IsChecked="{Binding IgnoreCertificateErrors}" />
            <TextBlock x:Name="InsecureHint" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{l:Tr editor.httpInsecureHint}" />

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <ui:Button MinHeight="34" Content="{l:Tr editor.httpTest}" Icon="{ui:SymbolIcon Play24}" IsEnabled="{Binding Testing, Converter={StaticResource InverseBool}}"
                           Command="{x:Static v:EditorCommands.TestHttpRequest}" CommandParameter="{Binding}" />
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding Testing, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBox x:Name="ResultBox" Margin="0,8,0,0" IsReadOnly="True" Text="{Binding TestResult, Mode=OneWay}" TextWrapping="Wrap"
                     MaxHeight="220" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Method}" Value="Get">
                <Setter TargetName="BodyPanel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IgnoreCertificateErrors}" Value="True">
                <Setter TargetName="InsecureHint" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TestResult}" Value="{x:Null}">
                <Setter TargetName="ResultBox" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Enviar pulsación / texto ────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:SendInputAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.SendInputModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            <!-- Keys: the button shows the combination and captures a new one (as the hotkeys of the options) -->
            <ui:Button x:Name="KeysButton" MinHeight="36" MinWidth="240" HorizontalAlignment="Left" Icon="{ui:SymbolIcon Keyboard24}"
                       Content="{Binding Value}" AutomationProperties.Name="{l:Tr editor.captureKeys}"
                       Command="{x:Static v:EditorCommands.CaptureKeys}" CommandParameter="{Binding}" />
            <TextBox x:Name="TextBox" Visibility="Collapsed" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" FontSize="14"
                     AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" />
            <Grid x:Name="MouseRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="180" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="X" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <v:NumberField Grid.Column="1" Minimum="-32768" Maximum="32767" Value="{Binding MouseX}" AutomationProperties.Name="X" />
                <TextBlock Grid.Column="3" Text="Y" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <v:NumberField Grid.Column="4" Minimum="-32768" Maximum="32767" Value="{Binding MouseY}" AutomationProperties.Name="Y" />
                <ui:Button x:Name="CaptureMouseButton" Grid.Column="5" Margin="16,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr editor.captureMouse}"
                           Icon="{ui:SymbolIcon Cursor24}" Command="{x:Static v:EditorCommands.CaptureMouse}" CommandParameter="{Binding}" />
            </Grid>
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr editor.keysHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Value}" Value="">
                <Setter TargetName="KeysButton" Property="Content" Value="{l:Tr editor.keysNone}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="Text">
                <Setter TargetName="KeysButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.textHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="MouseMoveTo">
                <Setter TargetName="KeysButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MouseRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.mouseHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="MouseMoveBy">
                <Setter TargetName="KeysButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MouseRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="CaptureMouseButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.mouseByHint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Volumen ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:VolumeAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.volumeTarget}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.VolumeTargets}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Target}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.VolumeModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
            </Grid>
            <!-- Speakers and microphone: the default device or a chosen one -->
            <StackPanel x:Name="DeviceRow" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.volumeDevice}" />
                <ComboBox v:VolumeDeviceCombo.IsEnabled="True" MaxDropDownHeight="420" AutomationProperties.Name="{l:Tr editor.volumeDevice}" />
            </StackPanel>
            <StackPanel x:Name="ProcessRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.process}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                              ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" v:ProcessCombo.Running="True" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Cursor24}" ToolTip="{l:Tr picker.tooltip}"
                               AutomationProperties.Name="{l:Tr picker.button}" Command="{x:Static v:EditorCommands.PickWindow}" CommandParameter="{Binding}" />
                </Grid>
            </StackPanel>
            <Grid x:Name="LevelRow" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="0" Maximum="100" Value="{Binding Value}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0} %}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
            </Grid>
            <StackPanel x:Name="StepRow" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="StepLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.volumeStep}" />
                <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" Width="120" HorizontalAlignment="Left" />
            </StackPanel>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock x:Name="TargetHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="Up">
                <Setter TargetName="LevelRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="StepRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="Down">
                <Setter TargetName="LevelRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="StepRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="ToggleMute">
                <Setter TargetName="LevelRow" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="Mute">
                <Setter TargetName="LevelRow" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="Unmute">
                <Setter TargetName="LevelRow" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Target}" Value="App">
                <Setter TargetName="DeviceRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="StepLabel" Property="Text" Value="{l:Tr editor.levelStep}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Target}" Value="Microphone">
                <Setter TargetName="StepLabel" Property="Text" Value="{l:Tr editor.levelStep}" />
                <Setter TargetName="TargetHint" Property="Visibility" Value="Visible" />
                <Setter TargetName="TargetHint" Property="Text" Value="{l:Tr editor.micHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Target}" Value="ForegroundApp">
                <Setter TargetName="DeviceRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="StepLabel" Property="Text" Value="{l:Tr editor.levelStep}" />
                <Setter TargetName="TargetHint" Property="Visibility" Value="Visible" />
                <Setter TargetName="TargetHint" Property="Text" Value="{l:Tr editor.foregroundAppHint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Salida de audio ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AudioOutputAction}">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.audioDevices}" VerticalAlignment="Bottom" />
                <ui:Button HorizontalAlignment="Right" Content="{l:Tr editor.addDevice}" Icon="{ui:SymbolIcon Add24}"
                           Command="{x:Static v:EditorCommands.AddAudioDevice}" CommandParameter="{Binding}" />
            </Grid>
            <Border CornerRadius="6" Padding="4" Margin="0,0,0,6" Background="{DynamicResource Kd.Subtle}">
                <Grid>
                    <StackPanel x:Name="AllHint" Orientation="Horizontal" Margin="10,8" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" Margin="0,0,10,0" />
                        <TextBlock Text="{l:Tr editor.audioAll}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Devices}" Background="Transparent" BorderThickness="0" v:DragReorder.IsEnabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="B" CornerRadius="5" Padding="6,4" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:AudioDeviceRef}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="Transparent" Cursor="SizeNS" ToolTip="{l:Tr macro.dragHint}">
                                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Converter={StaticResource AudioSymbol}}" FontSize="18"
                                                   Foreground="{DynamicResource Kd.AccentText}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Converter={StaticResource AudioStatus}}" Margin="10,0" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}"
                                               Command="{x:Static v:EditorCommands.RemoveAudioDevice}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" Text="{l:Tr editor.audioHint}" />
            <StackPanel x:Name="SoundRow">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.audioSound}" />
                <v:SoundPicker Margin="0,0,0,12" Sound="{Binding Sound}" />
            </StackPanel>
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.audioCommunications}" IsChecked="{Binding Communications}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            </WrapPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                <Setter TargetName="AllHint" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- «Entrada de audio»: microphones, nothing to listen to -->
            <DataTrigger Binding="{Binding IsInput}" Value="True">
                <Setter TargetName="SoundRow" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── K-Board ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:KBoardAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.KBoardActionModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.kboardProfile}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.KBoardList}}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ProfileId}" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr editor.editKBoard}" Icon="{ui:SymbolIcon Edit24}"
                                   Command="{x:Static v:EditorCommands.EditKBoard}" CommandParameter="{Binding ProfileId}" />
                    </Grid>
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Sonido ──────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:PlaySoundAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.sound}" />
            <v:SoundPicker Margin="0,0,0,12" Sound="{Binding Sound}" />
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.waitSound}" IsChecked="{Binding Wait}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Toggles sin parámetros ──────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:TopMostAction}">
        <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type m:HiddenFilesAction}">
        <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type m:ToggleDisabledInAction}">
        <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
    </DataTemplate>

    <!-- ── Mensaje ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:ShowMessageAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.message}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel Width="140">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.seconds}" />
                    <ui:TextBox Text="{Binding Seconds, UpdateSourceTrigger=LostFocus}" v:NumberInput.IsEnabled="True" v:NumberInput.Decimals="True" v:NumberInput.Maximum="3600" />
                </StackPanel>
            </StackPanel>
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.countdown}" IsChecked="{Binding Countdown}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.waitMessage}" IsChecked="{Binding Wait}" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── Archivos y carpetas ─────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:FilesAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowOperation}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.FileOperations}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Operation}" />

            <!-- What it works on: written by hand (patterns too) or added with the buttons -->
            <StackPanel x:Name="SourcesPanel">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesSources}" />
                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="10,4,4,4" CornerRadius="6" Background="{DynamicResource Kd.Subtle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}" AutomationProperties.Name="{l:Tr common.remove}"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Command="{x:Static v:EditorCommands.RemoveFileSource}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Style="{StaticResource EdRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SourceBox" PlaceholderText="{l:Tr editor.filesSourceHint}" AutomationProperties.Name="{l:Tr editor.filesSources}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}"
                               Tag="{Binding ElementName=SourceBox}" Command="{x:Static v:EditorCommands.AddFileSource}" CommandParameter="{Binding}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Document24}"
                               ToolTip="{l:Tr editor.filesAddFiles}" AutomationProperties.Name="{l:Tr editor.filesAddFiles}"
                               Command="{x:Static v:EditorCommands.AddFileSourceFiles}" CommandParameter="{Binding}" />
                    <ui:Button Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Folder24}"
                               ToolTip="{l:Tr editor.filesAddFolder}" AutomationProperties.Name="{l:Tr editor.filesAddFolder}"
                               Command="{x:Static v:EditorCommands.AddFileSourceFolder}" CommandParameter="{Binding}" />
                </Grid>
                <CheckBox Style="{StaticResource EdCheck}" Margin="0,0,24,12" Content="{l:Tr editor.filesSubfolders}" IsChecked="{Binding Subfolders}" />
            </StackPanel>

            <StackPanel x:Name="DestinationPanel">
                <TextBlock x:Name="DestinationLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesDestination}" />
                <TextBlock x:Name="CreateLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesCreate}" Visibility="Collapsed" />
                <Grid Style="{StaticResource EdRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.filesDestinationHint}"
                                AutomationProperties.Name="{l:Tr editor.filesDestination}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}" AutomationProperties.Name="{l:Tr editor.browse}"
                               Command="{x:Static v:EditorCommands.BrowseFolder}" CommandParameter="{Binding}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="RenamePanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesNewName}" />
                <ui:TextBox Margin="0,0,0,12" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.filesNewNameHint}"
                            AutomationProperties.Name="{l:Tr editor.filesNewName}" />
            </StackPanel>

            <StackPanel x:Name="ExistsPanel">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesExists}" />
                <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.FileExistsChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Exists}" />
            </StackPanel>

            <CheckBox x:Name="RecycleCheck" Style="{StaticResource EdCheck}" Margin="0,0,24,12" Visibility="Collapsed" Content="{l:Tr editor.filesRecycle}" IsChecked="{Binding Recycle}" />

            <StackPanel x:Name="BackupPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesBackupMode}" />
                <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.BackupModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding BackupMode}" />
                <CheckBox x:Name="MirrorCheck" Style="{StaticResource EdCheck}" Margin="0,0,24,12" Content="{l:Tr editor.filesMirrorDelete}" IsChecked="{Binding MirrorDelete}" />
                <Grid x:Name="DatedPanel" Style="{StaticResource EdRow}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.filesKeep}" />
                        <v:NumberField Value="{Binding Keep}" Maximum="999" AutomationProperties.Name="{l:Tr editor.filesKeep}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6" Content="{l:Tr editor.filesZip}" IsChecked="{Binding BackupZip}" />
                </Grid>
            </StackPanel>

            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.filesWait}" IsChecked="{Binding Wait}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.filesShowOsd}" IsChecked="{Binding ShowOsd}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="{Binding Operation, Converter={StaticResource LocKey}, ConverterParameter=editor.filesHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Operation}" Value="CreateFolder">
                <Setter TargetName="SourcesPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ExistsPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DestinationLabel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CreateLabel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Delete">
                <Setter TargetName="DestinationPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ExistsPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RecycleCheck" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Rename">
                <Setter TargetName="DestinationPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ExistsPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RenamePanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Backup">
                <Setter TargetName="ExistsPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="BackupPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BackupMode}" Value="Dated">
                <Setter TargetName="MirrorCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DatedPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Mostrar notificación ────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:ShowNotificationAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifyTitle}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.notifyTitleHint}"
                        AutomationProperties.Name="{l:Tr editor.notifyTitle}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifyText}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.notifyTextHint}"
                        TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" AutomationProperties.Name="{l:Tr editor.notifyText}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifyIcon}" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,8,0" Background="{DynamicResource Kd.AccentSoft}">
                            <Image Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ActionIconEd}">
                                        <Binding />
                                        <Binding Path="Icon" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>
                        <ui:Button x:Name="IconChange" Content="{l:Tr commands.changeIcon}" Icon="{ui:SymbolIcon Image24}"
                                   Command="{x:Static v:EditorCommands.PickNotificationIcon}" CommandParameter="{Binding}" />
                        <ui:Button Margin="8,0,0,0" Height="{Binding ActualHeight, ElementName=IconChange}" Icon="{ui:SymbolIcon ArrowReset24}"
                                   ToolTip="{l:Tr editor.notifyIconReset}" AutomationProperties.Name="{l:Tr editor.notifyIconReset}"
                                   Command="{x:Static v:EditorCommands.ResetNotificationIcon}" CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifyColor}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.NotifyColors}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Color}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.sound}" />
            <v:SoundPicker Margin="0,0,0,12" Sound="{Binding Sound}" GlobalText="{l:Tr editor.notifySoundGlobal}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifySeconds}" />
                    <ui:TextBox Text="{Binding Seconds, UpdateSourceTrigger=LostFocus}" v:NumberInput.IsEnabled="True" v:NumberInput.Decimals="True" v:NumberInput.Maximum="3600" AutomationProperties.Name="{l:Tr editor.notifySeconds}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifyPlace}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.NotifyPlaces}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Place}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.notifyClick}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.NotifyClicks}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding OnClick}" />
            <Grid x:Name="OpenPanel" Style="{StaticResource EdRow}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" PlaceholderText="{l:Tr editor.notifyTargetHint}"
                            AutomationProperties.Name="{l:Tr editor.notifyTarget}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}" AutomationProperties.Name="{l:Tr editor.browse}"
                           Command="{x:Static v:EditorCommands.BrowseFile}" CommandParameter="{Binding}" />
            </Grid>
            <ui:Button x:Name="CommandBox" Margin="0,0,0,12" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="11,8" AutomationProperties.Name="{l:Tr editor.command}"
                       Command="{x:Static v:EditorCommands.PickCommand}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding CommandId, Converter={StaticResource PickedItem}, ConverterParameter=commandIcon}" Style="{StaticResource PickedIcon}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding CommandId, Converter={StaticResource PickedItem}, ConverterParameter=command}" />
                    <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="ChevronDown24" FontSize="12" />
                </Grid>
            </ui:Button>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.notifyWait}" IsChecked="{Binding Wait}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.notifyHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding OnClick}" Value="Open">
                <Setter TargetName="OpenPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OnClick}" Value="RunCommand">
                <Setter TargetName="CommandBox" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Energía ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:PowerAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.PowerModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.delay}" />
                    <ui:TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="3600" />
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showCountdown}" IsChecked="{Binding ShowOsd}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.powerHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── QuickMenu ───────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:OpenQuickMenuAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="QuickMenu" />
            <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.QuickMenuList}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MenuId}" />
        </StackPanel>
    </DataTemplate>


    <!-- ── Comandos ────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:CommandControlAction}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.controlTarget}" />
                <ComboBox ItemsSource="{x:Static v:Lookups.CommandControlTargets}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Target}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                <ComboBox ItemsSource="{x:Static v:Lookups.CommandControlModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            </StackPanel>
            <StackPanel x:Name="CommandPanel" Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.command}" />
                <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="11,8" AutomationProperties.Name="{l:Tr editor.command}"
                           Command="{x:Static v:EditorCommands.PickCommand}" CommandParameter="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding CommandId, Converter={StaticResource PickedItem}, ConverterParameter=commandIcon}" Style="{StaticResource PickedIcon}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding CommandId, Converter={StaticResource PickedItem}, ConverterParameter=command}" />
                        <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="ChevronDown24" FontSize="12" />
                    </Grid>
                </ui:Button>
            </StackPanel>
            <StackPanel x:Name="EventPanel" Grid.Column="4" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.event}" />
                <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="11,8" AutomationProperties.Name="{l:Tr editor.event}"
                           Command="{x:Static v:EditorCommands.PickCommand}" CommandParameter="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding EventId, Converter={StaticResource PickedItem}, ConverterParameter=eventIcon}" Style="{StaticResource PickedIcon}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding EventId, Converter={StaticResource PickedItem}, ConverterParameter=event}" />
                        <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="ChevronDown24" FontSize="12" />
                    </Grid>
                </ui:Button>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Target}" Value="Event">
                <Setter TargetName="CommandPanel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="EventPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Reproducir macro ────────────────────────────────────────────── -->
    <!-- ── Disposición de ventanas (E1): one of the page «Disposiciones», as «Reproducir macro» takes a macro ── -->
    <DataTemplate DataType="{x:Type m:ArrangementAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.arrangement}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.ArrangementList}}" SelectedValuePath="Id" SelectedValue="{Binding ArrangementId}"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="420" AutomationProperties.Name="{l:Tr editor.arrangement}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:WindowArrangement}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr editor.editKBoard}" Icon="{ui:SymbolIcon Edit24}"
                           Command="{x:Static v:EditorCommands.EditArrangement}" CommandParameter="{Binding ArrangementId}" />
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.arrangementHint}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type m:PlayMacroAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.macro}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.MacroList}}" SelectedValuePath="Id" SelectedValue="{Binding MacroId}"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="420">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Macro}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr editor.editKBoard}" Icon="{ui:SymbolIcon Edit24}"
                           Command="{x:Static v:EditorCommands.EditMacro}" CommandParameter="{Binding MacroId}" />
            </Grid>
            <!-- One row: the labels go on top of their boxes in a row of their own, so a long one (the pause) can take two
                 lines at the window's smallest without moving the boxes out of line -->
            <Grid Style="{StaticResource EdRow}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.65*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{l:Tr editor.speed}" />
                <ComboBox Grid.Row="1" ItemsSource="{x:Static v:Lookups.MacroSpeeds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Speed}" />
                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{l:Tr editor.repeat}"
                           IsEnabled="{Binding UntilStopped, Converter={StaticResource InverseBool}}" />
                <ui:TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True"
                            IsEnabled="{Binding UntilStopped, Converter={StaticResource InverseBool}}" />
                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{l:Tr editor.repeatDelay}" />
                <ui:TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RepeatDelay, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" />
            </Grid>
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.untilStopped}" IsChecked="{Binding UntilStopped}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr editor.macroHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Esperar ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:WaitAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.seconds}" />
                    <ui:TextBox Text="{Binding Seconds, UpdateSourceTrigger=LostFocus}" v:NumberInput.IsEnabled="True" v:NumberInput.Decimals="True" v:NumberInput.Maximum="86400" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.messageOptional}" />
                    <ui:TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.countdown}" IsChecked="{Binding Countdown}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Ventana ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:WindowAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowTarget}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.WindowTargets}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Target}" />
                </StackPanel>
                <StackPanel x:Name="ProcessRow" Grid.Column="2" Visibility="Hidden">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.process}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                                  ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" v:ProcessCombo.Running="True" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Cursor24}" ToolTip="{l:Tr picker.tooltip}"
                                   AutomationProperties.Name="{l:Tr picker.button}" Command="{x:Static v:EditorCommands.PickWindow}" CommandParameter="{Binding}" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowOperation}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.WindowOperations}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Operation}" />
                </StackPanel>
                <StackPanel x:Name="SnapRow" Grid.Column="2" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowSnap}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.WindowSnaps}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Snap}" MaxDropDownHeight="420" />
                </StackPanel>
                <StackPanel x:Name="MonitorRow" Grid.Column="2" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowMonitor}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Static v:Lookups.MonitorChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Monitor}" />
                        <v:NumberField x:Name="MonitorNumber" Grid.Column="1" Width="110" Margin="8,0,0,0" Visibility="Collapsed" Minimum="1" Maximum="16"
                                       Value="{Binding MonitorNumber}" AutomationProperties.Name="{l:Tr editor.windowMonitor}" />
                    </Grid>
                </StackPanel>
                <Grid x:Name="OpacityRow" Grid.Column="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowOpacity}" />
                    <Slider Grid.Row="1" Minimum="10" Maximum="95" Value="{Binding Opacity}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0} %}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
            </Grid>
            <Grid x:Name="CustomRow" Style="{StaticResource EdRow}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowX}" />
                    <ui:TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowY}" />
                    <ui:TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowWidth}" />
                    <ui:TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.windowHeight}" />
                    <ui:TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" v:NumberInput.IsEnabled="True" v:NumberInput.Maximum="100" />
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.windowHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Target}" Value="Process">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Snap">
                <Setter TargetName="SnapRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="MoveToMonitor">
                <Setter TargetName="MonitorRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Opacity">
                <Setter TargetName="OpacityRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Monitor}" Value="Number">
                <Setter TargetName="MonitorNumber" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Operation}" Value="Snap" />
                    <Condition Binding="{Binding Snap}" Value="Custom" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CustomRow" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Portapapeles ────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:ClipboardAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.ClipboardModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            <StackPanel x:Name="TextRow" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.clipboardText}" />
                <TextBox Margin="0,0,0,6" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="70" MaxHeight="260" VerticalScrollBarVisibility="Auto" FontSize="14" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{l:Tr editor.clipboardVariables}" />
            </StackPanel>
            <WrapPanel>
                <CheckBox x:Name="CopyFirstCheck" Style="{StaticResource EdCheck}" Content="{l:Tr editor.clipboardCopyFirst}" IsChecked="{Binding CopyFirst}" />
                <CheckBox x:Name="PasteCheck" Style="{StaticResource EdCheck}" Content="{l:Tr editor.clipboardPaste}" IsChecked="{Binding Paste}" />
            </WrapPanel>
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.clipboardHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="SetText">
                <Setter TargetName="TextRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="CopyFirstCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="Clear">
                <Setter TargetName="CopyFirstCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PasteCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="CleanUrl">
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.clipboardCleanHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="ShowHistory">
                <Setter TargetName="CopyFirstCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PasteCheck" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.clipboardHistoryHint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Despertar equipo ────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:CalendarAddAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.title}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.calendarTitleHint}" v:VariableHints.IsEnabled="True" />
            <WrapPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.calendarWhen}" />
                    <ComboBox Width="170" ItemsSource="{x:Static v:Lookups.CalendarWhens}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding When}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding When}" Value="In"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.calendarInMinutes}" />
                    <v:NumberField Width="150" Minimum="0" Maximum="525600" Value="{Binding InMinutes}" AutomationProperties.Name="{l:Tr editor.calendarInMinutes}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding When}" Value="At"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.calendarDay}" />
                        <v:DateField Date="{Binding DateValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.calendarTime}" />
                        <v:TimeField Time="{Binding Time}" />
                    </StackPanel>
                    <CheckBox VerticalAlignment="Bottom" Margin="0,0,0,6" Content="{l:Tr agenda.field.allDay}" IsChecked="{Binding AllDay}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.calendarDuration}" />
                    <v:NumberField Width="150" Minimum="0" Maximum="10080" Value="{Binding DurationMinutes}" AutomationProperties.Name="{l:Tr editor.calendarDuration}" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,16,12" MinWidth="220">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.calendar}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.WritableCalendars}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Calendar}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,12" MinWidth="200">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.reminder}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.ReminderChoices}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Reminder}" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.location}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.notes}" />
            <ui:TextBox Margin="0,0,0,8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.calendarAddHint}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type m:MailSendAction}">
        <StackPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,16,12" MinWidth="260">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mailAccount}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.MailAccountsSend}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Account}" />
                </StackPanel>
                <CheckBox VerticalAlignment="Bottom" Margin="0,0,0,18" Content="{l:Tr editor.mailDraftOnly}" IsChecked="{Binding DraftOnly}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mailTo}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ana@ejemplo.es, …" v:VariableHints.IsEnabled="True" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mailSubject}" />
            <ui:TextBox Margin="0,0,0,12" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mailBody}" />
            <ui:TextBox Margin="0,0,0,12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" v:VariableHints.IsEnabled="True" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mailAttachments}" />
            <ui:TextBox Margin="0,0,0,8" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="50" Text="{Binding Attachments, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{l:Tr editor.mailAttachmentsHint}" v:VariableHints.IsEnabled="True" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.mailSendHint}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type m:CalendarJoinAction}">
        <StackPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.calendarJoinWhich}" />
                    <ComboBox Width="260" ItemsSource="{x:Static v:Lookups.CalendarJoinWhichs}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Which}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,12" MinWidth="220">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.calendar}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.CalendarChoices}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Calendar}" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.calendarJoinHint}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type m:WakeOnLanAction}">
        <StackPanel>
            <!-- Boxes as wide as what goes in them: an address up to 255.255.255.255, a MAC; they wrap on a narrow window -->
            <WrapPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.wolHost}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Width="200" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.168.1.150" Icon="{ui:SymbolIcon Server24}" />
                        <ui:Button Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="{l:Tr editor.wolFindMac}"
                                   ToolTip="{l:Tr editor.wolFindMacHint}" Command="{x:Static v:EditorCommands.FindMac}" CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.wolMac}" />
                    <ui:TextBox Width="205" Text="{Binding Mac, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="AA:BB:CC:DD:EE:FF" FontFamily="Cascadia Mono, Consolas"
                                MaxLength="17" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.wolAddress}" />
                    <ui:TextBox Width="200" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.wolAddressHint}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.port}" />
                    <v:NumberField Width="150" Minimum="1" Maximum="65535" Value="{Binding Port}" AutomationProperties.Name="{l:Tr editor.port}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.wolWait}" />
                    <v:NumberField Width="150" Minimum="0" Maximum="600" Value="{Binding WaitSeconds}" AutomationProperties.Name="{l:Tr editor.wolWait}" />
                </StackPanel>
            </WrapPanel>
