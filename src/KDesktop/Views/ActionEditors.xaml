            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel IsEnabled="{Binding UntilStopped, Converter={StaticResource InverseBool}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.repeat}" />
