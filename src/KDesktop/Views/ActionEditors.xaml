    <!-- ── Pantalla ────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:DisplayAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.DisplayOperations}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Operation}" />
            <StackPanel x:Name="ProjectionRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.projection}" />
                <ComboBox ItemsSource="{x:Static v:Lookups.Projections}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Projection}" />
            </StackPanel>
            <Grid x:Name="BrightnessRow" Style="{StaticResource EdRow}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.brightness}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.LevelChanges}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding BrightnessMode}" />
                </StackPanel>
                <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Brightness}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <TextBlock Grid.Column="3" Text="{Binding Brightness, StringFormat={}{0} %}" VerticalAlignment="Bottom" Margin="0,0,0,10" HorizontalAlignment="Right" FontWeight="SemiBold" />
            </Grid>
            <v:DisplayModeFields x:Name="ModeRow" Visibility="Collapsed" />
            <!-- «Apagar pantallas»: which ones (none ticked = all) -->
            <StackPanel x:Name="OffRow" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.monitorsOff}" />
                <v:MonitorChecks />
            </StackPanel>
            <CheckBox x:Name="OsdCheck" Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.monitorOffHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Operation}" Value="MonitorOff">
                <Setter TargetName="OsdCheck" Property="Visibility" Value="Collapsed" />
                <!-- The monitor boxes say it: all turned off, or the chosen ones covered -->
                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Projection">
                <Setter TargetName="OffRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ProjectionRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.projectionHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Brightness">
                <Setter TargetName="OffRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="BrightnessRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.brightnessHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Operation}" Value="Mode">
                <Setter TargetName="OffRow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ModeRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.displayModeHint}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

