                </StackPanel>
                <StackPanel x:Name="PlanRow" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.powerPlan}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static v:Lookups.PowerPlanList}}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding PlanId}" />
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.powerPlanHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="Cycle">
                <Setter TargetName="PlanRow" Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Tema de Windows ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:WindowsThemeAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
            <ComboBox Margin="0,0,0,12" Width="260" HorizontalAlignment="Left" ItemsSource="{x:Static v:Lookups.ThemeChoices}" DisplayMemberPath="Name"
                      SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.themeApps}" IsChecked="{Binding Apps}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.themeSystem}" IsChecked="{Binding System}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── Wi-Fi y Bluetooth ───────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:RadioAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.radio}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.RadioDevices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Radio}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.SwitchModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.radioHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Captura de pantalla ─────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:ScreenshotAction}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.captureArea}" />
            <ComboBox Margin="0,0,0,12" ItemsSource="{x:Static v:Lookups.CaptureAreas}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Area}" />
            <WrapPanel>
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.captureCopy}" IsChecked="{Binding Copy}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.captureSave}" IsChecked="{Binding Save}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.captureOpen}" IsChecked="{Binding Open}" />
                <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,4" Text="{l:Tr editor.folder}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.captureFolderHint}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr editor.browse}" Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{x:Static v:EditorCommands.BrowseFolder}" CommandParameter="{Binding}" />
            </Grid>
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.captureHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Grabar audio ────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:AudioRecordAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.RecordModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
                <StackPanel x:Name="SourceRow" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.recordSource}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.AudioSources}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Source}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.folder}" />
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr editor.recordFolderHint}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr editor.browse}" Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{x:Static v:EditorCommands.BrowseFolder}" CommandParameter="{Binding}" />
            </Grid>
            <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr editor.showOsd}" IsChecked="{Binding ShowOsd}" />
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.recordHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="SaveReplay">
                <Setter TargetName="SourceRow" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Hint" Property="Text" Value="{l:Tr editor.replayHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="Stop">
                <Setter TargetName="SourceRow" Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Lupa ────────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:MagnifierAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.mode}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.SwitchModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.zoom}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.ActionZoomLevels}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Zoom}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.zoomHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- ── Si… ─────────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type m:ConditionAction}">
        <StackPanel>
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifCondition}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.ConditionKinds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Condition}"
                              MaxDropDownHeight="460" />
                </StackPanel>
                <CheckBox Grid.Column="1" Margin="16,0,0,4" VerticalAlignment="Bottom" Content="{l:Tr editor.ifNegate}" IsChecked="{Binding Negate}"
                          ToolTip="{l:Tr editor.ifNegateHint}" />
            </Grid>

            <!-- what it looks at -->
            <StackPanel x:Name="ProcessRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ProcessLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.process}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" />
            </StackPanel>
            <StackPanel x:Name="DeviceRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.audioDevice}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.ConnectedGadgetNames}}" MaxDropDownHeight="420" />
            </StackPanel>
            <StackPanel x:Name="AudioRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.audioDevice}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.AudioDeviceNames}}" />
            </StackPanel>
            <StackPanel x:Name="NetworkRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.networkName}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                          ItemsSource="{Binding Source={x:Static v:Lookups.ConnectedNetworksNow}}" />
            </StackPanel>
            <StackPanel x:Name="TextRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="TextLabel" Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifText}" />
                <ui:TextBox x:Name="TextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel x:Name="ScheduleRow" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Width="110" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.from}" />
                        <ui:TextBox Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="hh:mm" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.to}" />
                        <ui:TextBox Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="hh:mm" />
                    </StackPanel>
                </StackPanel>
                <v:WeekDaysPicker Days="{Binding Days}" />
            </StackPanel>
            <StackPanel x:Name="PowerRow" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifPower}" />
                <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{x:Static v:Lookups.PowerSources}" DisplayMemberPath="Name"
                          SelectedValuePath="Value" SelectedValue="{Binding PowerSource}" />
            </StackPanel>
            <StackPanel x:Name="LoadRow" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.loadResource}" />
                    <ComboBox Width="190" ItemsSource="{x:Static v:Lookups.LoadResources}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Resource}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifAbove}" />
                    <ui:TextBox Width="100" Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <!-- otherwise -->
            <Grid Style="{StaticResource EdRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifElse}" />
                    <ComboBox ItemsSource="{x:Static v:Lookups.ConditionElses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Else}" />
                </StackPanel>
                <StackPanel x:Name="SkipRow" Grid.Column="2" Visibility="Hidden">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.ifSkipCount}" />
                    <ui:TextBox Text="{Binding SkipCount, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr editor.ifHint}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Else}" Value="Skip">
                <Setter TargetName="SkipRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="ProcessRunning">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Foreground">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="ProcessLabel" Property="Text" Value="{l:Tr editor.ifForeground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="AudioPlaying">
                <Setter TargetName="ProcessRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="ProcessLabel" Property="Text" Value="{l:Tr editor.ifAudioPlaying}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Schedule">
                <Setter TargetName="ScheduleRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Device">
                <Setter TargetName="DeviceRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="AudioOutput">
                <Setter TargetName="AudioRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Network">
                <Setter TargetName="NetworkRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="PowerSource">
                <Setter TargetName="PowerRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="HostReachable">
                <Setter TargetName="TextRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="TextLabel" Property="Text" Value="{l:Tr editor.ifHost}" />
                <Setter TargetName="TextBox" Property="PlaceholderText" Value="192.168.1.150" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="FileExists">
                <Setter TargetName="TextRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="TextLabel" Property="Text" Value="{l:Tr editor.ifPath}" />
                <Setter TargetName="TextBox" Property="PlaceholderText" Value="%USERPROFILE%\Desktop\…" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Clipboard">
                <Setter TargetName="TextRow" Property="Visibility" Value="Visible" />
                <Setter TargetName="TextLabel" Property="Text" Value="{l:Tr editor.ifClipboard}" />
                <Setter TargetName="TextBox" Property="PlaceholderText" Value="{l:Tr editor.ifClipboardHint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Condition}" Value="Load">
                <Setter TargetName="LoadRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
