<UserControl x:Class="KDesktop.Views.Assistant.AssistantChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Panel → Assistant → the conversation (stage 3.6): what was said to it by any way, its answers as they are
         written, and a box to write to it -->
    <!-- Folds like the panels around it (5.0.315); «Borrar» stays on the header -->
    <ui:CardExpander x:Name="Expander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Chat24}" HorizontalContentAlignment="Stretch" IsExpanded="True"
                     Expanded="OnFolded" Collapsed="OnFolded" AutomationProperties.Name="{l:Tr assistantChat.title}">
        <ui:CardExpander.Header>
            <Grid>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr assistantChat.title}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="ClearButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,8,0" MinHeight="36"
                           Icon="{ui:SymbolIcon Delete24}" Content="{l:Tr assistantChat.clear}" Click="OnClear" />
            </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
            <!-- Only when it can't be written to now (not on the desktop) -->
            <TextBlock x:Name="HintText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ScrollViewer x:Name="Scroller" MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <!-- Room on the right for the scroll bar, which WPF-UI draws over the content -->
                <StackPanel x:Name="Rows" Margin="0,0,14,0" />
            </ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="Input" MaxLength="500" ClearButtonEnabled="False" PreviewKeyDown="OnKey" TextChanged="OnTextChanged" />
                <ui:Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" IsEnabled="False" Padding="12,8"
                           ToolTip="{l:Tr assistantWrite.send}" AutomationProperties.Name="{l:Tr assistantWrite.send}" Click="OnSend">
                    <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                </ui:Button>
                <ui:Button x:Name="StopButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,8" Visibility="Collapsed"
                           ToolTip="{l:Tr assistantChat.stop}" AutomationProperties.Name="{l:Tr assistantChat.stop}" Click="OnStop">
                    <ui:SymbolIcon Symbol="RecordStop24" FontSize="16" />
                </ui:Button>
            </Grid>
        </StackPanel>
    </ui:CardExpander>
</UserControl>
