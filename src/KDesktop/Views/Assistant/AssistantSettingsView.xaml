<UserControl x:Class="KDesktop.Views.Assistant.AssistantSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <!-- Options → Assistants → one assistant → its settings, drawn from its settings.json (§11.8) -->
    <UserControl.Resources>
        <a:SymbolIconConverter x:Key="SymbolIcon" />
        <a:TextToVisibilityConverter x:Key="NonEmptyToVis" />

        <!-- Pills (the page tabs and the choices shown as buttons): «Pill» of Themes/Styles.xaml -->
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- A page as a tab -->
        <DataTemplate x:Key="PageTab">
            <RadioButton Style="{StaticResource Pill}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>

        <!-- Label and description of a row -->
        <DataTemplate x:Key="RowText" DataType="{x:Type a:SettingModel}">
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ToggleSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsOn}"
                                 AutomationProperties.Name="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:SliderSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                                TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                        <TextBlock Grid.Column="1" MinWidth="48" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                                   FontWeight="Normal" Text="{Binding ValueText}"
                                   Visibility="{Binding ShowValue, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <DockPanel Margin="0,2,0,0" Visibility="{Binding HasEndLabels, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding MaxLabel}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding MinLabel}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:NumberSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:NumberBox Width="160" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="{Binding Step}"
                                  LargeChange="{Binding Step}" MaxDecimalPlaces="{Binding Decimals}" ClearButtonEnabled="False"
                                  Value="{Binding BoxValue, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Margin="10,0,0,0" MinWidth="48" VerticalAlignment="Center" FontWeight="Normal"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ValueText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ChoiceSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ItemsControl x:Name="Buttons" Margin="0,6,0,0" MaxWidth="460" Visibility="Collapsed" Focusable="False"
                                  ItemsSource="{Binding Options}" ItemsPanel="{StaticResource Wrap}" AutomationProperties.Name="{Binding Label}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Pill}" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ComboBox x:Name="List" Width="240" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                              DisplayMemberPath="Label" AutomationProperties.Name="{Binding Label}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding AsButtons}" Value="True">
                    <Setter TargetName="Buttons" Property="Visibility" Value="Visible" />
                    <Setter TargetName="List" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:TextSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <TextBox Grid.Column="1" VerticalAlignment="Center" MaxLength="{Binding MaxLength}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{Binding Placeholder}"
                         AutomationProperties.Name="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ColorSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="Swatch" Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand" Focusable="True"
                                  ToolTip="{l:Tr assistantSettings.colors}" AutomationProperties.Name="{l:Tr assistantSettings.colors}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Edge" CornerRadius="8" BorderThickness="1" Padding="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource Kd.Subtle}">
                                    <Border CornerRadius="5" Background="{Binding Brush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBox Width="100" VerticalAlignment="Center" MaxLength="7" FontFamily="Consolas"
                             Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
                    <Popup IsOpen="{Binding IsChecked, ElementName=Swatch}" PlacementTarget="{Binding ElementName=Swatch}"
                           Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Padding="10" CornerRadius="8" BorderThickness="1" Width="236"
                                Background="{DynamicResource Kd.MenuTintOpaque}" BorderBrush="{DynamicResource Kd.MenuBorder}">
                            <ItemsControl ItemsSource="{x:Static a:ColorSetting.Presets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="24" Height="24" Margin="2" Cursor="Hand" Tag="{Binding}" Click="OnPickColor"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Dot" CornerRadius="5" Background="{Binding}" BorderThickness="1"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:GallerySetting}">
            <StackPanel Margin="0,6">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Tiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,10,10" Click="OnGalleryTile" FocusVisualStyle="{x:Null}" ToolTip="{Binding LockText}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Tile" Width="116" Padding="8" CornerRadius="10" BorderThickness="2" Cursor="Hand"
                                                Background="{DynamicResource Kd.Subtle}" BorderBrush="Transparent">
                                            <StackPanel>
                                                <Grid Height="80">
                                                    <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <ui:SymbolIcon Symbol="Image24" FontSize="32" Foreground="{DynamicResource Kd.TextDim}"
                                                                   Visibility="{Binding NoImage, Converter={StaticResource BoolToVis}}" />
                                                    <Border x:Name="Lock" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Right"
                                                            VerticalAlignment="Top" Background="{DynamicResource Kd.ChipBackground}" Visibility="Collapsed">
                                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Margin="0,6,0,0" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                                <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
                                                <Setter TargetName="Tile" Property="Cursor" Value="No" />
                                                <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:AppsSetting}">
            <StackPanel Margin="0,6">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                    <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0" Click="OnRemoveApp"
                                               ToolTip="{l:Tr common.remove}" AutomationProperties.Name="{l:Tr common.remove}"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox IsEditable="True" Width="240" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                              DropDownOpened="OnAppsDropDown" DropDownClosed="OnAppPicked" KeyDown="OnAppKeyDown"
                              AutomationProperties.Name="{Binding Label}" />
                    <ui:Button Appearance="Primary" MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddApp" />
                    <ui:Button MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" AutomationProperties.Name="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickApp"
                               ToolTip="{l:Tr picker.tooltip}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:HotkeySetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                    <TextBlock x:Name="Status" Margin="0,0,20,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Status}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button MinWidth="160" MinHeight="36" Icon="{ui:SymbolIcon Keyboard24}" Content="{Binding ButtonText}" IsEnabled="{Binding CanRecord}"
                               AutomationProperties.Name="{Binding Label}" Click="OnCaptureHotkey" />
                    <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="Clear" Margin="8,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                               AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearHotkey" />
                    <ui:Button MinHeight="36" x:Name="Open" Margin="8,0,0,0" Icon="{ui:SymbolIcon Open24}" ToolTip="{l:Tr assistantSettings.openCommand}"
                               AutomationProperties.Name="{l:Tr assistantSettings.openCommand}" Click="OnOpenHotkeyCommand" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasHotkey}" Value="False">
                    <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCommand}" Value="False">
                    <Setter TargetName="Open" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Kd.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- With a description, a row (text on the left, the button on the right); without one, the button alone -->
        <DataTemplate DataType="{x:Type a:ButtonSetting}">
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Text" Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
                <ui:Button MinHeight="36" x:Name="Run" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" Content="{Binding Label}"
                           Icon="{Binding Symbol, Converter={StaticResource SymbolIcon}}" Click="OnButton" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasDescription}" Value="False">
                    <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Run" Property="Grid.Column" Value="0" />
                    <Setter TargetName="Run" Property="HorizontalAlignment" Value="Left" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:InfoSetting}">
            <Border Style="{StaticResource InfoBox}" Margin="0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,2" Text="{Binding Label}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding Label, Converter={StaticResource NonEmptyToVis}}" />
                        <TextBlock FontSize="13" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:KeysSetting}">
            <StackPanel Margin="0,6">
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding Label, Converter={StaticResource NonEmptyToVis}}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,4,4" Padding="7,2" CornerRadius="4" MinWidth="26"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,1,1,2">
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" Margin="8,2,0,0" FontSize="13" Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- As wide as the page (FitWidth): the same width on every tab, so switching them does not make the cards jump -->
    <StackPanel>
        <!-- Back to the list -->
        <ui:Button Margin="0,0,0,10" Appearance="Transparent" Padding="8,4" Icon="{ui:SymbolIcon ArrowLeft24}"
                   Content="{l:Tr assistantSettings.back}" Click="OnBack" />

        <!-- Who, and whether the changes show at once -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Kd.ChipBackground}" VerticalAlignment="Center">
                    <Grid>
                        <ui:SymbolIcon x:Name="HeroFallback" Symbol="Bot24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                        <Image x:Name="HeroIcon" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource CardTitle}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                    <!-- A grid, not a horizontal panel: the text wraps instead of going under the buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="0,5,7,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="LiveText" Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button MinHeight="36" x:Name="ResetButton" Margin="0,0,8,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon ArrowReset24}" IsEnabled="{Binding HasChanges}"
                               Content="{l:Tr assistantSettings.reset}" Click="OnReset" />
                    <ui:Button MinHeight="36" x:Name="PutButton" VerticalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Click="OnPut" />
                    <ui:Button MinHeight="36" x:Name="HideButton" VerticalAlignment="Center" Icon="{ui:SymbolIcon EyeOff24}" Click="OnHide" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nothing to set -->
        <Border x:Name="NonePanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <TextBlock x:Name="NoneText" Style="{StaticResource Caption}" FontSize="13" />
        </Border>

        <!-- Pages as tabs: K-Desktop's (the same for all of them), and below those of its settings.json (5.0.289) -->
        <ItemsControl x:Name="PageTabs" Margin="0,2,0,4" ItemsSource="{Binding MainPages}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                      ItemTemplate="{StaticResource PageTab}" AutomationProperties.Name="{l:Tr assistantSettings.pages}" />
        <ItemsControl x:Name="OwnTabs" Margin="0,0,0,8" ItemsSource="{Binding OwnPages}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                      ItemTemplate="{StaticResource PageTab}" AutomationProperties.Name="{l:Tr assistantSettings.ownPages}" />

        <!-- How it is called and what it thinks with (5.0.113) -->
        <a:AssistantGeneralView x:Name="GeneralView" Visibility="Collapsed" />

        <!-- What it has of its own: its language and personality, or its voice (5.0.105; apart since 5.0.289) -->
        <a:AssistantPersonalView x:Name="PersonalView" Visibility="Collapsed" />

        <!-- What it can show, now on the desktop (stage 13.9) -->
        <a:AssistantTryView x:Name="TryView" Visibility="Collapsed" HorizontalAlignment="Left" />

        <ItemsControl x:Name="SectionsList" ItemsSource="{Binding CurrentPage.Sections}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}"
                                       Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
