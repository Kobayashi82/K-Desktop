<UserControl x:Class="KDesktop.Views.Assistant.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Panel → Assistant → Activity (stage 3.3): what the assistants did, how, and «undo» where it can be undone -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2" Text="{l:Tr assistantActivity.title}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr assistantActivity.hint}" />
                </StackPanel>
                <ui:Button x:Name="ClearButton" Grid.Column="1" VerticalAlignment="Center" Icon="{ui:SymbolIcon Delete24}"
                           Content="{l:Tr assistantActivity.clear}" Click="OnClear" />
            </Grid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" Margin="0,6,0,4" Text="{l:Tr assistantActivity.empty}" />
            <StackPanel x:Name="Rows" />
            <ui:Button x:Name="MoreButton" Margin="0,8,0,0" HorizontalAlignment="Center" Appearance="Transparent"
                       Content="{l:Tr assistantActivity.more}" Click="OnMore" />
        </StackPanel>
    </Border>
</UserControl>
