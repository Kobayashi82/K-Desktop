<ui:FluentWindow x:Class="KDesktop.Views.Assistant.AssistantChatWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 xmlns:a="clr-namespace:KDesktop.Views.Assistant"
                 Title="K-Desktop"
                 Width="440" Height="620" MinWidth="340" MinHeight="380"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 PreviewKeyDown="OnKey">
    <!-- «Asistente: chat» (D3): the conversation of Panel → Asistente in a window of its own. The assistant's icon changes who
         it talks to; the pin keeps it on top. Esc closes it; where it was, the pin and the assistant are remembered. -->
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" Margin="-16,0,-16,4" />
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Who it talks to: a click lists the others -->
            <ui:Button x:Name="WhoButton" Appearance="Transparent" Padding="4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                       Click="OnWho" ToolTip="{l:Tr assistantChatWindow.change}" AutomationProperties.Name="{l:Tr assistantChatWindow.change}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}" VerticalAlignment="Center">
                        <Image x:Name="WhoIcon" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="WhoName" Margin="10,0,6,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:SymbolIcon Symbol="ChevronDown20" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="PinButton" Style="{StaticResource SquareButton}" Margin="0,0,8,0" Click="OnPin"
                           ToolTip="{l:Tr assistantChatWindow.pin}" AutomationProperties.Name="{l:Tr assistantChatWindow.pin}">
                    <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="18" />
                </ui:Button>
                <ui:Button Style="{StaticResource SquareButton}" Click="OnClear"
                           ToolTip="{l:Tr assistantChat.clear}" AutomationProperties.Name="{l:Tr assistantChat.clear}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource Kd.Danger}" />
                </ui:Button>
            </StackPanel>
        </Grid>
        <a:AssistantChatView x:Name="Chat" Grid.Row="2" />
    </Grid>
</ui:FluentWindow>
