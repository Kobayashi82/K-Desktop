<UserControl x:Class="KDesktop.Views.Assistant.AssistantPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <!-- Panel → Assistant: the cards of the active assistant's panel.json, with what it publishes -->
    <UserControl.Resources>
        <a:SymbolIconConverter x:Key="SymbolIcon" />

        <!-- Thin bar of a progress (Fraction 0…1) -->
        <DataTemplate x:Key="Bar">
            <Grid Height="6">
                <Border CornerRadius="3" Background="{DynamicResource Kd.BarTrack}" />
                <Border CornerRadius="3" Background="{DynamicResource Kd.Bar}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fraction}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:StatsRow}">
            <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="212" Margin="0,0,12,12" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                               Text="{Binding Value}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top" Margin="8,0,0,0"
                                        Background="{DynamicResource Kd.AccentSoft}" Visibility="{Binding HasSymbol, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ProgressCard}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" FontSize="13" Text="{Binding Text}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Bar}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ListCard}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" />
                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" Background="{DynamicResource Kd.Subtle}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{Binding EmptyText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:AchievementsCard}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontSize="13" Text="{Binding Summary}" Foreground="{DynamicResource Kd.AccentText}" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile" Width="276" Margin="0,0,10,10" Padding="12,10" CornerRadius="8" Background="{DynamicResource Kd.Subtle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40" VerticalAlignment="Top">
                                            <Ellipse x:Name="Disc" Fill="{DynamicResource Kd.Locked}" />
                                            <Ellipse x:Name="Gold" Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFD45A" Offset="0" />
                                                        <GradientStop Color="#E09A0B" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <ui:SymbolIcon Symbol="Trophy24" FontSize="20" Foreground="White"
                                                           Visibility="{Binding NoImage, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding Image}" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                            <ContentPresenter Margin="0,6,0,0" Content="{Binding}" ContentTemplate="{StaticResource Bar}"
                                                              Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                        <Setter TargetName="Gold" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                        <Setter TargetName="Tile" Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{x:Static a:AchievementsCard.EmptyText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:ButtonsCard}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Margin="0,0,8,8" Content="{Binding Label}" Icon="{Binding Symbol, Converter={StaticResource SymbolIcon}}"
                                           IsEnabled="{Binding Enabled}" Click="OnExtra" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type a:TextCard}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Label}" Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="Blocks" Focusable="False" />
</UserControl>
