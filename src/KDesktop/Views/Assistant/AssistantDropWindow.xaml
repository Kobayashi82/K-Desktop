<Window x:Class="KDesktop.Views.Assistant.AssistantDropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:KDesktop.Localization"
        Title="K-Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <!-- Files dropped on an assistant (stage 14.1): what to do with them. A button per likely thing (by the kind of file), a
         box to say it in words, and the microphone a few seconds. Escape or clicking elsewhere closes it. -->
    <Grid x:Name="Root" Margin="24" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="10" />
        </Grid.RenderTransform>
        <Border CornerRadius="14" Background="{DynamicResource Kd.OsdBackground}" BorderBrush="{DynamicResource Kd.ToastBorder}"
                BorderThickness="1" Width="460" Padding="14,12,12,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}" VerticalAlignment="Center">
                        <Grid>
                            <ui:SymbolIcon x:Name="Fallback" Symbol="Bot24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <Image x:Name="AssistantIcon" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Question" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>
                <WrapPanel x:Name="Actions" Margin="0,12,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="Input" Margin="0,0,8,0" VerticalAlignment="Center" MaxLength="500"
                                ClearButtonEnabled="False" PreviewKeyDown="OnKey" TextChanged="OnTextChanged" />
                    <ui:Button x:Name="SendButton" Grid.Column="1" Appearance="Primary" IsEnabled="False" Padding="10,7" VerticalAlignment="Center"
                               ToolTip="{l:Tr assistantWrite.send}" AutomationProperties.Name="{l:Tr assistantWrite.send}" Click="OnSend">
                        <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                    </ui:Button>
                </Grid>
                <StackPanel x:Name="ListeningRow" Orientation="Horizontal" Margin="2,8,0,0" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Mic24" FontSize="14" Foreground="{DynamicResource Kd.AccentText}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{l:Tr assistantDrop.listening}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
