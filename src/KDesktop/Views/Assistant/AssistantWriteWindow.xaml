<Window x:Class="KDesktop.Views.Assistant.AssistantWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:KDesktop.Localization"
        Title="K-Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <!-- Writing to an assistant (stage 3.6): its menu → «Escribir», a middle click on it or «Asistente: preguntar» without
         text. Enter sends the order (it goes as «heard», like the voice), Escape or clicking elsewhere closes it. -->
    <Grid x:Name="Root" Margin="24" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="10" />
        </Grid.RenderTransform>
        <Border CornerRadius="14" Background="{DynamicResource Kd.OsdBackground}" BorderBrush="{DynamicResource Kd.ToastBorder}"
                BorderThickness="1" Width="440" Padding="12,10,10,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}" VerticalAlignment="Center">
                    <Grid>
                        <ui:SymbolIcon x:Name="Fallback" Symbol="Bot24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                        <Image x:Name="AssistantIcon" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <ui:TextBox x:Name="Input" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" MaxLength="500"
                            ClearButtonEnabled="False" PreviewKeyDown="OnKey" TextChanged="OnTextChanged" />
                <ui:Button x:Name="SendButton" Grid.Column="2" Appearance="Primary" IsEnabled="False" Padding="10,7" VerticalAlignment="Center"
                           ToolTip="{l:Tr assistantWrite.send}" AutomationProperties.Name="{l:Tr assistantWrite.send}" Click="OnSend">
                    <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>
