<Window x:Class="KDesktop.Views.Assistant.ReadingSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:KDesktop.Localization"
        Title="K-Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <!-- A long answer (stage 14.2): the whole text an assistant wrote, next to it, while its voice says the summary. It grows
         while it is written; it can be copied, kept as a note or read aloud. It does not take the focus, and stays until it is
         closed (or the next long answer of that assistant replaces it). -->
    <Grid x:Name="Root" Margin="24" Opacity="0" KeyDown="OnKey">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="10" />
        </Grid.RenderTransform>
        <Border CornerRadius="14" Background="{DynamicResource Kd.OsdBackground}" BorderBrush="{DynamicResource Kd.ToastBorder}"
                BorderThickness="1" Width="580" Padding="16,12,10,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}" VerticalAlignment="Center">
                        <Grid>
                            <ui:SymbolIcon x:Name="Fallback" Symbol="Bot24" FontSize="17" Foreground="{DynamicResource Kd.AccentText}" />
                            <Image x:Name="AssistantIcon" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SheetTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Writing" Style="{StaticResource Caption}" Text="{l:Tr readingSheet.writing}" Visibility="Collapsed" />
                    </StackPanel>
                    <ui:Button x:Name="CloseButton" Grid.Column="2" Appearance="Transparent" Padding="7" VerticalAlignment="Top"
                               ToolTip="{l:Tr readingSheet.close}" AutomationProperties.Name="{l:Tr readingSheet.close}" Click="OnClose">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                    </ui:Button>
                </Grid>
                <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="1" Margin="0,0,0,0" Padding="0,0,6,0" IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" SelectionBrush="{DynamicResource Kd.Accent}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button x:Name="CopyButton" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Click="OnCopy"
                               Icon="{ui:SymbolIcon Copy24}" Content="{l:Tr readingSheet.copy}" />
                    <ui:Button x:Name="NoteButton" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Click="OnNote"
                               Icon="{ui:SymbolIcon NoteAdd24}" Content="{l:Tr readingSheet.saveNote}" />
                    <ui:Button x:Name="ReadButton" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Click="OnRead"
                               Icon="{ui:SymbolIcon Speaker224}" Content="{l:Tr readingSheet.readAloud}" />
                    <ui:Button x:Name="ChatButton" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Click="OnChat"
                               Icon="{ui:SymbolIcon Chat24}" Content="{l:Tr readingSheet.followChat}" />
                    <TextBlock x:Name="Done" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
