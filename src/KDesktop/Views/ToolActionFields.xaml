<UserControl x:Class="KDesktop.Views.ToolActionFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:v="clr-namespace:KDesktop.Views">
    <!-- «Asistente: usar una herramienta» (G1): the tool (as «Asistente: acción» picks its extra), its description and the
         fields of its schema (the form of «Probar» in Options → Tools), or its JSON -->
    <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.tool}" />
        <ComboBox x:Name="ToolBox" Margin="0,0,0,12" IsTextSearchEnabled="True" TextSearch.TextPath="Title" MaxDropDownHeight="420"
                  SelectionChanged="OnToolPicked" AutomationProperties.Name="{l:Tr editor.tool}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type v:ToolChoice}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Origin}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock x:Name="Description" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock x:Name="Missing" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource Kd.Warning}" />
        <TextBlock x:Name="Asks" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource Kd.Warning}" />
        <ContentControl x:Name="FieldsHost" Focusable="False" />
        <ui:TextBox x:Name="JsonBox" Margin="0,0,0,8" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="14"
                    ClearButtonEnabled="False" Visibility="Collapsed" v:VariableHints.IsEnabled="True" TextChanged="OnJsonChanged"
                    AutomationProperties.Name="{l:Tr toolsOptions.arguments}" />
        <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource Kd.Danger}" />
        <TextBlock x:Name="NoFields" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="{l:Tr editor.toolNoFields}" />
        <ui:Button x:Name="SwapButton" Appearance="Transparent" Margin="0,0,0,4" Click="OnSwap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
