<UserControl x:Class="KDesktop.Views.TimeField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             HorizontalAlignment="Left">
    <UserControl.Resources>
        <!-- Hours and minutes: two digits each, no box of their own (the frame around both is the box) -->
        <Style x:Key="Part" TargetType="TextBox">
            <Setter Property="Width" Value="26" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Kd.Accent}" />
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Frame" MinHeight="34" CornerRadius="4" BorderThickness="1" Padding="10,0,4,0"
            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Clock24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid>
                <TextBlock x:Name="HoursHint" Text="--" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="Hours" Style="{StaticResource Part}" AutomationProperties.Name="{l:Tr time.hours}" />
            </Grid>
            <TextBlock Text=":" FontSize="14" Margin="1,0,1,1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid>
                <TextBlock x:Name="MinutesHint" Text="--" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="Minutes" Style="{StaticResource Part}" AutomationProperties.Name="{l:Tr time.minutes}" />
            </Grid>
            <ui:Button x:Name="ClearButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Padding="5" Visibility="Collapsed"
                       ToolTip="{l:Tr common.remove}" AutomationProperties.Name="{l:Tr common.remove}" Click="OnClear">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
            </ui:Button>
            <Border Width="6" />
        </StackPanel>
    </Border>
</UserControl>
