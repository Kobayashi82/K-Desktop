<UserControl x:Class="KDesktop.Views.Pages.PanelsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── List ──────────────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.panels}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr panels.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <ui:Button Margin="0,0,0,10" Content="{l:Tr panels.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNew" HorizontalAlignment="Stretch" />
            </StackPanel>

            <ListBox x:Name="PanelList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource CardRowItem}"
                     SelectionChanged="OnSelected" PreviewMouseRightButtonUp="OnRightClick" KeyDown="OnListKey">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:InfoPanel}">
                        <Grid x:Name="Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="DesktopPulse24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <!-- As a command's row: its name, what it shows under it -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,1,0,0" Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" IsChecked="{Binding Enabled}"
                                             ToolTip="{l:Tr panels.shown}" AutomationProperties.Name="{l:Tr panels.shown}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="0,0,24,16">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" MaxWidth="520">
                <ui:SymbolIcon Symbol="DesktopPulse24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr panels.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr panels.emptyText}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ListEmpty" Margin="0,8,0,0" Text="{l:Tr panels.listEmpty}" Style="{StaticResource Caption}" TextAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="Editor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="EditorShift" />
                </ScrollViewer.RenderTransform>
                <StackPanel>
                    <!-- Header: the name, on the desktop, duplicate, delete (as in Disposiciones and Textos) -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="10" VerticalAlignment="Top" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="DesktopPulse24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <Grid Grid.Column="1" Margin="16,0,0,0" v:ResponsiveHeader.MinNameWidth="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBox x:Name="NameBox" ClearButtonEnabled="False" FontSize="16" FontWeight="SemiBold" PlaceholderText="{l:Tr panels.namePlaceholder}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr panels.namePlaceholder}"
                                            GotKeyboardFocus="OnNameFocus" LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" v:ResponsiveHeader.IsSide="True">
                                    <ui:ToggleSwitch IsChecked="{Binding Enabled}" Content="{l:Tr panels.shown}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Copy24, FontSize=18}" ToolTip="{l:Tr common.duplicate}"
                                               AutomationProperties.Name="{l:Tr common.duplicate}" Click="OnDuplicate" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource SquareButton}" ToolTip="{l:Tr panels.delete}"
                                               AutomationProperties.Name="{l:Tr panels.delete}" Click="OnDelete">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource Kd.Danger}" />
                                    </ui:Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <TextBlock x:Name="NameError" Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{l:Tr panels.nameRequired}"
                                               Foreground="{DynamicResource Kd.Danger}" Visibility="Collapsed" />
                                    <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                </StackPanel>
                                <!-- How it works, on hover (as in Disposiciones) -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                                        Cursor="Help" ToolTipService.ShowDuration="60000" ToolTipService.InitialShowDelay="200" AutomationProperties.Name="{l:Tr panels.infoMove}">
                                    <Border.ToolTip>
                                        <StackPanel MaxWidth="380">
                                            <TextBlock TextWrapping="Wrap" Text="{l:Tr panels.infoMove}" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:Tr panels.infoBottom}" />
                                        </StackPanel>
                                    </Border.ToolTip>
                                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource Kd.Accent}" Opacity="0.45" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- What it shows: a row per figure, dragged to change the order (as the devices of «Salida de audio») -->
                    <ui:CardExpander x:Name="ItemsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon DataHistogram24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr panels.items}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr panels.items}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="8,0,8,0">
                                    <ui:Button Appearance="Primary" MinHeight="36" Content="{l:Tr panels.addItem}" Icon="{ui:SymbolIcon Add24}" Click="OnAddItem" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock x:Name="NoItems" Style="{StaticResource Caption}" Margin="0,0,0,6" Text="{l:Tr panels.noItemsHint}" TextWrapping="Wrap" />
                            <Border x:Name="ItemsBox" CornerRadius="6" Padding="4" Margin="0,0,0,6" Background="{DynamicResource Kd.Subtle}">
                                <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" v:DragReorder.IsEnabled="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="B" CornerRadius="5" Padding="6,4" Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:InfoPanelItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="Transparent" Cursor="SizeNS" ToolTip="{l:Tr macro.dragHint}" v:DragReorder.IsHandle="True">
                                                    <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </Border>
                                                <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Kind, Converter={x:Static v:PanelItemSymbol.Instance}}" FontSize="18"
                                                               Foreground="{DynamicResource Kd.AccentText}" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kind, Converter={x:Static v:PanelItemName.Instance}}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <ui:TextBox Grid.Column="3" Width="110" Visibility="{Binding IsFigure, Converter={StaticResource BoolToVis}}" Margin="10,0,0,0" VerticalAlignment="Center" ClearButtonEnabled="False"
                                                            Text="{Binding Label, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                            PlaceholderText="{Binding Kind, Converter={x:Static v:PanelItemLabel.Instance}}"
                                                            ToolTip="{l:Tr panels.label}" AutomationProperties.Name="{l:Tr panels.label}" />
                                                <ComboBox Grid.Column="4" Width="150" Visibility="{Binding IsFigure, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{x:Static v:Lookups.PanelItemLooks}"
                                                          DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Look}" AutomationProperties.Name="{l:Tr panels.lookOf}" />
                                                <ui:Button Grid.Column="5" Margin="6,0,0,0" Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}"
                                                           AutomationProperties.Name="{l:Tr common.remove}" Click="OnRemoveItem" Tag="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                                </ui:Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr panels.itemsHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- How it looks: rows, size, colours and background (each change shows on the panel at once) -->
                    <ui:CardExpander x:Name="LookExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon PaintBrush24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr panels.look}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr panels.look}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{l:Tr panels.rows}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr panels.rowsHint}" />
                                </StackPanel>
                                <v:NumberField Grid.Column="1" Minimum="1" Maximum="12" Value="{Binding Rows}" AutomationProperties.Name="{l:Tr panels.rows}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr panels.fontSize}" />
                                <v:NumberField Grid.Column="1" Minimum="8" Maximum="48" Value="{Binding FontSize}" AutomationProperties.Name="{l:Tr panels.fontSize}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr panels.labelColor}" />
                                <v:ColorField Grid.Column="1" Color="{Binding LabelColor}" AutomaticResource="Kd.AccentText" Label="{l:Tr panels.labelColor}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr panels.valueColor}" />
                                <v:ColorField Grid.Column="1" Color="{Binding ValueColor}" AutomaticResource="TextFillColorPrimaryBrush" Label="{l:Tr panels.valueColor}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr panels.background}" />
                                <v:ColorField Grid.Column="1" Color="{Binding Background}" AutomaticResource="Kd.MenuTintOpaque" Label="{l:Tr panels.background}" />
                            </Grid>
                            <!-- As «Volumen» of the assistants: a slider and its % -->
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{l:Tr panels.backgroundOpacity}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr panels.backgroundOpacityHint}" />
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Slider Margin="0,0,14,0" Minimum="0" Maximum="100" Value="{Binding BackgroundOpacity}" TickFrequency="5" IsSnapToTickEnabled="True"
                                            SmallChange="5" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr panels.backgroundOpacity}" />
                                    <TextBlock Grid.Column="1" MinWidth="40" TextAlignment="Right" Text="{Binding BackgroundOpacity, StringFormat={}{0} %}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Options (folded unless opened by hand, as in Comandos) -->
                    <ui:CardExpander x:Name="OptionsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Options24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.options}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.options}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr panels.interval}" />
                                <ComboBox x:Name="IntervalBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Interval}"
                                          AutomationProperties.Name="{l:Tr panels.interval}" />
                            </Grid>
                            <ui:ToggleSwitch Margin="0,10,0,0" IsChecked="{Binding Locked}" Content="{l:Tr panels.locked}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr panels.lockedHint}" TextWrapping="Wrap" />
                            <ui:ToggleSwitch Margin="0,14,0,0" IsChecked="{Binding ClickThrough}" IsEnabled="{Binding Locked}" Content="{l:Tr panels.clickThrough}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr panels.clickThroughHint}" TextWrapping="Wrap" />
                            <ui:ToggleSwitch Margin="0,14,0,0" IsChecked="{Binding Topmost}" Content="{l:Tr panels.topmost}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr panels.topmostHint}" TextWrapping="Wrap" />
                            <ui:Button Margin="0,14,0,0" Content="{l:Tr panels.toCorner}" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnToCorner"
                                       ToolTip="{l:Tr panels.toCornerHint}" AutomationProperties.Name="{l:Tr panels.toCorner}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Notes (foldable, as in Comandos) -->
                    <ui:CardExpander x:Name="NotesExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Note24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.notes}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.notes}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 AutomationProperties.Name="{l:Tr commands.notes}" />
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
