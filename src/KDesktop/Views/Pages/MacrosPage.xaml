<UserControl x:Class="KDesktop.Views.Pages.MacrosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:p="clr-namespace:KDesktop.Views.Pages"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <p:StepIconConverter x:Key="StepIcon" />
        <p:PlusOneConverter x:Key="PlusOne" />

        <!-- Editor of the selected step -->
        <DataTemplate x:Key="StepEditorTemplate" DataType="{x:Type m:MacroStep}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr macro.stepTitle}" />
                <WrapPanel>
                    <StackPanel Width="210" Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.stepKind}" />
                        <ComboBox ItemsSource="{x:Static v:Lookups.MacroStepKinds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Kind}" />
                    </StackPanel>
                    <StackPanel Width="110" Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.delay}" />
                        <ui:TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Key -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding IsKey, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.key}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="150" Text="{Binding KeyName, UpdateSourceTrigger=LostFocus}" />
                            <ui:Button Margin="6,0,0,0" Content="{l:Tr editor.captureKeys}" Icon="{ui:SymbolIcon Keyboard24}"
                                       Command="{x:Static v:EditorCommands.CaptureStepKey}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Text -->
                    <StackPanel Width="360" Margin="0,0,16,8" Visibility="{Binding IsText, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.text}" />
                        <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Mouse button -->
                    <StackPanel Width="150" Margin="0,0,16,8" Visibility="{Binding IsMouseButton, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.button}" />
                        <ComboBox ItemsSource="{x:Static v:Lookups.MouseButtons}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Button}" />
                    </StackPanel>

                    <!-- Position -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding HasPosition, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.position}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="80" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="," Margin="4,0" VerticalAlignment="Center" />
                            <ui:TextBox Width="80" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Margin="6,0,0,0" Content="{l:Tr editor.captureMouse}" Icon="{ui:SymbolIcon Cursor24}"
                                       Command="{x:Static v:EditorCommands.CaptureStepPosition}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Relative movement -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding IsRelativeMove, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.offset}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="X" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBox Width="80" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr macro.offsetXHint}" />
                            <TextBlock Text="Y" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBox Width="80" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr macro.offsetYHint}" />
                            <CheckBox Margin="16,0,0,0" Content="{l:Tr macro.raw}" IsChecked="{Binding Raw}" ToolTip="{l:Tr macro.rawHint}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Wheel -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding IsWheel, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.wheel}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="90" Text="{Binding Wheel, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr macro.wheelHint}" />
                            <CheckBox Margin="12,0,0,0" Content="{l:Tr macro.horizontal}" IsChecked="{Binding Horizontal}" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StepRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="6" Padding="6,3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.Selected}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Macro list ────────────────────────────────────────────── -->
        <DockPanel Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.macros}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:Button Content="{l:Tr macro.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNewMacro" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
            </StackPanel>
            <TextBlock x:Name="ListEmpty" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{l:Tr macro.listEmpty}" Margin="4,8" />
            <ListBox x:Name="MacroList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}" SelectionChanged="OnMacroSelected" PreviewMouseRightButtonUp="OnMacroRightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Macro}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Kd.AccentSoft}" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Record24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="0,0,24,16">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.8" MaxWidth="460">
                <ui:SymbolIcon Symbol="Record24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr macro.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr macro.emptyText}" Style="{StaticResource Caption}" TextAlignment="Center" />
            </StackPanel>

            <DockPanel x:Name="Editor" Visibility="Collapsed">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="EditorShift" />
                </DockPanel.RenderTransform>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="Record24" FontSize="26" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <ui:TextBox x:Name="NameBox" FontSize="16" FontWeight="SemiBold" PlaceholderText="{l:Tr macro.namePlaceholder}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="RecordButton" Content="{l:Tr macro.record}" Appearance="Danger" Click="OnRecord" Margin="0,0,8,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Record24" Filled="True" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{l:Tr macro.test}" Icon="{ui:SymbolIcon Play24}" Click="OnTest" Margin="0,0,8,0" ToolTip="{l:Tr macro.testHint}" />
                                <ui:Button Icon="{ui:SymbolIcon FlashAdd20}" ToolTip="{l:Tr macro.createCommand}" Click="OnCreateCommand" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:Tr macro.duplicate}" Click="OnDuplicate" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr macro.delete}" Click="OnDelete" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="68,12,0,0">
                            <ui:ToggleSwitch x:Name="RecordMovesToggle" Content="{l:Tr macro.recordMoves}" Click="OnRecordMoves" Margin="0,0,24,0"
                                             ToolTip="{l:Tr macro.recordMovesHint}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{l:Tr macro.stopHint}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Selected step -->
                <Border x:Name="StepPanel" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                    <ContentControl x:Name="StepEditor" Focusable="False" />
                </Border>

                <!-- Steps -->
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr macro.steps}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="InsertButton" Content="{l:Tr macro.insert}" Icon="{ui:SymbolIcon Add24}" Click="OnInsert" Margin="0,0,6,0" />
                                <ui:Button x:Name="SimplifyButton" Content="{l:Tr macro.simplify}" Icon="{ui:SymbolIcon Wand24}" Click="OnSimplify" Margin="0,0,6,0" />
                                <ui:Button x:Name="UndoButton" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="{l:Tr macro.undo}" Click="OnUndo" IsEnabled="False" Margin="0,0,6,0" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr macro.deleteSteps}" Click="OnDeleteSteps" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="NoSteps" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{l:Tr macro.noSteps}" Margin="4,8" />
                        <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" ItemContainerStyle="{StaticResource StepRow}" SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 AlternationCount="2147483647" v:DragReorder.IsEnabled="True" SelectionChanged="OnStepSelected" KeyDown="OnStepKey">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:MacroStep}">
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="Transparent" Cursor="SizeNS" v:DragReorder.IsHandle="True" ToolTip="{l:Tr macro.dragHint}">
                                            <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource PlusOne}}" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="{Binding Kind, Converter={StaticResource StepIcon}}" FontSize="16"
                                                       Foreground="{DynamicResource Kd.AccentText}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Timer24" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBox Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" Width="72" Padding="6,2" MinHeight="0" FontSize="12"
                                                     TextAlignment="Right" ToolTip="{l:Tr macro.delayHint}" />
                                            <TextBlock Text="ms" Margin="6,0,4,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
