<UserControl x:Class="KDesktop.Views.Pages.MacrosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:p="clr-namespace:KDesktop.Views.Pages"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <p:StepIconConverter x:Key="StepIcon" />
        <v:SameItemToVisibleConverter x:Key="SameItem" />

        <!-- Editor of a step, open under its row (the wait before it is on the row itself) -->
        <DataTemplate x:Key="StepEditorTemplate" DataType="{x:Type m:MacroStep}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="230" Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.stepKind}" />
                        <ComboBox ItemsSource="{x:Static v:Lookups.MacroStepKinds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Kind}"
                                  MaxDropDownHeight="420" />
                    </StackPanel>

                    <!-- Key -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding IsKey, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.key}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="150" Text="{Binding KeyName, UpdateSourceTrigger=LostFocus}" ClearButtonEnabled="False" />
                            <ui:Button Margin="6,0,0,0" Content="{l:Tr editor.captureKeys}" Icon="{ui:SymbolIcon Keyboard24}"
                                       Command="{x:Static v:EditorCommands.CaptureStepKey}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Text -->
                    <StackPanel Width="360" Margin="0,0,16,8" Visibility="{Binding IsText, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.text}" />
                        <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Mouse button -->
                    <StackPanel Width="150" Margin="0,0,16,8" Visibility="{Binding IsMouseButton, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.button}" />
                        <ComboBox ItemsSource="{x:Static v:Lookups.MouseButtons}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Button}" />
                    </StackPanel>

                    <!-- Position -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding HasPosition, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.position}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="80" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                            <TextBlock Text="," Margin="4,0" VerticalAlignment="Center" />
                            <ui:TextBox Width="80" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                            <ui:Button Margin="6,0,0,0" Content="{l:Tr editor.captureMouse}" Icon="{ui:SymbolIcon Cursor24}"
                                       Command="{x:Static v:EditorCommands.CaptureStepPosition}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Relative movement -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding IsRelativeMove, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.offset}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="X" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBox Width="80" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr macro.offsetXHint}" ClearButtonEnabled="False" />
                            <TextBlock Text="Y" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBox Width="80" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr macro.offsetYHint}" ClearButtonEnabled="False" />
                            <CheckBox Margin="16,0,0,0" Content="{l:Tr macro.raw}" IsChecked="{Binding Raw}" ToolTip="{l:Tr macro.rawHint}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Wheel -->
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding IsWheel, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr macro.wheel}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="90" Text="{Binding Wheel, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr macro.wheelHint}" ClearButtonEnabled="False" />
                            <CheckBox Margin="12,0,0,0" Content="{l:Tr macro.horizontal}" IsChecked="{Binding Horizontal}" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StepRow" TargetType="ListBoxItem">
            <!-- Right margin: keeps the row's buttons clear of the list's scrollbar -->
            <Setter Property="Margin" Value="0,1,14,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="6" Padding="6,3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.Selected}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon buttons of a step row -->
        <Style x:Key="RowButton" TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="RowMoveButton" TargetType="ui:Button" BasedOn="{StaticResource MoveButton}">
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static p:MacrosPage.MoveStepUp}" Executed="OnMoveStepUp" CanExecute="OnCanMoveStepUp" />
        <CommandBinding Command="{x:Static p:MacrosPage.MoveStepDown}" Executed="OnMoveStepDown" CanExecute="OnCanMoveStepDown" />
        <CommandBinding Command="{x:Static p:MacrosPage.DuplicateStep}" Executed="OnDuplicateStep" />
        <CommandBinding Command="{x:Static p:MacrosPage.DeleteStep}" Executed="OnDeleteStep" />
    </UserControl.CommandBindings>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Macro list ────────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.macros}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr macro.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <ui:Button Margin="0,0,0,10" Content="{l:Tr macro.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNewMacro" HorizontalAlignment="Stretch" />
            </StackPanel>

            <ListBox x:Name="MacroList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}"
                     SelectionChanged="OnMacroSelected" PreviewMouseRightButtonUp="OnMacroRightClick" KeyDown="OnMacroListKey">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Macro}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="15" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="Record24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,1,0,0" Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="XboxController24" FontSize="14" Margin="6,0,10,0" VerticalAlignment="Center"
                                           ToolTip="{l:Tr macro.gameMode}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding GameMode, Converter={StaticResource BoolToCollapsed}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="0,0,24,16">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" MaxWidth="520">
                <ui:SymbolIcon Symbol="Record24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr macro.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr macro.emptyText}" Style="{StaticResource Caption}" TextAlignment="Center" />
                <TextBlock x:Name="ListEmpty" Margin="0,8,0,0" Text="{l:Tr macro.listEmpty}" Style="{StaticResource Caption}" TextAlignment="Center" />
            </StackPanel>

            <DockPanel x:Name="Editor" Visibility="Collapsed">
                <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="EditorShift" />
                </DockPanel.RenderTransform>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="30" VerticalAlignment="Top" Background="{DynamicResource Kd.AccentSoft}">
                            <ui:SymbolIcon Symbol="Record24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                        </Border>
                        <Grid Grid.Column="1" Margin="16,0,0,0" v:ResponsiveHeader.MinNameWidth="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:TextBox x:Name="NameBox" ClearButtonEnabled="False" FontSize="16" FontWeight="SemiBold" PlaceholderText="{l:Tr macro.namePlaceholder}"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        GotKeyboardFocus="OnNameFocus" LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" v:ResponsiveHeader.IsSide="True">
                                <ui:Button x:Name="RecordButton" Content="{l:Tr macro.record}" Appearance="Danger" Click="OnRecord" Margin="0,0,8,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Record24" Filled="True" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{l:Tr macro.test}" Icon="{ui:SymbolIcon Play24}" Click="OnTest" ToolTip="{l:Tr macro.testHint}" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon FlashAdd20}" ToolTip="{l:Tr macro.createCommand}" AutomationProperties.Name="{l:Tr macro.createCommand}"
                                           Click="OnCreateCommand" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:Tr macro.duplicate}" AutomationProperties.Name="{l:Tr macro.duplicate}"
                                           Click="OnDuplicate" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr macro.delete}" AutomationProperties.Name="{l:Tr macro.delete}" Click="OnDelete" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock x:Name="NameError" Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{l:Tr macro.nameRequired}"
                                           Foreground="{DynamicResource Kd.Danger}" Visibility="Collapsed" />
                                <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                            </StackPanel>
                            <!-- The options of the recording, with the reminder of how it ends on the same line -->
                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <ui:ToggleSwitch IsChecked="{Binding GameMode}" Content="{l:Tr macro.gameMode}" Margin="0,0,24,8" VerticalAlignment="Center"
                                                 ToolTip="{l:Tr macro.gameModeHint}" />
                                <ui:ToggleSwitch x:Name="RecordMovesToggle" Content="{l:Tr macro.recordMoves}" Click="OnRecordMoves" Margin="0,0,24,8"
                                                 VerticalAlignment="Center" ToolTip="{l:Tr macro.recordMovesHint}" />
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8" Text="{l:Tr macro.stopHint}" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Steps -->
                <Border Style="{StaticResource Card}" Padding="14,12,4,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="4,0,10,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr macro.steps}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="InsertButton" Content="{l:Tr macro.insert}" Icon="{ui:SymbolIcon Add24}" Click="OnInsert" Margin="0,0,6,0" />
                                <ui:Button x:Name="SimplifyButton" Content="{l:Tr macro.simplify}" Icon="{ui:SymbolIcon Wand24}" Click="OnSimplify" Margin="0,0,6,0" />
                                <ui:Button x:Name="UndoButton" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="{l:Tr macro.undo}" Click="OnUndo" IsEnabled="False" Margin="0,0,6,0" />
                                <ui:Button x:Name="RedoButton" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="{l:Tr macro.redo}" Click="OnRedo" IsEnabled="False" Margin="0,0,6,0" />
                                <ui:Button x:Name="DeleteStepsButton" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr macro.deleteSteps}" Click="OnDeleteSteps" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="NoSteps" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{l:Tr macro.noSteps}" Margin="4,8" />
                        <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" ItemContainerStyle="{StaticResource StepRow}" SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel"
                                 v:DragReorder.IsEnabled="True" SelectionChanged="OnStepSelected" KeyDown="OnStepKey">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:MacroStep}">
                                    <StackPanel>
                                    <Grid x:Name="Header" Height="30" Background="Transparent"
                                          PreviewMouseLeftButtonDown="OnStepHeaderDown" PreviewMouseLeftButtonUp="OnStepHeaderUp">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="Transparent" Cursor="SizeNS" v:DragReorder.IsHandle="True" ToolTip="{l:Tr macro.dragHint}">
                                            <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding Number}" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="{Binding Kind, Converter={StaticResource StepIcon}}" FontSize="16"
                                                       Foreground="{DynamicResource Kd.AccentText}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Timer24" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBox Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" Width="72" Padding="6,2" MinHeight="0" FontSize="12"
                                                     TextAlignment="Right" ToolTip="{l:Tr macro.delayHint}" v:NumberInput.IsEnabled="True" />
                                            <TextBlock Text="ms" Margin="6,0,10,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <!-- On the selection when the row is part of it (several steps), else on this step -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Style="{StaticResource RowMoveButton}" ToolTip="{l:Tr common.moveUp}"
                                                       Command="{x:Static p:MacrosPage.MoveStepUp}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" />
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource RowMoveButton}" ToolTip="{l:Tr common.moveDown}"
                                                       Command="{x:Static p:MacrosPage.MoveStepDown}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" />
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource RowButton}" ToolTip="{l:Tr common.duplicate}"
                                                       Command="{x:Static p:MacrosPage.DuplicateStep}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource RowButton}" ToolTip="{l:Tr common.delete}"
                                                       Command="{x:Static p:MacrosPage.DeleteStep}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{DynamicResource Kd.Danger}" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Editor, open under the step when it is the only one selected -->
                                    <ContentControl Margin="92,8,8,4" Content="{Binding}" ContentTemplate="{StaticResource StepEditorTemplate}" Focusable="False">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource SameItem}">
                                                <Binding />
                                                <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
