<UserControl x:Class="KDesktop.Views.Pages.CommandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KDesktop;component/Views/ActionEditors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <v:CommandIconConverter x:Key="CommandIcon" />
            <v:ActionIconConverter x:Key="ActionIcon" />
            <v:HotkeyPartsConverter x:Key="HotkeyParts" />
            <v:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <v:NullToCollapsedConverter x:Key="NullToVisible" Invert="True" />
            <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
            <v:BoolToCollapsedConverter x:Key="BoolToVisibleInv" Invert="True" />

            <!-- A hotkey drawn as key caps -->
            <DataTemplate x:Key="KeyCaps">
                <ItemsControl ItemsSource="{Binding Converter={StaticResource HotkeyParts}}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,0" Padding="7,2" CornerRadius="4" MinWidth="24"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,1,1,2">
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>

            <!-- Action rows: clicking a row expands its editor -->
            <Style x:Key="ActionRow" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Frame" CornerRadius="8" Padding="12,10" BorderThickness="1"
                                    Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static v:EditorCommands.BrowseFile}" Executed="OnBrowseFile" />
        <CommandBinding Command="{x:Static v:EditorCommands.BrowseFolder}" Executed="OnBrowseFolder" />
        <CommandBinding Command="{x:Static v:EditorCommands.BrowseWorkingDirectory}" Executed="OnBrowseWorkingDirectory" />
        <CommandBinding Command="{x:Static v:EditorCommands.BrowseSound}" Executed="OnBrowseSound" />
        <CommandBinding Command="{x:Static v:EditorCommands.PreviewSound}" Executed="OnPreviewSound" />
        <CommandBinding Command="{x:Static v:EditorCommands.CaptureKeys}" Executed="OnCaptureKeys" />
        <CommandBinding Command="{x:Static v:EditorCommands.CaptureMouse}" Executed="OnCaptureMouse" />
        <CommandBinding Command="{x:Static v:EditorCommands.TestAction}" Executed="OnTestAction" />
        <CommandBinding Command="{x:Static v:EditorCommands.RemoveAction}" Executed="OnRemoveAction" />
        <CommandBinding Command="{x:Static v:EditorCommands.MoveActionUp}" Executed="OnMoveActionUp" />
        <CommandBinding Command="{x:Static v:EditorCommands.MoveActionDown}" Executed="OnMoveActionDown" />
        <CommandBinding Command="{x:Static v:EditorCommands.DuplicateAction}" Executed="OnDuplicateAction" />
        <CommandBinding Command="{x:Static v:EditorCommands.RemoveHotkey}" Executed="OnRemoveHotkey" />
        <CommandBinding Command="{x:Static v:EditorCommands.RemoveProcess}" Executed="OnRemoveProcess" />
        <CommandBinding Command="{x:Static v:EditorCommands.EditMacro}" Executed="OnEditMacro" />
        <CommandBinding Command="{x:Static v:EditorCommands.AddAudioDevice}" Executed="OnAddAudioDevice" />
        <CommandBinding Command="{x:Static v:EditorCommands.RemoveAudioDevice}" Executed="OnRemoveAudioDevice" />
        <CommandBinding Command="{x:Static v:EditorCommands.EditKBoard}" Executed="OnEditKBoard" />
    </UserControl.CommandBindings>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Command list ──────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.commands}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr commands.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Content="{l:Tr commands.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNewCommand" HorizontalAlignment="Stretch" />
                    <ToggleButton x:Name="ShowHiddenToggle" Grid.Column="1" Margin="8,0,0,0" Padding="9,6" ToolTip="{l:Tr commands.showHidden}" Click="OnShowHidden">
                        <ui:SymbolIcon Symbol="Eye24" />
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <ListBox x:Name="CommandList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}"
                     SelectionChanged="OnCommandSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Command}">
                        <Grid x:Name="Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource CommandIcon}">
                                        <Binding />
                                        <Binding Path="Icon" />
                                        <Binding Path="PrimaryAction" />
                                        <Binding Path="PrimaryAction.Summary" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="Sub" Text="{Binding HotkeysText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Kd.AccentText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="14" Margin="4,0,0,0" ToolTip="{l:Tr commands.remote}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Remote, Converter={StaticResource BoolToCollapsed}}" />
                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="14" Margin="4,0,0,0" ToolTip="{l:Tr commands.hidden}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Hidden, Converter={StaticResource BoolToCollapsed}}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HotkeysText}" Value="">
                                <Setter TargetName="Sub" Property="Text" Value="{Binding PrimaryAction.Summary}" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.75">
                <ui:SymbolIcon Symbol="Flash24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr commands.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr commands.emptyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,24,24">
                <StackPanel x:Name="Editor">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="EditorShift" />
                    </StackPanel.RenderTransform>

                    <!-- Header -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="IconButton" Width="60" Height="60" Padding="8" Cursor="Hand" Click="OnChooseIcon" ToolTip="{l:Tr commands.changeIcon}"
                                    AutomationProperties.Name="{l:Tr commands.changeIcon}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" CornerRadius="10" Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:Tr commands.changeIcon}" Click="OnChooseIcon" />
                                        <MenuItem Header="{l:Tr commands.resetIcon}" Click="OnResetIcon" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Image x:Name="HeaderIcon" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <ui:TextBox x:Name="NameBox" FontSize="20" FontWeight="SemiBold" PlaceholderText="{l:Tr commands.namePlaceholder}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="NotesHint" Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{Binding Notes}"
                                           Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}" Foreground="{DynamicResource Kd.Warning}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{l:Tr common.enabled}" OffContent="{l:Tr common.disabled}" Margin="0,0,16,0" />
                                <ui:Button Content="{l:Tr commands.run}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Click="OnRunCommand" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:Tr commands.duplicate}" Click="OnDuplicateCommand" Margin="0,0,8,0" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr commands.delete}" Click="OnDeleteCommand" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hotkeys -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr commands.hotkeys}" />
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource KeyCaps}" VerticalAlignment="Center" />
                                                    <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="2,0,0,0" ToolTip="{l:Tr common.remove}"
                                                               Command="{x:Static v:EditorCommands.RemoveHotkey}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Capture chip -->
                                <Border x:Name="CaptureChip" Style="{StaticResource Chip}" Visibility="Collapsed" BorderBrush="{DynamicResource Kd.Accent}" Padding="12,6">
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="14" Foreground="{DynamicResource Kd.Accent}" Margin="0,0,8,0" />
                                        <TextBlock x:Name="CaptureText" Style="{StaticResource ChipText}" Foreground="{DynamicResource Kd.AccentText}" />
                                    </StackPanel>
                                </Border>
                                <ui:Button x:Name="AddHotkeyButton" Content="{l:Tr commands.addHotkey}" Icon="{ui:SymbolIcon Add24}" Click="OnAddHotkey" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock x:Name="HotkeyWarning" Style="{StaticResource Caption}" Foreground="{DynamicResource Kd.Warning}" Visibility="Collapsed" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr commands.hotkeysHint}" />
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr commands.actions}" Margin="0" VerticalAlignment="Center" />
                                <ui:Button x:Name="AddActionButton" HorizontalAlignment="Right" Content="{l:Tr commands.addAction}" Icon="{ui:SymbolIcon Add24}"
                                           Appearance="Primary" Click="OnAddAction" />
                            </Grid>
                            <TextBlock x:Name="NoActions" Style="{StaticResource Caption}" Text="{l:Tr commands.noActions}" Margin="0,4,0,8" />
                            <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" ItemContainerStyle="{StaticResource ActionRow}"
                                     v:DragReorder.IsEnabled="True" v:DragReorder.Reordered="OnActionReordered"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnActionListWheel">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid x:Name="Header" Background="Transparent" Cursor="Hand" v:DragReorder.IsHandle="True"
                                                  ToolTip="{l:Tr commands.dragHint}" ToolTipService.InitialShowDelay="1200">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Drag grip, visible on hover -->
                                                <ui:SymbolIcon x:Name="Grip" Symbol="ReOrderDotsVertical24" FontSize="16" Margin="-8,0,0,0" Width="14"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Cursor="SizeNS"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}" Margin="10,0,12,0">
                                                    <Image Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource ActionIcon}">
                                                                <Binding />
                                                                <Binding Path="Summary" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding Enabled}" ToolTip="{l:Tr common.enabled}" Margin="0,0,4,0" MinWidth="0" />
                                                    <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr commands.testAction}" Command="{x:Static v:EditorCommands.TestAction}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr common.duplicate}" Command="{x:Static v:EditorCommands.DuplicateAction}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr common.moveUp}" Command="{x:Static v:EditorCommands.MoveActionUp}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr common.moveDown}" Command="{x:Static v:EditorCommands.MoveActionDown}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" />
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}" Command="{x:Static v:EditorCommands.RemoveAction}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{DynamicResource Kd.Danger}" />
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Inline editor (visible when the row is selected) -->
                                            <Border x:Name="EditorPanel" Margin="46,14,4,4" Visibility="Collapsed">
                                                <ContentControl Content="{Binding}" Focusable="False" />
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="EditorPanel" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Header" Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Grip" Property="Opacity" Value="0.8" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr commands.options}" />
                            <UniformGrid Columns="2">
                                <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding BlockKey}" Content="{l:Tr commands.blockKey}" ToolTip="{l:Tr commands.blockKeyHint}" />
                                <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding Remote}" Content="{l:Tr commands.remoteOption}" ToolTip="{l:Tr commands.remoteHint}" />
                                <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding RunOnStartup}" Content="{l:Tr commands.runOnStartup}" />
                                <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding RunOnExit}" Content="{l:Tr commands.runOnExit}" />
                                <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding IgnoreDisabledApps}" Content="{l:Tr commands.ignoreDisabled}" ToolTip="{l:Tr commands.ignoreDisabledHint}" />
                                <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding Hidden}" Content="{l:Tr commands.hiddenOption}" />
                            </UniformGrid>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="{l:Tr commands.sound}" />
                            <Grid Margin="0,0,0,14" MaxWidth="460" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SoundBox" IsEditable="True" Text="{Binding Sound, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" MinWidth="280" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon Play24}" ToolTip="{l:Tr editor.preview}"
                                           Command="{x:Static v:EditorCommands.PreviewSound}" CommandParameter="{Binding Sound}" />
                                <ui:Button Grid.Column="2" Margin="6,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}"
                                           Command="{x:Static v:EditorCommands.BrowseSound}" CommandParameter="{Binding}" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr commands.processes}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{l:Tr commands.processesHint}" />
                            <ItemsControl ItemsSource="{Binding Processes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                                <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0"
                                                           Command="{x:Static v:EditorCommands.RemoveProcess}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                                <ComboBox x:Name="ProcessBox" IsEditable="True" Width="240" DropDownOpened="OnProcessDropDown" KeyDown="OnProcessKeyDown" />
                                <ui:Button Margin="8,0,0,0" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddProcess" />
                                <ui:Button Margin="8,0,0,0" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickProcess" ToolTip="{l:Tr picker.tooltip}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr commands.notes}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
