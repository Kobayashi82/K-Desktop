<UserControl x:Class="KDesktop.Views.Pages.KBoardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <v:KeyCapsConverter x:Key="HotkeyParts" />
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />

        <!-- A key or combination drawn as key caps -->
        <DataTemplate x:Key="KeyCaps">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource HotkeyParts}}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,4,0" Padding="7,2" CornerRadius="4" MinWidth="24"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,1,1,2">
                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Pill toggles (modifier layer) and segmented choices (what the key does) -->
        <Style x:Key="Pill" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" CornerRadius="14" Padding="12,5" BorderThickness="1"
                                Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="6" Padding="12,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemapRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="6" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.Selected}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Profile list ──────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.kboard}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr kboard.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <ui:Button Margin="0,0,0,10" Content="{l:Tr kboard.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNewProfile" HorizontalAlignment="Stretch" />
            </StackPanel>

            <ListBox x:Name="ProfileList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource CardRowItem}"
                     SelectionChanged="OnProfileSelected" PreviewMouseRightButtonUp="OnProfileRightClick" KeyDown="OnProfileListKey">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:KBoardProfile}">
                        <Grid x:Name="Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,1,0,0" Text="{Binding RemapsText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <!-- Where: the first application, +N when there are more (tooltip: all of them) -->
                                <v:InlineBadgePanel Margin="0,1,0,0">
                                    <TextBlock Text="{Binding FirstApp}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Kd.AccentText}" />
                                    <Border x:Name="MoreApps" Margin="6,0,0,0" Padding="5,0" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource Kd.AccentSoft}" ToolTip="{Binding AppsList}">
                                        <TextBlock Text="{Binding MoreAppsText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                                    </Border>
                                </v:InlineBadgePanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" IsChecked="{Binding Active}" ToolTip="{l:Tr kboard.activeHint}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MoreAppsText}" Value="">
                                <Setter TargetName="MoreApps" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" MaxWidth="520" Margin="0,0,24,16">
                <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr kboard.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr kboard.emptyText}" Style="{StaticResource Caption}" TextAlignment="Center" />
                <TextBlock x:Name="ListEmpty" Margin="0,8,0,0" Text="{l:Tr kboard.listEmpty}" Style="{StaticResource Caption}" TextAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,24,16">
                <StackPanel x:Name="Editor">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="EditorShift" />
                    </StackPanel.RenderTransform>

                    <!-- Header -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="60" Height="60" CornerRadius="10" VerticalAlignment="Top" Background="{DynamicResource Kd.AccentSoft}">
                                    <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                                </Border>
                                <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" v:ResponsiveHeader.MinNameWidth="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:TextBox x:Name="NameBox" ClearButtonEnabled="False" FontSize="16" FontWeight="SemiBold" PlaceholderText="{l:Tr kboard.namePlaceholder}"
                                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                GotKeyboardFocus="OnNameFocus" LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" v:ResponsiveHeader.IsSide="True">
                                        <ui:ToggleSwitch IsChecked="{Binding Active}" OnContent="{l:Tr kboard.active}" OffContent="{l:Tr kboard.inactive}"
                                                         ToolTip="{l:Tr kboard.activeHint}" Margin="0,0,12,0" />
                                        <v:IconToggle IsChecked="{Binding IgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24" Margin="0,0,8,0"
                                                      Title="{l:Tr kboard.ignoreDisabled}" Hint="{l:Tr kboard.ignoreDisabledHint}" />
                                        <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon FlashAdd20, FontSize=18}" ToolTip="{l:Tr kboard.createCommand}" AutomationProperties.Name="{l:Tr kboard.createCommand}"
                                                   Click="OnCreateCommand" Margin="0,0,8,0" />
                                        <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Copy24, FontSize=18}" ToolTip="{l:Tr kboard.duplicate}" AutomationProperties.Name="{l:Tr kboard.duplicate}"
                                                   Click="OnDuplicate" Margin="0,0,8,0" />
                                        <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Delete24, FontSize=18}" ToolTip="{l:Tr kboard.delete}" AutomationProperties.Name="{l:Tr kboard.delete}" Click="OnDelete" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                        <TextBlock x:Name="NameError" Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{l:Tr kboard.nameRequired}"
                                                   Foreground="{DynamicResource Kd.Danger}" Visibility="Collapsed" />
                                        <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                    </StackPanel>
                                    <!-- How the keyboard works, on hover (as in QuickMenu) -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                                            Cursor="Help" ToolTipService.ShowDuration="60000" ToolTipService.InitialShowDelay="200" AutomationProperties.Name="{l:Tr kboard.surfaceHint}">
                                        <Border.ToolTip>
                                            <StackPanel MaxWidth="380">
                                                <TextBlock TextWrapping="Wrap" Text="{l:Tr kboard.surfaceHint}" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:Tr kboard.surfaceDotHint}" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:Tr kboard.layerHint}" />
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource Kd.Accent}" Opacity="0.45" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Keyboard and mouse (foldable; «Pulsar tecla» stays on the header; the layers are the corners of the modifier keys) -->
                    <ui:CardExpander x:Name="KeyboardExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Keyboard24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr kboard.keyboard}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr kboard.keyboard}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,8,0">
                                    <ui:Button x:Name="CaptureSourceButton" Appearance="Primary" Content="{l:Tr kboard.captureSource}" Icon="{ui:SymbolIcon Keyboard24}"
                                               Click="OnCaptureSource" ToolTip="{l:Tr kboard.captureSourceHint}" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <!-- Narrow, the navigation block, the pad and the mouse go under the keys (OnKeyboardAreaSize) -->
                        <Grid x:Name="KeyboardArea" SizeChanged="OnKeyboardAreaSize">
                            <v:KBoardSurface x:Name="Surface" MaxHeight="340" HorizontalAlignment="Center" />
                        </Grid>
                    </ui:CardExpander>

                    <!-- Selected key -->
                    <Border x:Name="KeyPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="SourceCaps" ContentTemplate="{StaticResource KeyCaps}" Focusable="False" VerticalAlignment="Center" />
                                <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="18" Margin="8,0,12,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Border Grid.Column="2" HorizontalAlignment="Left" CornerRadius="8" Padding="3" Background="{DynamicResource Kd.Subtle}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="KindNormal" Style="{StaticResource Segment}" GroupName="kind" Checked="OnKind" Content="{l:Tr kboard.kind.normal}" />
                                        <RadioButton x:Name="KindKeys" Style="{StaticResource Segment}" GroupName="kind" Checked="OnKind" Content="{l:Tr enum.remapKind.Keys}" />
                                        <RadioButton x:Name="KindText" Style="{StaticResource Segment}" GroupName="kind" Checked="OnKind" Content="{l:Tr enum.remapKind.Text}" />
                                        <RadioButton x:Name="KindDisable" Style="{StaticResource Segment}" GroupName="kind" Checked="OnKind" Content="{l:Tr enum.remapKind.Disable}" />
                                        <RadioButton x:Name="KindCommand" Style="{StaticResource Segment}" GroupName="kind" Checked="OnKind" Content="{l:Tr enum.remapKind.Command}" />
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="RemapEnabled" Grid.Column="3" Content="{l:Tr common.enabled}" IsChecked="{Binding Enabled}" Visibility="Collapsed" />
                                <!-- No key chosen: the panel goes away -->
                                <ui:Button Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource IconButton}" Click="OnCloseKey"
                                           ToolTip="{l:Tr common.close}" AutomationProperties.Name="{l:Tr common.close}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                                </ui:Button>
                            </Grid>

                            <!-- Keys -->
                            <StackPanel x:Name="KeysPanel" Visibility="Collapsed">
                                <WrapPanel>
                                    <StackPanel Margin="0,0,20,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr kboard.targetKey}" />
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="TargetKeyBox" Width="190" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="380"
                                                      SelectionChanged="OnTargetKeyChanged" LostFocus="OnTargetKeyLostFocus" />
                                            <ui:Button x:Name="CaptureTargetButton" Margin="8,0,0,0" Content="{l:Tr editor.captureKeys}" Icon="{ui:SymbolIcon Keyboard24}"
                                                       Click="OnCaptureTarget" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr kboard.withModifiers}" />
                                        <StackPanel Orientation="Horizontal" Height="34">
                                            <ToggleButton x:Name="TargetCtrl" Style="{StaticResource Pill}" Content="Ctrl" Click="OnTargetMod" />
                                            <ToggleButton x:Name="TargetAlt" Style="{StaticResource Pill}" Content="Alt" Click="OnTargetMod" />
                                            <ToggleButton x:Name="TargetShift" Style="{StaticResource Pill}" Content="Shift" Click="OnTargetMod" />
                                            <ToggleButton x:Name="TargetWin" Style="{StaticResource Pill}" Content="Win" Click="OnTargetMod" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr kboard.result}" />
                                        <ContentControl x:Name="TargetCaps" ContentTemplate="{StaticResource KeyCaps}" Focusable="False" Height="34" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr kboard.keysHint}" />
                            </StackPanel>

                            <!-- Text -->
                            <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr kboard.textToType}" />
                                <ui:TextBox x:Name="TextBox" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr kboard.textHint}" />
                            </StackPanel>

                            <!-- Command -->
                            <StackPanel x:Name="CommandPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.command}" />
                                <ComboBox x:Name="CommandBox" ItemsSource="{Binding Source={x:Static v:Lookups.CommandList}}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding CommandId}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                          MaxDropDownHeight="420" Width="360" HorizontalAlignment="Left" SelectionChanged="OnCommandChanged" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr kboard.commandHint}" />
                            </StackPanel>

                            <TextBlock x:Name="DisableHint" Style="{StaticResource Caption}" Visibility="Collapsed" Text="{l:Tr kboard.disableHint}" />
                            <TextBlock x:Name="NormalHint" Style="{StaticResource Caption}" Visibility="Collapsed" Text="{l:Tr kboard.normalHint}" />

                            <Border x:Name="Warning" Margin="0,12,0,0" CornerRadius="6" Padding="10,8" Background="{DynamicResource Kd.DangerSoft}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{DynamicResource Kd.Danger}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Every remap of the profile (foldable; «Quitar todas» stays on the header) -->
                    <ui:CardExpander x:Name="RemapsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon ArrowSwap24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr kboard.remaps}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr kboard.remaps}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:Button x:Name="ClearAllButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,8,0" MinHeight="36" Icon="{ui:SymbolIcon Delete24}"
                                           Content="{l:Tr kboard.clearAll}" Click="OnClearAll" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock x:Name="NoRemaps" Style="{StaticResource Caption}" Margin="4,0,4,4" Text="{l:Tr kboard.noRemaps}" />
                            <!-- Picks on release: choosing a remap changes the panel above, and the list would move under a pressed mouse -->
                            <ListBox x:Name="RemapList" ItemsSource="{Binding Remaps}" ItemContainerStyle="{StaticResource RemapRow}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnRemapSelected"
                                     PreviewMouseLeftButtonUp="OnRemapMouseUp" PreviewMouseRightButtonUp="OnRemapRightClick" PreviewMouseWheel="OnListWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:KeyRemap}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Margin="0,0,6,0" ToolTip="{l:Tr common.enabled}" />
                                            <ContentControl Grid.Column="1" Content="{Binding From}" ContentTemplate="{StaticResource KeyCaps}" Focusable="False" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding TargetText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Kind, Converter={x:Static v:RemapKindNameConverter.Instance}}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <ui:Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="{l:Tr common.delete}" Click="OnDeleteRemap" Tag="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Options (folded unless opened by hand, as in Comandos): the apps it works in -->
                    <ui:CardExpander x:Name="OptionsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Options24}"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.options}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.options}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{l:Tr kboard.apps}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{l:Tr kboard.appsHint}" />
                            <ItemsControl ItemsSource="{Binding Processes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                                <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0" Click="OnRemoveProcess" Tag="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox x:Name="ProcessBox" IsEditable="True" Width="240" v:Placeholder.Text="{l:Tr common.processPlaceholder}" DropDownOpened="OnProcessDropDown" DropDownClosed="OnProcessPicked" KeyDown="OnProcessKeyDown" />
                                <ui:Button Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddProcess" />
                                <ui:Button Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickProcess" ToolTip="{l:Tr picker.tooltip}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Notes (foldable, as in Comandos) -->
                    <ui:CardExpander x:Name="NotesExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Note24}"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.notes}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.notes}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 AutomationProperties.Name="{l:Tr commands.notes}" />
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
