<UserControl x:Class="KDesktop.Views.Pages.AboutPage"
             xmlns:core="clr-namespace:KDesktop.Core;assembly=KDesktop.Core"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <UserControl.Resources>
        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="13" Padding="11,4" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- As wide as the window up to 980, like the sections of Opciones -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,24">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="980" /></Grid.ColumnDefinitions>
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="28,24">
                <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/KDesktop;component/Assets/Icons/KDesktop.ico" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                        <!-- As in the sidebar: the name, and the version smaller in the accent colour -->
                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold">
                            <Run Text="{x:Static core:AppPaths.AppName}" FontSize="30" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Run Text=" " FontSize="30" /><Run Text="{x:Static core:AppPaths.ShortVersion}" FontSize="20" Foreground="{DynamicResource Kd.AccentText}" />
                        </TextBlock>
                        <TextBlock Text="{l:Tr about.tagline}" Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
                <!-- The welcome of the first start, again -->
                <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon PlayCircle24}"
                           Content="{l:Tr welcome.show}" Click="OnShowWelcome" />
                </Grid>
            </Border>

            <!-- Did you know… -->
            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Lightbulb24" Filled="True" FontSize="20" Foreground="{DynamicResource Kd.AccentText}" Margin="0,0,10,0" />
                            <TextBlock Text="{l:Tr tips.title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <WrapPanel x:Name="Filters" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="TipHost" MinHeight="128" ClipToBounds="True" Background="Transparent" MouseEnter="OnTipEnter" MouseLeave="OnTipLeave">
                        <Grid x:Name="TipCard">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TipShift" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="TipIcon" Width="60" Height="60" VerticalAlignment="Top" Margin="0,2,20,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TipCategory" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <WrapPanel x:Name="TipKeys" Margin="0,0,0,10" />
                                <TextBlock x:Name="TipText" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Height="3" CornerRadius="1.5" Background="{DynamicResource Kd.BarTrack}" />
                            <Border Height="3" CornerRadius="1.5" Background="{DynamicResource Kd.Bar}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Progress" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="Counter" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Style="{StaticResource IconButton}" Padding="8" Icon="{ui:SymbolIcon ChevronLeft24}" ToolTip="{l:Tr tips.previous}" Click="OnPrevious" />
                            <ui:Button x:Name="PlayButton" Style="{StaticResource IconButton}" Padding="8" Icon="{ui:SymbolIcon Pause24}" ToolTip="{l:Tr tips.pause}" Click="OnPlayPause" />
                            <ui:Button Style="{StaticResource IconButton}" Padding="8" Icon="{ui:SymbolIcon ArrowShuffle24}" ToolTip="{l:Tr tips.random}" Click="OnRandom" />
                            <ui:Button Style="{StaticResource IconButton}" Padding="8" Icon="{ui:SymbolIcon ChevronRight24}" ToolTip="{l:Tr tips.next}" Click="OnNext" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Margin="4,4,0,0">
                <TextBlock Style="{StaticResource Caption}"><Run Text="© Kobayashi82" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{l:Tr about.created}" /></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://github.com/Kobayashi82" RequestNavigate="OnOpenLink" Foreground="{DynamicResource Kd.AccentText}" ToolTip="https://github.com/Kobayashi82">github.com/Kobayashi82</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:SymbolIcon Symbol="Book24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Hyperlink x:Name="DocsLink" RequestNavigate="OnOpenLink" Foreground="{DynamicResource Kd.AccentText}"><Run Text="{l:Tr about.docs}" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:SymbolIcon Symbol="Sparkle24" Filled="True" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{l:Tr about.claude}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
