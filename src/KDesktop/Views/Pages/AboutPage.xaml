<UserControl x:Class="KDesktop.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28,24">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/KDesktop;component/Assets/Icons/KDesktop.ico" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="K-Desktop 5.0" FontSize="30" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:Tr about.tagline}" Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr about.tips}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" LineHeight="22" Text="{l:Tr about.tipsText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr about.languages}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:Tr about.languagesText}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="4,4,0,0" Text="© Kobayashi82" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
