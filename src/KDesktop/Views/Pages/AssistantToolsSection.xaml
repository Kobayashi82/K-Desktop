<UserControl x:Class="KDesktop.Views.Pages.AssistantToolsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Options → Assistant → Tools (stage 9.3): every tool with its switch, its risk and a test; and, as pages of their own
         inside it (Part), the MCP servers, the JSON tools' files and the secrets. The assistant process says what there is
         (toolsState); the rows are made in code. -->
    <StackPanel>
        <!-- The module is off, or its process is not running -->
        <Border x:Name="OffBox" Style="{StaticResource InfoBox}" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="OffText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="GoGeneral" Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr brainOptions.goGeneral}" Click="OnGoGeneral" />
            </Grid>
        </Border>

        <!-- MCP servers -->
        <Border x:Name="ServersCard" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr toolsOptions.servers}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr toolsOptions.serversIntro}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowImport24}" Content="{l:Tr toolsOptions.import}" Click="OnImport" />
                        <ui:Button Icon="{ui:SymbolIcon Add24}" Content="{l:Tr toolsOptions.addServer}" Click="OnAddServer" />
                    </StackPanel>
                </Grid>
                <Border x:Name="McpErrorBox" Style="{StaticResource InfoBox}" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="McpErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Kd.Danger}" />
                </Border>
                <TextBlock x:Name="NoServers" Style="{StaticResource Caption}" Margin="0,4,0,4" Text="{l:Tr toolsOptions.noServers}" />
                <StackPanel x:Name="ServerRows" />
            </StackPanel>
        </Border>

        <!-- Every tool -->
        <Border x:Name="ToolsCard" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr toolsOptions.tools}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr toolsOptions.toolsIntro}" />
                    </StackPanel>
                    <ui:TextBox x:Name="FilterBox" Grid.Column="1" Width="220" VerticalAlignment="Center" PlaceholderText="{l:Tr toolsOptions.filter}"
                                Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="{l:Tr toolsOptions.filter}" TextChanged="OnFilter" />
                </Grid>
                <TextBlock x:Name="NoTools" Style="{StaticResource Caption}" Margin="0,4,0,4" />
                <StackPanel x:Name="ToolGroups" />
            </StackPanel>
        </Border>

        <!-- JSON tools -->
        <Border x:Name="FilesCard" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr toolsOptions.files}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr toolsOptions.filesIntro}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:Tr toolsOptions.openFolder}" Click="OnOpenFolder" />
                        <ui:Button x:Name="NewToolButton" Icon="{ui:SymbolIcon Add24}" Content="{l:Tr toolsOptions.newTool}" Click="OnNewTool" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="NoFiles" Style="{StaticResource Caption}" Margin="0,4,0,4" Text="{l:Tr toolsOptions.noFiles}" />
                <StackPanel x:Name="FileRows" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                    <Hyperlink Click="OnGuide"><Run Text="{l:Tr toolsOptions.guide}" /></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Secrets -->
        <Border x:Name="SecretsCard" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr toolsOptions.secrets}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" Text="{l:Tr toolsOptions.secretsIntro}" />
                <TextBlock x:Name="NoSecrets" Style="{StaticResource Caption}" Margin="0,4,0,4" Text="{l:Tr toolsOptions.noSecrets}" />
                <StackPanel x:Name="SecretRows" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NewSecretName" PlaceholderText="{l:Tr toolsOptions.secretName}" AutomationProperties.Name="{l:Tr toolsOptions.secretName}" ClearButtonEnabled="False" />
                    <ui:PasswordBox x:Name="NewSecretValue" Grid.Column="1" Margin="8,0,0,0" PlaceholderText="{l:Tr toolsOptions.secretValue}"
                                    AutomationProperties.Name="{l:Tr toolsOptions.secretValue}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}" Content="{l:Tr toolsOptions.addSecret}" Click="OnAddSecret" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
