<UserControl x:Class="KDesktop.Views.Pages.AssistantToolsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Options → Assistant → Tools (stage 9.3, made over in 5.0.133): one page per Part —the summary with a search over
         every tool, the built-in ones by subject, the user's own, the MCP servers, one MCP server with its tools, and the
         secrets—. The assistant process says what there is (toolsState); the cards are made in code, only for the page
         that shows. -->
    <StackPanel>
        <!-- The module is off, or its process is not running -->
        <Border x:Name="OffBox" Style="{StaticResource InfoBox}" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="OffText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="GoGeneral" Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr brainOptions.goGeneral}" Click="OnGoGeneral" />
            </Grid>
        </Border>
        <StackPanel x:Name="Body" />
    </StackPanel>
</UserControl>
