<UserControl x:Class="KDesktop.Views.Pages.AssistantBrainSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <!-- Options → Assistant → Brain (stage 3.1; its own brain since 5.0.107; 5.0.111: what is loaded on top, the models of
         every server in one list, each list in its panel): which model, what is in memory, the models, where they are and
         the other servers. What it does happens in the assistant process (downloads are K-Desktop's); this only shows and
         asks. Rows are made in code (UI Automation sees them). -->
    <StackPanel>
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr brainOptions.title}" />
                <ui:Button x:Name="CheckButton" Grid.Column="1" VerticalAlignment="Top" Appearance="Transparent" Padding="8,6"
                           Icon="{ui:SymbolIcon ArrowSync24}" Content="{l:Tr brainOptions.check}" Click="OnCheck" />
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{l:Tr brainOptions.intro}" />

            <!-- The module is off: nothing to talk to -->
            <Border x:Name="OffBox" Style="{StaticResource InfoBox}" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:Tr brainOptions.moduleOff}" />
                    <ui:Button MinHeight="36" Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr brainOptions.goGeneral}" Click="OnGoGeneral" />
                </Grid>
            </Border>

            <StackPanel x:Name="Body">
                <!-- What is in memory now (or what is wrong), each loaded model with its «Liberar» -->
                <Border Style="{StaticResource ListPanel}" Margin="0,0,0,8">
                    <StackPanel x:Name="StateRows" />
                </Border>

                <!-- The model names are long: the combo and its buttons go under the description, the whole width -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="{l:Tr brainOptions.model}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.modelHint}" />
                    </StackPanel>
                    <ComboBox x:Name="ModelBox" Grid.Row="1" SelectionChanged="OnModelChanged" AutomationProperties.Name="{l:Tr brainOptions.model}" />
                    <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="LoadButton" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr brainOptions.loadButton}"
                               Icon="{ui:SymbolIcon ArrowUpload24}" Click="OnLoad" />
                    <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="{l:Tr brainOptions.browse}" Click="OnBrowseModel"
                               AutomationProperties.Name="{l:Tr brainOptions.browseModelTitle}" />
                </Grid>

                <!-- Stage 12: the model that thinks harder, and how long it may -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="{l:Tr brainOptions.think}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.thinkHint}" />
                    </StackPanel>
                    <ComboBox x:Name="ThinkBox" Grid.Row="1" SelectionChanged="OnThinkChanged" AutomationProperties.Name="{l:Tr brainOptions.think}" />
                    <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="ThinkLoadButton" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr brainOptions.loadButton}"
                               Icon="{ui:SymbolIcon ArrowUpload24}" Click="OnThinkLoad" />
                    <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="{l:Tr brainOptions.browse}" Click="OnBrowseThinkModel"
                               AutomationProperties.Name="{l:Tr brainOptions.browseThinkTitle}" />
                    <!-- 5.0.289: another model may answer as it is; the same one always reasons -->
                    <CheckBox x:Name="ThinkReasonCheck" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{l:Tr brainOptions.thinkReason}"
                              ToolTip="{l:Tr brainOptions.thinkReasonHint}" Checked="OnThinkReason" Unchecked="OnThinkReason" />
                </Grid>

                <!-- Part of «Para pensar más» (indented): how much it reasons then -->
                <Grid x:Name="ThinkTokensRow" Style="{StaticResource SettingRow}" Margin="28,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr brainOptions.thinkTokens}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.thinkTokensHint}" />
                    </StackPanel>
                    <ComboBox x:Name="ThinkTokensBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnThinkTokensChanged"
                              AutomationProperties.Name="{l:Tr brainOptions.thinkTokens}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr brainOptions.oneAtATime}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.oneAtATimeHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="OneAtATimeSwitch" Grid.Column="1" Checked="OnOneAtATime" Unchecked="OnOneAtATime" AutomationProperties.Name="{l:Tr brainOptions.oneAtATime}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr brainOptions.vision}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.visionHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="VisionSwitch" Grid.Column="1" Checked="OnVision" Unchecked="OnVision" AutomationProperties.Name="{l:Tr brainOptions.vision}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr brainOptions.keep}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.keepHint}" />
                    </StackPanel>
                    <ComboBox x:Name="KeepBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnKeepChanged"
                              AutomationProperties.Name="{l:Tr brainOptions.keep}" />
                </Grid>

                <!-- Stage 12: a game on the whole screen takes the models out of the graphics card -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr brainOptions.freeForGames}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainOptions.freeForGamesHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="GamesSwitch" Grid.Column="1" Checked="OnGames" Unchecked="OnGames" AutomationProperties.Name="{l:Tr brainOptions.freeForGames}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Every model: those of this PC and those of each other server, each group in its panel -->
    <Border x:Name="ModelsCard" Style="{StaticResource Card}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2" Text="{l:Tr brainModels.list}" />
                    <TextBlock x:Name="ModelsCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button MinHeight="36" x:Name="AddModelButton" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Appearance="Primary" Content="{l:Tr brainModels.add}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnAddModel" />
            </Grid>

            <Border x:Name="DownloadBox" Style="{StaticResource InfoBox}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:Button MinHeight="36" x:Name="CancelDownloadButton" Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr common.cancel}"
                                   Icon="{ui:SymbolIcon Dismiss24}" Click="OnCancelDownload" />
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,10,0,0" Maximum="1" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ModelGroups" Margin="0,6,0,0" />
        </StackPanel>
    </Border>

    <!-- Where the models of this PC are: the llama-servers that open them and the folders -->
    <Border x:Name="LocalCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr brainModels.title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{l:Tr brainModels.intro}" />

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr brainModels.servers}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainModels.serversHint}" />
                </StackPanel>
                <ui:Button MinHeight="36" Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr brainModels.addServer}" Icon="{ui:SymbolIcon Add24}" Click="OnAddServer" />
            </Grid>
            <Border Style="{StaticResource ListPanel}" Margin="0,8,0,16">
                <StackPanel x:Name="ServerRows" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr brainModels.folders}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr brainModels.foldersHint}" />
                </StackPanel>
                <ui:Button MinHeight="36" Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr brainModels.addFolder}" Icon="{ui:SymbolIcon FolderAdd24}" Click="OnAddFolder" />
            </Grid>
            <Border Style="{StaticResource ListPanel}" Margin="0,8,0,0">
                <StackPanel x:Name="FolderRows" />
            </Border>
        </StackPanel>
    </Border>

    <!-- Other servers -->
    <Border x:Name="RemoteCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr brainRemotes.title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap" Text="{l:Tr brainRemotes.intro}" />
            <Border Style="{StaticResource ListPanel}" Margin="0,8,0,0">
                <StackPanel x:Name="RemoteRows" />
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="NewKindBox" SelectionChanged="OnNewKindChanged" AutomationProperties.Name="{l:Tr brainRemotes.kind}" />
                <ui:TextBox x:Name="NewEndpointBox" Grid.Column="1" Margin="8,0,0,0" TextChanged="OnNewEndpointChanged" AutomationProperties.Name="{l:Tr brainRemotes.endpoint}" />
                <PasswordBox x:Name="NewKeyBox" Grid.Column="2" Margin="8,0,0,0" VerticalContentAlignment="Center" AutomationProperties.Name="{l:Tr brainOptions.apiKey}"
                             ToolTip="{l:Tr brainOptions.apiKeyHint}" />
                <ui:Button MinHeight="36" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr brainRemotes.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddRemote" />
            </Grid>
            <TextBlock x:Name="NewPlaceText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>

    <!-- Test the model (stage 3.9) -->
    <a:BenchView />

    <!-- What no longer asks (stage 4.3) -->
    <a:TrustView />
    </StackPanel>
</UserControl>
