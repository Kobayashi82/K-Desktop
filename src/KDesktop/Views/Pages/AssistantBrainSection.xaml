<UserControl x:Class="KDesktop.Views.Pages.AssistantBrainSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <!-- Options → Assistant → Brain (stage 3.1): where the AI is, which model, and getting it ready on a PC without
         anything. What it does happens in the assistant process; this only shows and asks. -->
    <StackPanel>
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr brainOptions.title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:Tr brainOptions.intro}" />

            <!-- The module is off: nothing to talk to -->
            <Border x:Name="OffBox" Style="{StaticResource InfoBox}" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:Tr brainOptions.moduleOff}" />
                    <ui:Button Grid.Column="1" Margin="12,0,0,0" Content="{l:Tr brainOptions.goGeneral}" Click="OnGoGeneral" />
                </Grid>
            </Border>

            <StackPanel x:Name="Body">
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr brainOptions.provider}" />
                        <TextBlock x:Name="ProviderHint" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ComboBox x:Name="ProviderBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Name"
                              SelectionChanged="OnProviderChanged" AutomationProperties.Name="{l:Tr brainOptions.provider}" />
                </Grid>

                <StackPanel x:Name="ServerRows">
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr brainOptions.endpoint}" />
                            <TextBlock x:Name="PlaceText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ui:TextBox x:Name="EndpointBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="OnEndpointLeft"
                                    AutomationProperties.Name="{l:Tr brainOptions.endpoint}" />
                    </Grid>

                    <Grid x:Name="KeyRow" Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr brainOptions.apiKey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr brainOptions.apiKeyHint}" />
                        </StackPanel>
                        <PasswordBox x:Name="KeyBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="OnKeyLeft"
                                     AutomationProperties.Name="{l:Tr brainOptions.apiKey}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr brainOptions.model}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr brainOptions.modelHint}" />
                        </StackPanel>
                        <ComboBox x:Name="ModelBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnModelChanged"
                                  AutomationProperties.Name="{l:Tr brainOptions.model}" />
                    </Grid>

                    <!-- How it is now -->
                    <Border Style="{StaticResource InfoBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="2,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StateText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <ui:Button x:Name="CheckButton" Grid.Column="2" Margin="12,0,0,0" Content="{l:Tr brainOptions.check}"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheck" />
                        </Grid>
                    </Border>

                    <!-- Getting it ready: install Ollama, open it, download a model -->
                    <Border x:Name="SetupBox" Style="{StaticResource InfoBox}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                                <TextBlock x:Name="SetupText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ui:Button x:Name="SetupMain" Appearance="Primary" Click="OnSetupMain" />
                                    <ui:Button x:Name="SetupOther" Margin="8,0,0,0" Click="OnSetupOther" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="JobProgress" Height="4" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed" />
                            <TextBlock x:Name="JobText" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Other servers found on this PC (presenters, not an ItemsControl: its items hide their buttons from UI Automation) -->
                    <StackPanel x:Name="FoundList" Visibility="Collapsed">
                        <StackPanel.Resources>
                            <DataTemplate x:Key="FoundTemplate">
                                <Border Style="{StaticResource InfoBox}" Margin="0,4,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Search24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:Button Grid.Column="2" Margin="12,0,0,0" Content="{l:Tr brainOptions.use}" Tag="{Binding}" Click="OnUseFound"
                                                   AutomationProperties.Name="{Binding Text}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </StackPanel.Resources>
                    </StackPanel>

                    <Grid Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr brainOptions.free}" />
                            <TextBlock x:Name="FreeText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ui:Button x:Name="FreeButton" Grid.Column="1" VerticalAlignment="Center" Content="{l:Tr brainOptions.freeButton}"
                                   Icon="{ui:SymbolIcon Broom24}" Click="OnFree" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Test the model (stage 3.9) -->
    <a:BenchView />
    </StackPanel>
</UserControl>
