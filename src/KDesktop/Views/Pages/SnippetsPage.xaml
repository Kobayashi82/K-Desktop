<UserControl x:Class="KDesktop.Views.Pages.SnippetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── List (the page's data is the settings: on, prefix) ───── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.snippets}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding SnippetsEnabled}" Content="{l:Tr snippets.enabled}" ToolTip="{l:Tr snippets.enabledHint}" />
                        <DockPanel Margin="0,10,0,0">
                            <ui:TextBox DockPanel.Dock="Right" Width="64" MaxLength="3" VerticalAlignment="Center" ClearButtonEnabled="False" FontFamily="Cascadia Mono, Consolas"
                                        Text="{Binding SnippetPrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr snippets.prefix}"
                                        LostKeyboardFocus="OnPrefixLostFocus" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{l:Tr snippets.prefix}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr snippets.prefixHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr snippets.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <ui:Button Margin="0,0,0,10" Content="{l:Tr snippets.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNew" HorizontalAlignment="Stretch" />
            </StackPanel>

            <ListBox x:Name="SnippetList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource CardRowItem}"
                     SelectionChanged="OnSelected" PreviewMouseRightButtonUp="OnRightClick" KeyDown="OnListKey">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:TextSnippet}">
                        <Grid x:Name="Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="TextExpand24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <!-- As a command's row: what is typed as its name, what it writes under it, and where -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding DataContext.SnippetPrefix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" /><Run Text="{Binding Abbreviation, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,1,0,0" Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <!-- Where, as in K-Board: the first application, +N when there are more (tooltip: all of them) -->
                                <v:InlineBadgePanel Margin="0,1,0,0">
                                    <TextBlock Text="{Binding FirstApp}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Kd.AccentText}" />
                                    <Border x:Name="MoreApps" Margin="6,0,0,0" Padding="5,0" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource Kd.AccentSoft}" ToolTip="{Binding AppsList}">
                                        <TextBlock Text="{Binding MoreAppsText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                                    </Border>
                                </v:InlineBadgePanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" IsChecked="{Binding Enabled}"
                                             ToolTip="{l:Tr snippets.on}" AutomationProperties.Name="{l:Tr snippets.on}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MoreAppsText}" Value="">
                                <Setter TargetName="MoreApps" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="0,0,24,16">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" MaxWidth="520">
                <ui:SymbolIcon Symbol="TextExpand24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr snippets.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="Editor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="EditorShift" />
                </ScrollViewer.RenderTransform>
                <StackPanel>
                    <!-- Header: the abbreviation, on/off, duplicate, delete -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="10" VerticalAlignment="Top" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="TextExpand24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr snippets.abbreviation}" />
                                <DockPanel>
                                    <TextBlock x:Name="PrefixShown" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                                    <ui:TextBox x:Name="AbbreviationBox" ClearButtonEnabled="False" FontSize="16" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"
                                                PlaceholderText="{l:Tr snippets.abbreviationPlaceholder}" MaxLength="40"
                                                Text="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}"
                                                GotKeyboardFocus="OnAbbreviationFocus" LostKeyboardFocus="OnAbbreviationLostFocus" KeyDown="OnAbbreviationKeyDown" />
                                </DockPanel>
                                <TextBlock x:Name="HowText" Margin="2,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="16,22,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:ToggleSwitch IsChecked="{Binding Enabled}" Content="{l:Tr snippets.on}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Save24, FontSize=18}" ToolTip="{l:Tr transfer.export}" AutomationProperties.Name="{l:Tr transfer.export}"
                                           Click="OnExport" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Copy24, FontSize=18}" ToolTip="{l:Tr common.duplicate}"
                                           AutomationProperties.Name="{l:Tr common.duplicate}" Click="OnDuplicate" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource SquareButton}" ToolTip="{l:Tr snippets.delete}"
                                           AutomationProperties.Name="{l:Tr snippets.delete}" Click="OnDelete">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource Kd.Danger}" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- The text, the box to try it, the programs and the notes: they fold, and stay as left from one text to the next -->
                    <ui:CardExpander x:Name="TextExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon TextDescription24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr snippets.text}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr snippets.text}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBox x:Name="BodyBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="140" MaxHeight="360" VerticalScrollBarVisibility="Auto" v:VariableHints.IsEnabled="True"
                                     AutomationProperties.Name="{l:Tr snippets.text}" />
                            <TextBlock Margin="2,8,0,0" Style="{StaticResource Caption}" Text="{l:Tr snippets.textHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Try it: the expander works here too (every text, whatever its programs) -->
                    <ui:CardExpander x:Name="TryExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Keyboard24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr snippets.try}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr snippets.try}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBox x:Name="TryBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{l:Tr snippets.try}" />
                            <TextBlock x:Name="TryHint" Margin="2,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Options (folded unless opened by hand, as in Comandos): the programs it works in -->
                    <ui:CardExpander x:Name="OptionsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Options24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.options}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.options}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{l:Tr snippets.apps}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{l:Tr snippets.appsHint}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Processes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                                <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0" Click="OnRemoveProcess" Tag="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox x:Name="ProcessBox" IsEditable="True" Width="240" v:Placeholder.Text="{l:Tr common.processPlaceholder}" DropDownOpened="OnProcessDropDown" DropDownClosed="OnProcessPicked" KeyDown="OnProcessKeyDown" />
                                <ui:Button Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddProcess" />
                                <ui:Button Margin="8,0,0,0" VerticalAlignment="Stretch" AutomationProperties.Name="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickProcess" ToolTip="{l:Tr picker.tooltip}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Notes (foldable, as in Comandos) -->
                    <ui:CardExpander x:Name="NotesExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Note24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.notes}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.notes}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 AutomationProperties.Name="{l:Tr commands.notes}" />
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
