<UserControl x:Class="KDesktop.Views.Pages.AssistantListSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <!-- Options → Assistant → Assistants: K-Desktop and the installed ones in compact rows (putting on the desktop, several
         at once, hiding, removing), adding; a row opens its card in place of the list (5.0.113: its word, key and model are
         in the card's «General») -->
    <Grid>
    <StackPanel x:Name="ListCard">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2" Text="{l:Tr assistantOptions.list}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr assistantOptions.listHint}" />
                </StackPanel>
                <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           Content="{l:Tr assistantOptions.add}" Click="OnAdd" />
            </Grid>

            <!-- One compact row each: a click opens its card (word, key, model, its settings, personality and voice) -->
            <ItemsControl x:Name="AssistantList" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Margin="0,0,0,6" Padding="12,9" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                                Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                MouseLeftButtonUp="OnRowClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Kd.ChipBackground}" VerticalAlignment="Center">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Bot24" FontSize="20" Foreground="{DynamicResource Kd.AccentText}"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Icon}" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Border Margin="10,0,0,0" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                                                Background="{DynamicResource Kd.AccentSoft}"
                                                Visibility="{Binding IsOnDesktop, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Kd.AccentText}" Text="{Binding OnDesktopText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" Text="{Binding Line}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button VerticalAlignment="Stretch" Content="{Binding PutText}" Icon="{ui:SymbolIcon Play24}" Click="OnActivate"
                                               Visibility="{Binding IsOffDesktop, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button VerticalAlignment="Stretch" Content="{Binding HideText}" Icon="{ui:SymbolIcon EyeOff24}" Click="OnHide"
                                               Visibility="{Binding IsOnDesktop, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button VerticalAlignment="Stretch" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Click="OnRemove"
                                               Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                               ToolTip="{l:Tr assistantOptions.remove}" AutomationProperties.Name="{l:Tr assistantOptions.remove}" />
                                    <ui:Button VerticalAlignment="Stretch" Margin="8,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon ChevronRight24}" Click="OnSettings"
                                               ToolTip="{l:Tr assistantOptions.settings}" AutomationProperties.Name="{Binding SettingsName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnDesktop}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nothing installed besides K-Desktop -->
            <StackPanel x:Name="EmptyPanel" Margin="0,14,0,12" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Kd.AccentSoft}" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Bot24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                </Border>
                <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:Tr assistantOptions.empty}" />
                <TextBlock Style="{StaticResource Caption}" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap" Text="{l:Tr assistantOptions.emptyHint}" />
            </StackPanel>

            <TextBlock x:Name="ModuleOffText" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"
                       Text="{l:Tr assistantCard.moduleOff}" />
        </StackPanel>
    </Border>

    </StackPanel>

    <a:AssistantSettingsView x:Name="SettingsView" Visibility="Collapsed" />
    </Grid>
</UserControl>
