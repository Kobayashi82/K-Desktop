<UserControl x:Class="KDesktop.Views.Pages.AssistantListSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <!-- Options → Assistant → Assistants: the installed ones, adding, putting on the desktop and removing; and the
         settings of each one, in place of the list -->
    <Grid>
    <Border x:Name="ListCard" Style="{StaticResource Card}">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2" Text="{l:Tr assistantOptions.list}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr assistantOptions.listHint}" />
                </StackPanel>
                <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           Content="{l:Tr assistantOptions.add}" Click="OnAdd" />
            </Grid>

            <!-- Nothing installed -->
            <StackPanel x:Name="EmptyPanel" Margin="0,28,0,20" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Kd.AccentSoft}" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Bot24" FontSize="32" Foreground="{DynamicResource Kd.AccentText}" />
                </Border>
                <TextBlock Margin="0,14,0,4" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:Tr assistantOptions.empty}" />
                <TextBlock Style="{StaticResource Caption}" MaxWidth="420" TextAlignment="Center" Text="{l:Tr assistantOptions.emptyHint}" />
            </StackPanel>

            <ItemsControl x:Name="AssistantList" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Margin="0,0,0,8" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Kd.ChipBackground}" VerticalAlignment="Top">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Bot24" FontSize="26" Foreground="{DynamicResource Kd.AccentText}"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Icon}" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Border Margin="10,0,0,0" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                                                Background="{DynamicResource Kd.AccentSoft}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Kd.AccentText}" Text="{l:Tr assistantOptions.onDesktop}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" Text="{Binding Byline}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,6,0,0" FontSize="13" Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="38"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Margin="0,0,8,0" Content="{l:Tr assistantOptions.settings}" Icon="{ui:SymbolIcon Options24}"
                                               Click="OnSettings" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Content="{l:Tr assistantOptions.putOnDesktop}" Icon="{ui:SymbolIcon Play24}" Click="OnActivate"
                                               Visibility="{Binding IsInactive, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Content="{l:Tr assistantOptions.hide}" Icon="{ui:SymbolIcon EyeOff24}" Click="OnHide"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Click="OnRemove"
                                               ToolTip="{l:Tr assistantOptions.remove}" AutomationProperties.Name="{l:Tr assistantOptions.remove}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ModuleOffText" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"
                       Text="{l:Tr assistantCard.moduleOff}" />
        </StackPanel>
    </Border>

    <a:AssistantSettingsView x:Name="SettingsView" Visibility="Collapsed" />
    </Grid>
</UserControl>
