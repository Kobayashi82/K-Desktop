<UserControl x:Class="KDesktop.Views.Pages.AchievementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:p="clr-namespace:KDesktop.Views.Pages"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <UserControl.Resources>
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />

        <!-- Segmented tabs -->
        <Style x:Key="SegmentTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="6" Padding="16,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chips -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="14" Padding="12,4" BorderThickness="1"
                                Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter TextElement.FontSize="12" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Achievement card -->
        <DataTemplate x:Key="AchievementCard" DataType="{x:Type p:AchievementItem}">
            <Border x:Name="Frame" Height="104" Margin="0,0,10,10" CornerRadius="10" Padding="14,12" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="46" Height="46" VerticalAlignment="Top">
                        <Ellipse x:Name="Disc" Fill="{DynamicResource Kd.Locked}" />
                        <Ellipse x:Name="Gold" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF6D365" Offset="0" />
                                    <GradientStop Color="#FFE0A815" Offset="0.55" />
                                    <GradientStop Color="#FFB7790B" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Symbol}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <!-- Footer: date, progress or "locked" -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Grid x:Name="ProgressBar" Height="4" Margin="0,0,0,4" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToCollapsed}}">
                                <Border CornerRadius="2" Background="{DynamicResource Kd.BarTrack}" />
                                <Border CornerRadius="2" Background="{DynamicResource Kd.Bar}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Fraction}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="Footer" Text="{Binding Footer}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Unlocked}" Value="True">
                    <Setter TargetName="Gold" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Foreground" Value="#FF3A2600" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter TargetName="Footer" Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kd.ToastBorder}" />
                </DataTrigger>
                <Trigger SourceName="Frame" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,24,14">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.achievements}" />
                <TextBlock x:Name="SinceText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <ui:Button Margin="0,0,10,0" Icon="{ui:SymbolIcon ArrowReset24}" ToolTip="{l:Tr ach.reset}" AutomationProperties.Name="{l:Tr ach.reset}"
                       VerticalAlignment="Center" Click="OnReset" />
            <Border VerticalAlignment="Center" CornerRadius="8" Padding="3" Background="{DynamicResource Kd.Subtle}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabAchievements" Style="{StaticResource SegmentTab}" GroupName="AchTabs" IsChecked="True" Checked="OnTab">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr ach.tabAchievements}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabStats" Style="{StaticResource SegmentTab}" GroupName="AchTabs" Checked="OnTab">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataHistogram24" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Tr ach.tabStats}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>

        <!-- ── Achievements ─────────────────────────────────────────── -->
        <ScrollViewer x:Name="AchievementsView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,24,24">
            <StackPanel>
                <!-- Summary -->
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="64" Height="64">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFF6D365" Offset="0" />
                                        <GradientStop Color="#FFE0A815" Offset="0.55" />
                                        <GradientStop Color="#FFB7790B" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="30" Foreground="#FF3A2600" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UnlockedText" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TotalText" FontSize="16" Margin="6,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PercentText" FontSize="16" FontWeight="SemiBold" Margin="14,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource Kd.AccentText}" />
                            </StackPanel>
                            <Grid Height="8" Margin="0,8,0,6">
                                <Border CornerRadius="4" Background="{DynamicResource Kd.BarTrack}" />
                                <Border CornerRadius="4" Background="{DynamicResource Kd.Bar}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="TotalBar" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="LastText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ui:ToggleSwitch x:Name="NotifyToggle" Content="{l:Tr ach.notifications}" Margin="0,0,0,10" Click="OnNotifyToggle" />
                            <ui:ToggleSwitch x:Name="SoundToggle" Content="{l:Tr ach.sound}" Click="OnSoundToggle" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filters -->
                <Grid Margin="0,4,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChip}" GroupName="AchFilter" IsChecked="True" Content="{l:Tr ach.filterAll}" Checked="OnFilter" />
                        <RadioButton x:Name="FilterUnlocked" Style="{StaticResource FilterChip}" GroupName="AchFilter" Content="{l:Tr ach.filterUnlocked}" Checked="OnFilter" />
                        <RadioButton x:Name="FilterLocked" Style="{StaticResource FilterChip}" GroupName="AchFilter" Content="{l:Tr ach.filterLocked}" Checked="OnFilter" />
                        <RadioButton x:Name="FilterNear" Style="{StaticResource FilterChip}" GroupName="AchFilter" Content="{l:Tr ach.filterNear}" Checked="OnFilter"
                                     ToolTip="{l:Tr ach.filterNearHint}" />
                    </WrapPanel>
                    <ui:TextBox x:Name="SearchBox" Grid.Column="1" Width="260" PlaceholderText="{l:Tr ach.search}" Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True" TextChanged="OnSearch" />
                </Grid>

                <!-- Groups (built in code) -->
                <StackPanel x:Name="Groups" SizeChanged="OnGroupsSizeChanged" />
                <TextBlock x:Name="NoResults" Style="{StaticResource Caption}" Text="{l:Tr ach.noResults}" Visibility="Collapsed" Margin="0,8" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── Statistics ───────────────────────────────────────────── -->
        <ScrollViewer x:Name="StatsView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,24,24" Visibility="Collapsed">
            <StackPanel>
                <!-- Headline numbers -->
                <UniformGrid x:Name="Tiles" Columns="4" Margin="0,0,-12,0" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr stats.topCommands}" />
                            <StackPanel x:Name="TopCommands" />
                            <TextBlock x:Name="TopEmpty" Style="{StaticResource Caption}" Text="{l:Tr stats.noData}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr stats.sources}" />
                            <StackPanel x:Name="Sources" />
                            <TextBlock x:Name="SourcesEmpty" Style="{StaticResource Caption}" Text="{l:Tr stats.noData}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Every counter -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr stats.all}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="CountersLeft" />
                            <StackPanel x:Name="CountersRight" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
