<UserControl x:Class="KDesktop.Views.Pages.EventsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:p="clr-namespace:KDesktop.Views.Pages"
             xmlns:s="clr-namespace:KDesktop.Services"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <ResourceDictionary>
            <v:EventIconConverter x:Key="EventIcon" />
            <v:EventCommandConverter x:Key="EventCommand" />
            <v:NotInListConverter x:Key="NotInList" />
            <v:LastFiredConverter x:Key="LastFired" />
            <v:InvalidTimeConverter x:Key="InvalidTime" />
            <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
            <v:NullToCollapsedConverter x:Key="NullToCollapsed" />

            <Style x:Key="EdRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="EdCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,24,6" />
            </Style>

            <!-- A list of processes (chips) with the box to add more and «Elegir ventana» -->
            <DataTemplate x:Key="ProcessList">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Processes}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                        <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0"
                                                   Command="{x:Static p:EventsPage.RemoveProcess}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                        </ui:Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <ComboBox Width="240" IsEditable="True" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                                  DropDownOpened="OnProcessDropDown" DropDownClosed="OnProcessPicked" KeyDown="OnProcessKeyDown" />
                        <ui:Button Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddProcess" />
                        <ui:Button Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickProcess" ToolTip="{l:Tr picker.tooltip}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!-- ── «Cuándo»: one editor per type ─────────────────────────── -->
            <DataTemplate DataType="{x:Type m:AppStartTrigger}">
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.appStart}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:AppExitTrigger}">
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.appExit}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:TimeTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.time}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <v:TimeField Time="{Binding Time, Mode=TwoWay}" AutomationProperties.Name="{l:Tr event.time}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Foreground="{DynamicResource Kd.Danger}"
                                   Text="{l:Tr event.timeInvalid}" Visibility="{Binding Time, Converter={StaticResource InvalidTime}, ConverterParameter=required}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="{l:Tr event.date}" />
                    <v:DateField Date="{Binding DateValue, Mode=TwoWay}" AutomationProperties.Name="{l:Tr event.date}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:Tr event.dateHint}" />
                    <StackPanel x:Name="DaysPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="{l:Tr event.days}" />
                        <v:WeekDaysPicker Days="{Binding Days}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:Tr event.daysHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource EdCheck}" Margin="0,10,24,6" Content="{l:Tr event.runIfMissed}" IsChecked="{Binding RunIfMissed}" ToolTip="{l:Tr event.runIfMissedHint}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasDate}" Value="True">
                        <Setter TargetName="DaysPanel" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:IntervalTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.everyMinutes}" />
                    <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.interval}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:ProcessStartTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.programs}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessList}" Focusable="False" />
                    <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr event.includeRunning}" IsChecked="{Binding IncludeRunningAtStart}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.processStart}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:ForegroundTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.programs}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessList}" Focusable="False" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.foreground}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:IdleTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.idleMinutes}" />
                    <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.idle}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:SessionTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.sessionWhen}" />
                    <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{x:Static v:Lookups.SessionEvents}" DisplayMemberPath="Name"
                              SelectedValuePath="Value" SelectedValue="{Binding Event}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.session}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:PowerSourceTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.sessionWhen}" />
                    <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{x:Static v:Lookups.PowerSources}" DisplayMemberPath="Name"
                              SelectedValuePath="Value" SelectedValue="{Binding Source}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.power}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:FileTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.folder}" />
                    <Grid Style="{StaticResource EdRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\ComfyUI\output" Icon="{ui:SymbolIcon Folder24}" />
                        <ui:Button VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr editor.browse}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseFolder" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.fileFilter}" />
                    <ui:TextBox Width="200" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="*.png" />
                    <CheckBox Style="{StaticResource EdCheck}" Content="{l:Tr event.subfolders}" IsChecked="{Binding Subfolders}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.file}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:DriveTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.drive}" />
                    <ui:TextBox Width="280" HorizontalAlignment="Left" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr event.drivePlaceholder}"
                                Icon="{ui:SymbolIcon UsbStick24}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.drive}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:NetworkTrigger}">
                <StackPanel>
                    <Grid Style="{StaticResource EdRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.sessionWhen}" />
                            <ComboBox ItemsSource="{x:Static v:Lookups.NetworkStates}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding State}" />
                        </StackPanel>
                        <StackPanel x:Name="NamePanel" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.networkName}" />
                            <ComboBox IsEditable="True" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                                      ItemsSource="{Binding Source={x:Static v:Lookups.ConnectedNetworksNow}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.network}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Offline">
                        <Setter TargetName="NamePanel" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:AudioDeviceTrigger}">
                <StackPanel>
                    <Grid Style="{StaticResource EdRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.sessionWhen}" />
                            <ComboBox ItemsSource="{x:Static v:Lookups.AudioDeviceEvents}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Event}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.audioDevice}" />
                            <ComboBox IsEditable="True" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr event.networkPlaceholder}"
                                      ItemsSource="{Binding Source={x:Static v:Lookups.AudioDeviceNames}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.audio}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:RemoteCallTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.callName}" />
                    <ui:TextBox Width="280" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr event.callPlaceholder}"
                                Icon="{ui:SymbolIcon PlugConnected24}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.remoteCall}" />
                    <TextBox Margin="0,8,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{l:Tr event.hint.remoteCallExamples}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:GadgetTrigger}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.audioDevice}" />
                    <ComboBox Width="360" HorizontalAlignment="Left" IsEditable="True" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                              v:Placeholder.Text="{l:Tr event.networkPlaceholder}" ItemsSource="{Binding Source={x:Static v:Lookups.GadgetNames}}" MaxDropDownHeight="420" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.hint.gadget}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type m:LoadTrigger}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.loadResource}" />
                            <ComboBox Width="190" ItemsSource="{x:Static v:Lookups.LoadResources}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedValue="{Binding Resource}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.loadComparison}" />
                            <ComboBox Width="170" ItemsSource="{x:Static v:Lookups.LoadComparisons}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedValue="{Binding Comparison}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="%" />
                            <ui:TextBox Width="90" Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.loadSeconds}" />
                            <ui:TextBox Width="110" Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.hint.load}" />
                </StackPanel>
            </DataTemplate>

            <!-- A command of «Ejecutar» / «Al terminar» -->
            <!-- A command of «Ejecutar» / «Al terminar», like an action of a command: ticked or not (unticked, it stays but is
                 skipped), run it now, go to it, move it and take it out of the list (the X: the command itself stays) -->
            <DataTemplate x:Key="CommandRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Drag grip, visible on hover -->
                    <Border x:Name="Grip" Margin="-12,-10,0,-10" Width="22" HorizontalAlignment="Left" Background="Transparent"
                            Opacity="0" Cursor="SizeNS" v:DragReorder.IsHandle="True" ToolTip="{l:Tr macro.dragHint}">
                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Border>
                    <Border x:Name="IconBox" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}" Margin="10,0,12,0">
                        <Image Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Converter={StaticResource EventCommand}, ConverterParameter=icon}" />
                    </Border>
                    <StackPanel x:Name="Texts" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding Converter={StaticResource EventCommand}, ConverterParameter=name}" />
                        <TextBlock x:Name="Summary" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Converter={StaticResource EventCommand}, ConverterParameter=summary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="Check" ToolTip="{l:Tr common.enabled}" AutomationProperties.Name="{l:Tr common.enabled}" Margin="0,0,4,0" MinWidth="0"
                                  Checked="OnCommandTicked" Unchecked="OnCommandTicked">
                            <CheckBox.IsChecked>
                                <MultiBinding Converter="{StaticResource NotInList}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="Tag.Count" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                </MultiBinding>
                            </CheckBox.IsChecked>
                        </CheckBox>
                        <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr commands.run}" AutomationProperties.Name="{l:Tr commands.run}"
                                   Command="{x:Static p:EventsPage.RunCommand}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                        </ui:Button>
                        <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr event.openCommand}" AutomationProperties.Name="{l:Tr event.openCommand}"
                                   Command="{x:Static p:EventsPage.OpenCommand}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                        </ui:Button>
                        <ui:Button Style="{StaticResource MoveButton}" ToolTip="{l:Tr common.moveUp}" AutomationProperties.Name="{l:Tr common.moveUp}"
                                   Command="{x:Static p:EventsPage.MoveCommandUp}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
                        </ui:Button>
                        <ui:Button Style="{StaticResource MoveButton}" ToolTip="{l:Tr common.moveDown}" AutomationProperties.Name="{l:Tr common.moveDown}"
                                   Command="{x:Static p:EventsPage.MoveCommandDown}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" />
                        </ui:Button>
                        <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}" AutomationProperties.Name="{l:Tr common.remove}"
                                   Command="{x:Static p:EventsPage.RemoveCommand}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource Kd.Danger}" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, ElementName=Check}" Value="False">
                        <Setter TargetName="IconBox" Property="Opacity" Value="0.5" />
                        <Setter TargetName="Texts" Property="Opacity" Value="0.5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Text, ElementName=Summary}" Value="">
                        <Setter TargetName="Summary" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="Grip" Property="Opacity" Value="0.8" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Framed like the action rows of Comandos -->
            <Style x:Key="CommandItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Frame" CornerRadius="8" Padding="12,10" BorderThickness="1"
                                    Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static p:EventsPage.RemoveProcess}" Executed="OnRemoveProcess" />
        <CommandBinding Command="{x:Static p:EventsPage.RemoveCommand}" Executed="OnRemoveCommand" />
        <CommandBinding Command="{x:Static p:EventsPage.OpenCommand}" Executed="OnOpenCommand" />
        <CommandBinding Command="{x:Static p:EventsPage.RunCommand}" Executed="OnRunCommand" />
        <CommandBinding Command="{x:Static p:EventsPage.MoveCommandUp}" Executed="OnMoveCommand" CanExecute="OnCanMoveCommand" />
        <CommandBinding Command="{x:Static p:EventsPage.MoveCommandDown}" Executed="OnMoveCommand" CanExecute="OnCanMoveCommand" />
    </UserControl.CommandBindings>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Event list ────────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.events}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr event.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <ui:Button Margin="0,0,0,10" Content="{l:Tr event.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNewEvent" HorizontalAlignment="Stretch" />
            </StackPanel>

            <ListBox x:Name="EventList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}"
                     SelectionChanged="OnEventSelected" PreviewMouseRightButtonUp="OnEventRightClick" KeyDown="OnEventListKey"
                     v:DragReorder.IsEnabled="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:EventRule}">
                        <Grid x:Name="Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource EventIcon}">
                                        <Binding />
                                        <Binding Path="(s:IconProvider.Revision)" />
                                        <Binding Path="Icon" />
                                        <Binding Path="Trigger" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,1,0,0" Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <ui:SymbolIcon Symbol="History24" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource Kd.AccentText}" />
                                    <TextBlock Text="{Binding LastFired, Converter={StaticResource LastFired}}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Kd.AccentText}" ToolTip="{l:Tr event.lastFired}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" IsChecked="{Binding Enabled}" ToolTip="{l:Tr event.enabledHint}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.75" MaxWidth="440">
                <ui:SymbolIcon Symbol="ArrowForwardDownLightning24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr event.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr event.emptyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,24,24">
                <StackPanel x:Name="Editor">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="EditorShift" />
                    </StackPanel.RenderTransform>

                    <!-- Header -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="IconButton" Width="60" Height="60" Padding="8" Cursor="Hand" Click="OnChooseIcon" ToolTip="{l:Tr commands.changeIcon}"
                                    AutomationProperties.Name="{l:Tr commands.changeIcon}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" CornerRadius="10" Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:Tr commands.changeIcon}" Click="OnChooseIcon" />
                                        <MenuItem Header="{l:Tr commands.resetIcon}" Click="OnResetIcon" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Image x:Name="HeaderIcon" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <!-- Name and buttons; when the window is narrow the buttons go under the name -->
                            <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" v:ResponsiveHeader.MinNameWidth="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBox x:Name="NameBox" ClearButtonEnabled="False" FontSize="16" FontWeight="SemiBold" PlaceholderText="{l:Tr event.namePlaceholder}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            GotKeyboardFocus="OnNameFocus" LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" v:ResponsiveHeader.IsSide="True">
                                    <ui:ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{l:Tr common.enabled}" OffContent="{l:Tr common.disabled}" Margin="0,0,16,0" />
                                    <ui:Button MinHeight="34" Content="{l:Tr event.test}" Icon="{ui:SymbolIcon Play24}" Click="OnTestEvent" Margin="0,0,8,0"
                                               ToolTip="{l:Tr event.testHint}" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon FlashAdd20, FontSize=18}" ToolTip="{l:Tr event.createCommand}" AutomationProperties.Name="{l:Tr event.createCommand}"
                                               Click="OnCreateCommand" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Copy24, FontSize=18}" ToolTip="{l:Tr common.duplicate}" AutomationProperties.Name="{l:Tr common.duplicate}" Click="OnDuplicateEvent" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Delete24, FontSize=18}" ToolTip="{l:Tr common.delete}" AutomationProperties.Name="{l:Tr common.delete}" Click="OnDeleteEvent" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr event.lastFired}" />
                                        <TextBlock Style="{StaticResource Caption}" Text=": " />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastFired, Converter={StaticResource LastFired}}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SuspendedHint" Margin="2,4,0,0" Style="{StaticResource Caption}" Foreground="{DynamicResource Kd.Warning}"
                                               Text="{l:Tr event.suspended}" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- When (folds; open unless folded by hand) -->
                    <ui:CardExpander x:Name="WhenExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon CalendarClock24}" IsExpanded="True"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr event.when}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{l:Tr event.when}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="WhenSummary" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <ComboBox x:Name="KindBox" Margin="0,0,0,8" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320"
                                      ItemsSource="{x:Static v:Lookups.EventKinds}" SelectionChanged="OnKindChanged" MaxDropDownHeight="520"
                                      v:ComboHover.NoScroll="True">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:EventKindInfo}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource Kd.AccentText}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="KindDescription" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <ContentControl Content="{Binding Trigger}" Focusable="False" />
                            <CheckBox Margin="0,12,0,0" Content="{l:Tr event.once}" IsChecked="{Binding Once}" ToolTip="{l:Tr event.onceHint}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="28,0,0,0" TextWrapping="Wrap" Text="{l:Tr event.onceHint}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Run (foldable; its buttons stay on the header) -->
                    <ui:CardExpander x:Name="RunExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Play24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr event.run}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr event.run}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="8,0,8,0">
                                    <ui:Button Appearance="Primary" MinHeight="36" Content="{l:Tr event.newCommand}" Icon="{ui:SymbolIcon DocumentAdd24}" ToolTip="{l:Tr event.newCommandHint}" Click="OnNewCommand" />
                                    <ui:Button Appearance="Primary" MinHeight="36" Margin="8,0,0,0" Content="{l:Tr event.addCommand}" Icon="{ui:SymbolIcon Add24}" Click="OnAddCommand" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock x:Name="NoCommands" Style="{StaticResource Caption}" Margin="0,0,0,6" Text="{l:Tr event.noCommands}" />
                            <ListBox x:Name="CommandsList" ItemsSource="{Binding Commands}" Tag="{Binding DisabledCommands}" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CommandItem}" ItemTemplate="{StaticResource CommandRow}"
                                     v:DragReorder.IsEnabled="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnInnerListWheel" />
                            <TextBlock x:Name="ExitNote" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.exitNote}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Ask an assistant (foldable like «Ejecutar») -->
                    <ui:CardExpander x:Name="AskCard" Margin="0,0,0,12" Icon="{ui:SymbolIcon Chat24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr event.ask}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr event.ask}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="8,0,8,0">
                                    <ui:Button x:Name="AddAskButton" Appearance="Primary" MinHeight="36" Content="{l:Tr event.askAdd}" Icon="{ui:SymbolIcon ChatAdd24}" Click="OnAddAsk" />
                                    <ui:Button x:Name="RemoveAskButton" Style="{StaticResource IconButton}" ToolTip="{l:Tr common.remove}"
                                               AutomationProperties.Name="{l:Tr common.remove}" Click="OnRemoveAsk">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource Kd.Danger}" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock x:Name="NoAsk" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{l:Tr event.askNone}" />
                            <Border x:Name="ScheduledInfo" Margin="0,0,0,10" Padding="10,8" CornerRadius="6" Background="{DynamicResource Kd.AccentSoft}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CalendarClock24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                                    <TextBlock x:Name="ScheduledText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" MaxWidth="640" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="AskEditor" DataContext="{Binding Ask}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAskWho}" />
                                <ComboBox Margin="0,0,0,12" MinWidth="240" HorizontalAlignment="Left" ItemsSource="{Binding Source={x:Static v:Lookups.AssistantList}}"
                                          SelectedValuePath="Id" SelectedValue="{Binding Assistant}" AutomationProperties.Name="{l:Tr editor.assistantAskWho}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type v:AssistantChoice}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.assistantAskText}" />
                                <ui:TextBox Margin="0,0,0,8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr event.askTextHint}"
                                            AutomationProperties.Name="{l:Tr editor.assistantAskText}" MaxLength="500" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.askHint}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- When it ends (foldable like «Ejecutar») -->
                    <ui:CardExpander x:Name="EndCard" Margin="0,0,0,12" Icon="{ui:SymbolIcon RecordStop24}" HorizontalContentAlignment="Stretch"
                                     Visibility="{Binding HasEnd, Converter={StaticResource BoolToCollapsed}}"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr event.end}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:Tr event.end}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="8,0,8,0">
                                    <ui:Button Appearance="Primary" MinHeight="36" Content="{l:Tr event.newCommand}" Icon="{ui:SymbolIcon DocumentAdd24}" ToolTip="{l:Tr event.newCommandHint}" Click="OnNewEndCommand" />
                                    <ui:Button Appearance="Primary" MinHeight="36" Margin="8,0,0,0" Content="{l:Tr event.addCommand}" Icon="{ui:SymbolIcon Add24}" Click="OnAddEndCommand" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock x:Name="EndHint" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <ListBox x:Name="EndCommandsList" ItemsSource="{Binding EndCommands}" Tag="{Binding DisabledEndCommands}" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CommandItem}" ItemTemplate="{StaticResource CommandRow}"
                                     v:DragReorder.IsEnabled="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnInnerListWheel" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Only if (open when it has something) -->
                    <ui:CardExpander x:Name="ConditionsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Filter24}" AutomationProperties.Name="{l:Tr event.conditions}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{l:Tr event.conditions}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border x:Name="ConditionsBadge" Margin="10,0,0,0" Padding="7,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" Text="{l:Tr event.conditionsOn}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr event.conditionsHint}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                            <StackPanel DataContext="{Binding Conditions}">
                                <Grid Style="{StaticResource EdRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.from}" />
                                        <v:TimeField Time="{Binding TimeFrom, Mode=TwoWay}" Optional="True" AutomationProperties.Name="{l:Tr event.from}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.to}" />
                                        <v:TimeField Time="{Binding TimeTo, Mode=TwoWay}" Optional="True" AutomationProperties.Name="{l:Tr event.to}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Kd.Danger}" Text="{l:Tr event.timeInvalid}"
                                                   Visibility="{Binding TimeFrom, Converter={StaticResource InvalidTime}}" />
                                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Kd.Danger}" Text="{l:Tr event.timeInvalid}"
                                                   Visibility="{Binding TimeTo, Converter={StaticResource InvalidTime}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.days}" />
                                <v:WeekDaysPicker Days="{Binding Days}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" Text="{l:Tr event.daysHint}" />
                                <Grid Style="{StaticResource EdRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.ifRunning}" />
                                        <ComboBox IsEditable="True" Text="{Binding ProcessRunning, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                                                  ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.ifNotRunning}" />
                                        <ComboBox IsEditable="True" Text="{Binding ProcessNotRunning, UpdateSourceTrigger=PropertyChanged}" v:Placeholder.Text="{l:Tr common.processPlaceholder}"
                                                  ItemsSource="{Binding Source={x:Static v:Lookups.RunningProcessesNow}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                    </ui:CardExpander>

                    <!-- Options (folded unless opened by hand) -->
                    <ui:CardExpander x:Name="OptionsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Options24}"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr event.options}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{l:Tr event.options}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr event.optionsHint}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr event.cooldown}" />
                            <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Tr event.cooldownHint}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Notes (foldable, as in Comandos) -->
                    <ui:CardExpander x:Name="NotesExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Note24}"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.notes}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.notes}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 AutomationProperties.Name="{l:Tr commands.notes}" />
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
