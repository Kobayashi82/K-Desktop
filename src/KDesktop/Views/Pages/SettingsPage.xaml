<UserControl x:Class="KDesktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:local="clr-namespace:KDesktop.Views.Pages"
             xmlns:assistant="clr-namespace:KDesktop.Views.Assistant"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <!-- A tile to click (size, kinds of messages): what it holds is drawn in its colour, gold when chosen -->
        <Style x:Key="OsdTile" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Kd.OsdTrack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Kd.OsdTrack}" Background="{DynamicResource Kd.Subtle}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Kd.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A tile of a choice of three or four (formats, shapes, sizes…): a drawing or a word, and its name below -->
        <Style x:Key="PickTile" TargetType="RadioButton" BasedOn="{StaticResource OsdTile}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="4,8,4,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TileBig" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <!-- A row of the lupa that only the lens has (full screen has no lens) -->
        <Style x:Key="LensOnlyRow" TargetType="Grid" BasedOn="{StaticResource SettingRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ZoomMode}" Value="{x:Static m:ZoomMode.FullScreen}">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Grey text in a (non-editable) combo while nothing is chosen; its DataContext is the combo -->
        <Style x:Key="ComboHint" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="11,0,34,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderColorBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Removable process chip; Tag of the button = the list it belongs to -->
        <DataTemplate x:Key="ProcessChip">
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                    <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0" Click="OnRemoveChip"
                               Tag="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <!-- Parts shown for one choice of «Pon música» / «Quita la música» (Tag = the MusicHandler they belong to) -->
        <Style x:Key="MusicOnPart" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding VoiceMusicOn}" Value="{x:Static m:MusicHandler.Command}" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Command" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding VoiceMusicOn}" Value="{x:Static m:MusicHandler.Program}" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Program" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MusicOffPart" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding VoiceMusicOff}" Value="{x:Static m:MusicHandler.Command}" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Command" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding VoiceMusicOff}" Value="{x:Static m:MusicHandler.Program}" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Program" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The tree of sections: no chrome of its own, it scrolls -->
        <Style x:Key="NavTree" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <ScrollViewer x:Name="Scroller" Focusable="False" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,4,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                        <ControlTemplate.Triggers>
                            <!-- The scroll bar floats over the content: the rows make room for it instead of going under it -->
                            <Trigger SourceName="Scroller" Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                                <Setter TargetName="Scroller" Property="Padding" Value="0,0,18,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row of the tree: hover, the section shown (pill, like the other lists), the keyboard ring, and its rows
             inside, which appear sliding down and go fading -->
        <Style x:Key="NavItem" TargetType="v:NavItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="v:NavItem">
                        <StackPanel>
                            <Grid x:Name="Row" Background="Transparent" Margin="0,1" Cursor="Hand">
                                <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource Kd.SubtleHover}" Opacity="0" />
                                <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource Kd.Selected}" Opacity="0" />
                                <Border x:Name="Ring" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource Kd.Accent}" Opacity="0" />
                                <Border x:Name="Pill" Width="3" Height="20" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource Kd.Accent}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PillScale" ScaleY="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <ContentPresenter ContentSource="Header" Margin="10,6,8,6" />
                            </Grid>
                            <ItemsPresenter x:Name="Items" Visibility="Collapsed" Opacity="0">
                                <ItemsPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ItemsShift" />
                                </ItemsPresenter.RenderTransform>
                            </ItemsPresenter>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsCurrent" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource KdEaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="ShowFocus" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Items" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Items" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="ItemsShift" Storyboard.TargetProperty="Y" From="-8" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource KdEaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Items" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Items" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,0,0" PreviewKeyDown="OnPageKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sections: groups that fold, their sections and the assistants inside «Asistentes» (SettingsPage.Nav.cs) ── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{l:Tr nav.settings}" Margin="0,0,0,12" />
            <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,4,10" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        PlaceholderText="{l:Tr settings.nav.search}" AutomationProperties.Name="{l:Tr settings.nav.search}"
                        TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
            <TextBlock x:Name="NoResults" DockPanel.Dock="Top" Margin="4,4,4,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{l:Tr settings.nav.noResults}" />
            <TreeView x:Name="NavTree" Style="{StaticResource NavTree}" AutomationProperties.Name="{l:Tr nav.settings}"
                      PreviewMouseLeftButtonDown="OnNavMouseDown" PreviewKeyDown="OnNavKeyDown" />
        </DockPanel>

        <!-- ── The chosen section ────────────────────────────────────── -->
        <!-- Every section takes the window's width up to 980 (a left-aligned panel would shrink to each section's content) -->
        <ScrollViewer x:Name="SectionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,24,24">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="980" /></Grid.ColumnDefinitions>
        <StackPanel x:Name="Sections">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="SectionShift" />
            </StackPanel.RenderTransform>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Tag="appearance">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.appearance}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.theme}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.themeHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.Themes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.language}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.languageHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="1" Margin="6,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="{l:Tr settings.languagesReload}"
                                       AutomationProperties.Name="{l:Tr settings.languagesReload}" Click="OnReloadLanguages" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.favicons}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.faviconsHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding WebFavicons}" />
                            <!-- Same size and right edge as the language reload button above -->
                            <ui:Button Margin="12,0,0,0" VerticalAlignment="Center" Height="{Binding ActualHeight, ElementName=LanguageBox}"
                                       Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="{l:Tr settings.faviconsRefresh}"
                                       AutomationProperties.Name="{l:Tr settings.faviconsRefresh}" Click="OnRefreshFavicons"
                                       IsEnabled="{Binding WebFavicons}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance: translating K-Desktop -->
            <Border Style="{StaticResource Card}" Tag="appearance">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.translate}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.translateHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button MinHeight="36" Grid.Column="1" HorizontalAlignment="Stretch" Content="{l:Tr settings.exportTemplate}" Icon="{ui:SymbolIcon Translate24}" Click="OnExportLanguageTemplate" />
                    </Grid>
                    <!-- Where the languages live and how a translation works -->
                    <Border Style="{StaticResource InfoBox}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LanguagesInfoText" Style="{StaticResource Caption}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr settings.languagesSteps}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr settings.languagesOverride}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- General: pause -->
            <Border Style="{StaticResource Card}" Tag="general">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.pauseTitle}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.pause}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.pauseHint}" />
                        </StackPanel>
                        <!-- One-way: the switch goes through App.SetPaused (hotkey index, OSD, tray…) -->
                        <ui:ToggleSwitch x:Name="PauseToggle" Grid.Column="1" IsChecked="{Binding Paused, Mode=OneWay}" Click="OnPauseToggle" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.pauseHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.pauseHotkeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button MinHeight="36" x:Name="PauseHotkeyButton" VerticalAlignment="Stretch" MinWidth="192" Click="OnCapturePauseHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="PauseHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearPauseHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding PauseBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                            <v:IconToggle Width="38" Height="36" IsChecked="{Binding PauseIgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24"
                                          Title="{l:Tr commands.ignoreDisabled}" Hint="{l:Tr commands.ignoreDisabledHint}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.pauseSound}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.pauseSoundHint}" />
                        </StackPanel>
                        <v:SoundPicker Grid.Column="1" Sound="{Binding PauseSound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.resumeSound}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.resumeSoundHint}" />
                        </StackPanel>
                        <v:SoundPicker Grid.Column="1" Sound="{Binding ResumeSound}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General -->
            <Border Style="{StaticResource Card}" Tag="general">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.general}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.startWithWindows}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.startWithWindowsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Click="OnStartupToggle" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.showWindowOnStart}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.showWindowOnStartHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowWindowOnStart}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.trayIcon}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.trayIconHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTrayIcon}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.trayImage}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.trayImageHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Margin="0,0,12,0" CornerRadius="6" Background="{DynamicResource Kd.Subtle}">
                                <Image x:Name="TrayImagePreview" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <ui:Button MinHeight="36" x:Name="TrayImageChange" Margin="0,0,8,0" VerticalAlignment="Stretch" Content="{l:Tr settings.trayImageChange}" Icon="{ui:SymbolIcon Image24}" Click="OnChangeTrayImage" />
                            <ui:Button MinHeight="36" x:Name="TrayImageReset" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowReset24}" ToolTip="{l:Tr settings.trayImageReset}"
                                       AutomationProperties.Name="{l:Tr settings.trayImageReset}" Click="OnResetTrayImage" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General: hotkeys and sounds -->
            <Border Style="{StaticResource Card}" Tag="general">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.hotkeysSounds}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.showHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.showHotkeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button MinHeight="36" x:Name="ShowHotkeyButton" VerticalAlignment="Stretch" MinWidth="192" Click="OnCaptureShowHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="ShowHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearShowHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding ShowWindowBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                            <v:IconToggle Width="38" Height="36" IsChecked="{Binding ShowWindowIgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24"
                                          Title="{l:Tr commands.ignoreDisabled}" Hint="{l:Tr commands.ignoreDisabledHint}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.exitHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.exitHotkeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button MinHeight="36" x:Name="ExitHotkeyButton" VerticalAlignment="Stretch" MinWidth="192" Click="OnCaptureExitHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="ExitHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearExitHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding ExitBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                            <v:IconToggle Width="38" Height="36" IsChecked="{Binding ExitIgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24"
                                          Title="{l:Tr commands.ignoreDisabled}" Hint="{l:Tr commands.ignoreDisabledHint}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.startupSound}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.startupSoundHint}" />
                        </StackPanel>
                        <v:SoundPicker Grid.Column="1" Sound="{Binding StartupSound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.exitSound}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.exitSoundHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <v:SoundPicker Grid.Column="1" Sound="{Binding ExitSound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.startupMessage}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.startupMessageHint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Text="{Binding StartupMessage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PlaceholderText="{l:Tr settings.startupMessageNone}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OSD -->
            <Border Style="{StaticResource Card}" Tag="osd" MinWidth="560">
                <StackPanel>
                    <StackPanel.Resources>
                        <!-- A spot of the little screen: a pill where the OSD would show -->
                        <Style x:Key="OsdSpot" TargetType="RadioButton">
                            <Setter Property="GroupName" Value="OsdSpot" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="6,5" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border Background="Transparent" Padding="2">
                                            <Border x:Name="Spot" Width="34" Height="10" CornerRadius="5" Background="{DynamicResource Kd.OsdTrack}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Spot" Property="Background" Value="{DynamicResource Kd.AccentText}" />
                                                <Setter TargetName="Spot" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Spot" Property="Background" Value="{DynamicResource Kd.Accent}" />
                                                <Setter TargetName="Spot" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.osd}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.osdPosition}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.osdPositionHint}" />
                        </StackPanel>
                        <!-- The screen, with a stand: each spot is a place for the OSD -->
                        <StackPanel Grid.Column="1" Margin="0,4,0,4">
                            <Border x:Name="OsdScreen" Width="168" Height="104" CornerRadius="8" BorderThickness="2" Padding="4"
                                    BorderBrush="{DynamicResource Kd.OsdTrack}" Background="{DynamicResource Kd.Subtle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="TopLeft" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="OnOsdSpot" />
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="TopCenter" Grid.Column="1" VerticalAlignment="Top" Checked="OnOsdSpot" />
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="TopRight" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Checked="OnOsdSpot" />
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="Center" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Checked="OnOsdSpot" />
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="BottomLeft" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Checked="OnOsdSpot" />
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="BottomCenter" Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Checked="OnOsdSpot" />
                                    <RadioButton Style="{StaticResource OsdSpot}" Tag="BottomRight" Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Checked="OnOsdSpot" />
                                </Grid>
                            </Border>
                            <Border Width="44" Height="8" Background="{DynamicResource Kd.OsdTrack}" />
                            <Border Width="72" Height="4" CornerRadius="2" Background="{DynamicResource Kd.OsdTrack}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdScreen}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.ScreenChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding OsdScreen}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdSize}" />
                        <!-- Three tiles, each with a message of its size -->
                        <UniformGrid x:Name="OsdSizePicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <UniformGrid.Resources>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource OsdTile}">
                                    <Setter Property="GroupName" Value="OsdSize" />
                                    <Setter Property="Height" Value="60" />
                                    <Setter Property="Padding" Value="4,8,4,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                                <Style x:Key="OsdSizeLabel" TargetType="TextBlock">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Style>
                            </UniformGrid.Resources>
                            <RadioButton Tag="Small" Checked="OnOsdSize" AutomationProperties.Name="{l:Tr enum.osdSize.Small}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="24" Height="7" CornerRadius="3.5" VerticalAlignment="Center"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource OsdSizeLabel}" Text="{l:Tr enum.osdSize.Small}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Tag="Normal" Checked="OnOsdSize" AutomationProperties.Name="{l:Tr enum.osdSize.Normal}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="34" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource OsdSizeLabel}" Text="{l:Tr enum.osdSize.Normal}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Tag="Large" Checked="OnOsdSize" AutomationProperties.Name="{l:Tr enum.osdSize.Large}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="46" Height="13" CornerRadius="6.5" VerticalAlignment="Center"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource OsdSizeLabel}" Text="{l:Tr enum.osdSize.Large}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdDuration}" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="0.5" Maximum="6" Value="{Binding OsdSeconds}" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" MinWidth="36" TextAlignment="Right" Text="{Binding OsdSeconds, StringFormat={}{0:0.0} s}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.osdFullscreen}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.osdFullscreenHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Static v:Lookups.OsdFullscreens}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding OsdFullscreen}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdShow}" />
                        <!-- A tile per kind of message, on or off; the name is in the tooltip -->
                        <UniformGrid Grid.Column="1" Rows="1" Margin="-5,0">
                            <UniformGrid.Resources>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource OsdTile}">
                                    <Setter Property="Height" Value="36" />
                                </Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="FontSize" Value="20" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </Style>
                            </UniformGrid.Resources>
                            <ToggleButton IsChecked="{Binding OsdShowActions}" ToolTip="{l:Tr settings.osdShowActions}" AutomationProperties.Name="{l:Tr settings.osdShowActions}">
                                <ui:SymbolIcon Symbol="Flash24" />
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding OsdShowLevels}" ToolTip="{l:Tr settings.osdShowLevels}" AutomationProperties.Name="{l:Tr settings.osdShowLevels}">
                                <ui:SymbolIcon Symbol="Speaker224" />
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding OsdShowVoice}" ToolTip="{l:Tr settings.osdShowVoice}" AutomationProperties.Name="{l:Tr settings.osdShowVoice}">
                                <ui:SymbolIcon Symbol="Mic24" />
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding OsdShowWarnings}" ToolTip="{l:Tr settings.osdShowWarnings}" AutomationProperties.Name="{l:Tr settings.osdShowWarnings}">
                                <ui:SymbolIcon Symbol="Warning24" />
                            </ToggleButton>
                        </UniformGrid>
                    </Grid>
                    <ui:Button MinHeight="36" Margin="0,6,0,0" Content="{l:Tr settings.osdTest}" Icon="{ui:SymbolIcon Chat24}" Click="OnTestOsd" />
                </StackPanel>
            </Border>

            <!-- OSD: notifications (the achievement cards) -->
            <Border Style="{StaticResource Card}" Tag="osd" MinWidth="560">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.notify}" />
                    <!-- The sound every notification shares (an action can choose its own) -->
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.notifySoundAll}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.notifySoundAllHint}" />
                        </StackPanel>
                        <v:SoundPicker Grid.Column="1" Width="300" VerticalAlignment="Center" Sound="{Binding NotifySound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.notifyAchievements}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.notifyAchievementsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AchievementNotifications}" />
                    </Grid>
                    <!-- The achievements' own sound: indented under them, and only with them on -->
                    <Grid Style="{StaticResource SettingRow}" Margin="24,0,0,6" IsEnabled="{Binding AchievementNotifications}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.notifySound}" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AchievementSound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.osdPosition}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.osdPositionHint}" />
                        </StackPanel>
                        <!-- The screen again: a card in each corner -->
                        <StackPanel Grid.Column="1" Margin="0,4,0,4">
                            <StackPanel.Resources>
                                <Style x:Key="NotifySpot" TargetType="RadioButton">
                                    <Setter Property="GroupName" Value="NotifySpot" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Background="Transparent" Padding="2">
                                                    <Border x:Name="Spot" Width="38" Height="16" CornerRadius="4" Background="{DynamicResource Kd.OsdTrack}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Spot" Property="Background" Value="{DynamicResource Kd.AccentText}" />
                                                        <Setter TargetName="Spot" Property="Opacity" Value="0.55" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Spot" Property="Background" Value="{DynamicResource Kd.Accent}" />
                                                        <Setter TargetName="Spot" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <Border x:Name="NotifyScreenBox" Width="168" Height="104" CornerRadius="8" BorderThickness="2" Padding="4"
                                    BorderBrush="{DynamicResource Kd.OsdTrack}" Background="{DynamicResource Kd.Subtle}">
                                <Grid>
                                    <RadioButton Style="{StaticResource NotifySpot}" Tag="TopLeft" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="OnNotifySpot" />
                                    <RadioButton Style="{StaticResource NotifySpot}" Tag="TopRight" VerticalAlignment="Top" HorizontalAlignment="Right" Checked="OnNotifySpot" />
                                    <RadioButton Style="{StaticResource NotifySpot}" Tag="BottomLeft" VerticalAlignment="Bottom" HorizontalAlignment="Left" Checked="OnNotifySpot" />
                                    <RadioButton Style="{StaticResource NotifySpot}" Tag="BottomRight" VerticalAlignment="Bottom" HorizontalAlignment="Right" Checked="OnNotifySpot" />
                                </Grid>
                            </Border>
                            <Border Width="44" Height="8" Background="{DynamicResource Kd.OsdTrack}" />
                            <Border Width="72" Height="4" CornerRadius="2" Background="{DynamicResource Kd.OsdTrack}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdScreen}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.ScreenChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding NotifyScreen}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdDuration}" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="2" Maximum="15" Value="{Binding NotifySeconds}" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" MinWidth="36" TextAlignment="Right" Text="{Binding NotifySeconds, StringFormat={}{0:0.0} s}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.osdFullscreen}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.NotifyFullscreens}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding NotifyFullscreen}" />
                    </Grid>
                    <ui:Button MinHeight="36" Margin="0,6,0,0" Content="{l:Tr settings.osdTest}" Icon="{ui:SymbolIcon Alert24}" Click="OnTestNotify" />
                </StackPanel>
            </Border>

            <!-- Remote -->
            <!-- Launcher -->
            <Border Style="{StaticResource Card}" Tag="launcher">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.launcher}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{l:Tr settings.launcherIntro}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock TextWrapping="Wrap" Text="{l:Tr settings.launcherHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.launcherHotkeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button MinHeight="36" x:Name="LauncherHotkeyButton" VerticalAlignment="Stretch" MinWidth="192" Click="OnCaptureLauncherHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="LauncherHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearLauncherHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding LauncherBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                            <v:IconToggle Width="38" Height="36" IsChecked="{Binding LauncherIgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24"
                                          Title="{l:Tr commands.ignoreDisabled}" Hint="{l:Tr commands.ignoreDisabledHint}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Margin="0,14,0,6" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.launcherApps}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.launcherAppsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LauncherApps}" AutomationProperties.Name="{l:Tr settings.launcherApps}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.launcherHidden}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.launcherHiddenHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LauncherHidden}" AutomationProperties.Name="{l:Tr settings.launcherHidden}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.launcherCalculator}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.launcherCalculatorHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LauncherCalculator}" AutomationProperties.Name="{l:Tr settings.launcherCalculator}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.launcherByUse}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.launcherByUseHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LauncherByUse}" AutomationProperties.Name="{l:Tr settings.launcherByUse}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.launcherWeb}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.launcherWebHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LauncherWeb}" AutomationProperties.Name="{l:Tr settings.launcherWeb}" />
                    </Grid>
                    <!-- The address box and what {0} means only show with «Otro…» -->
                    <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding LauncherWeb}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.launcherEngine}" />
                        <ComboBox x:Name="LauncherEngineBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding LauncherSearchEngine}" />
                        <TextBlock x:Name="LauncherUrlHint" Grid.Row="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,8,20,0" Text="{l:Tr settings.launcherEngineHint}" />
                        <ui:TextBox x:Name="LauncherUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding LauncherSearchUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="https://buscador.ejemplo/?q={0}" />
                    </Grid>
                    <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button MinHeight="36" VerticalAlignment="Stretch" Content="{l:Tr settings.launcherResetPlace}" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnResetLauncherPlace" />
                        <ui:Button MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr settings.launcherForgetButton}" Icon="{ui:SymbolIcon Delete24}" Click="OnForgetLauncherUsage" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Tag="remote">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.remote}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.udpEnabled}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpEnabledHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpEnabled}" />
                    </Grid>
                    <StackPanel IsEnabled="{Binding UdpEnabled}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.udpPort}" />
                                <!-- The addresses are in the tooltip, one per line -->
                                <TextBlock x:Name="UdpStateInfo" Style="{StaticResource Caption}" Background="Transparent" ToolTipService.InitialShowDelay="150"><Run x:Name="UdpStateText" /><InlineUIContainer BaselineAlignment="Center"><ui:SymbolIcon x:Name="UdpStateIcon" Symbol="Info24" FontSize="14" Margin="6,0,0,0" Foreground="{DynamicResource Kd.AccentText}" /></InlineUIContainer></TextBlock>
                            </StackPanel>
                            <v:NumberField Grid.Column="1" Minimum="1" Maximum="65535" Value="{Binding UdpPort}" AutomationProperties.Name="{l:Tr settings.udpPort}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.remoteScope}" />
                                <TextBlock x:Name="UdpScopeHint" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.RemoteScopes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding UdpScope}" AutomationProperties.Name="{l:Tr settings.remoteScope}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.udpKey}" />
                                <TextBlock x:Name="UdpKeyHint" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:PasswordBox x:Name="UdpKeyBox" Width="220" PlaceholderText="{l:Tr settings.udpKeyNone}" AutomationProperties.Name="{l:Tr settings.udpKey}" />
                                <ui:Button MinHeight="36" Margin="8,0,0,0" Content="{l:Tr settings.udpKeyNew}" Icon="{ui:SymbolIcon KeyReset24}" Click="OnNewUdpKey" />
                            </StackPanel>
                        </Grid>
                        <!-- What is allowed, apart from who gets in -->
                        <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.udpAllowKeys}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpAllowKeysHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpAllowKeys}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.udpAllowHidden}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpAllowHiddenHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpAllowHidden}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.udpAllowEvents}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpAllowEventsHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpAllowEvents}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.udpAllowAssistants}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpAllowAssistantsHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpAllowAssistants}" />
                        </Grid>
                        <!-- How to talk to it -->
                        <Border Style="{StaticResource InfoBox}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpHelp}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="UdpHelpDocs" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Remote web app (PWA) -->
            <Border Style="{StaticResource Card}" Tag="web">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.web}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.webEnabled}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.webEnabledHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WebEnabled}" />
                    </Grid>
                    <StackPanel IsEnabled="{Binding WebEnabled}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.webPort}" />
                                <!-- The addresses are in the tooltip, one per line -->
                                <TextBlock x:Name="WebStateInfo" Style="{StaticResource Caption}" Background="Transparent" ToolTipService.InitialShowDelay="150"><Run x:Name="WebStateText" /><InlineUIContainer BaselineAlignment="Center"><ui:SymbolIcon x:Name="WebStateIcon" Symbol="Info24" FontSize="14" Margin="6,0,0,0" Foreground="{DynamicResource Kd.AccentText}" /></InlineUIContainer></TextBlock>
                            </StackPanel>
                            <v:NumberField Grid.Column="1" Minimum="1" Maximum="65535" Value="{Binding WebPort}" AutomationProperties.Name="{l:Tr settings.webPort}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.remoteScope}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.webScopeHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.RemoteScopes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding WebScope}" AutomationProperties.Name="{l:Tr settings.remoteScope}" />
                        </Grid>
                        <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.webInput}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.webInputHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WebInput}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.webLocalPairing}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.webLocalPairingHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WebLocalPairing}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.webPublicUrl}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.webPublicUrlHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:TextBox Grid.Column="1" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center" PlaceholderText="https://kdesktop.example.com" Text="{Binding WebPublicUrl, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <WrapPanel Margin="0,6,0,0">
                            <ui:Button MinHeight="36" Margin="0,0,8,8" Appearance="Primary" Content="{l:Tr settings.webPair}" Icon="{ui:SymbolIcon QrCode24}" Click="OnPairWeb" />
                            <ui:Button MinHeight="36" Margin="0,0,8,8" Content="{l:Tr settings.webOpen}" Icon="{ui:SymbolIcon Globe24}" Click="OnOpenWeb" />
                        </WrapPanel>

                        <TextBlock Margin="0,10,0,6" FontWeight="SemiBold" Text="{l:Tr settings.webDevices}" />
                        <TextBlock x:Name="NoDevicesText" Style="{StaticResource Caption}" Text="{l:Tr settings.webNoDevices}" />
                        <ItemsControl x:Name="DevicesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="8" Background="{DynamicResource Kd.Subtle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <ui:Button MinHeight="36" Grid.Column="2" Content="{l:Tr settings.webRevoke}" Icon="{ui:SymbolIcon Delete24}" Tag="{Binding Id}" Click="OnRevokeDevice" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Android app: the one this K-Desktop carries (phones update from it), and a copy to install by hand -->
            <Border Style="{StaticResource Card}" Tag="android">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.android}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                            <ui:SymbolIcon Symbol="Phone24" FontSize="22" Foreground="{DynamicResource Kd.AccentText}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="AndroidVersionText" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="AndroidInfoText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ui:Button MinHeight="36" x:Name="AndroidSaveButton" Grid.Column="2" Appearance="Primary" Content="{l:Tr settings.androidSave}"
                                   Icon="{ui:SymbolIcon Save24}" Click="OnSaveApk" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="{l:Tr settings.androidInstallTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.androidInstall}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="{l:Tr settings.androidUpdatesTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.androidUpdates}" />
                </StackPanel>
            </Border>

            <!-- Voice: the switch, the models and the microphone -->
            <Border Style="{StaticResource Card}" Tag="voice">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.voice}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.voiceEnabled}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceEnabledHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceEnabled}" AutomationProperties.Name="{l:Tr settings.voiceEnabled}" />
                    </Grid>
                    <StackPanel IsEnabled="{Binding VoiceEnabled}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.voiceModels}" />
                                <TextBlock x:Name="VoiceModelsText" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button MinHeight="36" x:Name="VoiceDownloadButton" Appearance="Primary" Content="{l:Tr settings.voiceDownload}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnVoiceDownload" />
                                <ui:Button MinHeight="36" x:Name="VoiceCancelButton" Content="{l:Tr common.cancel}" Icon="{ui:SymbolIcon Dismiss24}" Click="OnVoiceCancel" Visibility="Collapsed" />
                                <ui:Button MinHeight="36" x:Name="VoiceDeleteButton" Margin="8,0,0,0" Content="{l:Tr settings.voiceDelete}" Icon="{ui:SymbolIcon Delete24}" Click="OnVoiceDelete" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="VoiceProgress" Height="4" Margin="0,0,0,8" Maximum="1" Visibility="Collapsed" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.voiceUnload}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceUnloadHint}" />
                            </StackPanel>
                            <ComboBox x:Name="VoiceUnloadBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding VoiceUnloadMinutes}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.voiceMic}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceMicHint}" />
                            </StackPanel>
                            <ComboBox x:Name="VoiceMicBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnVoiceMicChanged" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Voice: the hotkeys to talk and to dictate, and how they are used -->
            <Border Style="{StaticResource Card}" Tag="voice" IsEnabled="{Binding VoiceEnabled}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.voiceHotkeys}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.voiceHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceHotkeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button MinHeight="36" x:Name="VoiceHotkeyButton" VerticalAlignment="Stretch" MinWidth="192" Click="OnCaptureVoiceHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="VoiceHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearVoiceHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding VoiceBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                            <v:IconToggle Width="38" Height="36" IsChecked="{Binding VoiceIgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24"
                                          Title="{l:Tr commands.ignoreDisabled}" Hint="{l:Tr commands.ignoreDisabledHint}" />
                        </StackPanel>
                    </Grid>
                    <!-- Stage 10.5: hold (or tap) and what is said is written where the cursor is -->
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.dictationHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.dictationHotkeyHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="DictationHotkeyButton" VerticalAlignment="Stretch" MinHeight="36" MinWidth="192" Click="OnCaptureDictationHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="DictationHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearDictationHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding DictationBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                            <v:IconToggle Width="38" Height="36" IsChecked="{Binding DictationIgnoreDisabledApps}" OnSymbol="PlayCircle24" OffSymbol="Prohibited24"
                                          Title="{l:Tr commands.ignoreDisabled}" Hint="{l:Tr commands.ignoreDisabledHint}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.dictationVoice}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.dictationVoiceHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DictationVoice}" AutomationProperties.Name="{l:Tr settings.dictationVoice}" />
                    </Grid>
                    <Border Style="{StaticResource InfoBox}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceHowTo}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr settings.dictationHowTo}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Voice: what happens while it listens -->
            <Border Style="{StaticResource Card}" Tag="voice" IsEnabled="{Binding VoiceEnabled}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.voiceWhileListening}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.voiceEcho}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceEchoHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceEchoCancel}" AutomationProperties.Name="{l:Tr settings.voiceEcho}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.voiceListenSound}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceListenSoundHint}" />
                        </StackPanel>
                        <v:SoundPicker Grid.Column="1" Sound="{Binding VoiceListenSound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.voiceDuck}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.voiceDuckHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="VoiceDuckBox" Width="110" Margin="0,0,16,0" DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{Binding VoiceDuckLevel}" IsEnabled="{Binding VoiceDuck}" ToolTip="{l:Tr settings.voiceDuckLevel}" />
                            <ui:ToggleSwitch IsChecked="{Binding VoiceDuck}" AutomationProperties.Name="{l:Tr settings.voiceDuck}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource InfoBox}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:Tr settings.voicePrivacy}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Wake words: recorded with the user's voice, as many as wanted (their own section since 5.0.237) -->
            <Border Style="{StaticResource Card}" Tag="wake" IsEnabled="{Binding VoiceEnabled}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.wakeWords}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.wakeListen}" />
                            <TextBlock x:Name="WakeListenText" Style="{StaticResource Caption}" Text="{l:Tr settings.wakeListenHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceWakeListen}" AutomationProperties.Name="{l:Tr settings.wakeListen}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.wakeTrust}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.wakeTrustHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceWakeTrust}" AutomationProperties.Name="{l:Tr settings.wakeTrust}" />
                    </Grid>
                    <Border Height="1" Margin="0,6,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.wakeWordsHint}" />
                        <ui:Button MinHeight="36" x:Name="WakeAddButton" Grid.Column="1" VerticalAlignment="Center" Content="{l:Tr settings.wakeAdd}" Icon="{ui:SymbolIcon Add24}" Click="OnAddWakeWord" />
                    </Grid>
                    <TextBlock x:Name="WakeNone" Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:Tr settings.wakeNone}" />
                    <ItemsControl x:Name="WakeList" Focusable="False" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <!-- Two lines: who it is (name, summary, on/off and its buttons), then whose it is and how sensitive;
                                         one line of all of them didn't fit a narrow window -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border Width="34" Height="34" Margin="0,0,12,0" CornerRadius="8" Background="{DynamicResource Kd.AccentSoft}">
                                            <ui:SymbolIcon Symbol="PersonVoice24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Word.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Word.Summary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Word.Summary}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding Word.Enabled}" ToolTip="{l:Tr common.enabled}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr settings.wakeTest}" AutomationProperties.Name="{l:Tr settings.wakeTest}" Click="OnTestWakeWord">
                                                <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr settings.wakeRerecord}" AutomationProperties.Name="{l:Tr settings.wakeRerecord}" Click="OnRerecordWakeWord">
                                                <ui:SymbolIcon Symbol="Mic24" FontSize="16" />
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource IconButton}" ToolTip="{l:Tr settings.wakeDelete}" AutomationProperties.Name="{l:Tr settings.wakeDelete}" Click="OnDeleteWakeWord">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{DynamicResource Kd.Danger}" />
                                            </ui:Button>
                                        </StackPanel>
                                        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                            <StackPanel Margin="0,0,24,4" ToolTip="{l:Tr settings.wakeOwnerHint}">
                                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.wakeOwner}" />
                                                <ComboBox Width="205" ItemsSource="{Binding Owners}" SelectedItem="{Binding Owner, Mode=OneTime}"
                                                          SelectionChanged="OnWakeOwnerChanged" AutomationProperties.Name="{l:Tr settings.wakeOwner}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,4" ToolTip="{l:Tr settings.wakeSensitivityHint}">
                                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.wakeSensitivity}" />
                                                <Slider Width="200" Margin="0,6,0,0" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Word.Sensitivity}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource InfoBox}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:Tr settings.voiceWakeSoon}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Multimedia: built-in voice orders for the music and the volume -->
            <Border Style="{StaticResource Card}" Tag="media" IsEnabled="{Binding VoiceEnabled}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.media}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.mediaVoice}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.mediaVoiceHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceMedia}" AutomationProperties.Name="{l:Tr settings.mediaVoice}" />
                    </Grid>
                    <StackPanel IsEnabled="{Binding VoiceMedia}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.mediaStep}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.mediaStepHint}" />
                            </StackPanel>
                            <ComboBox x:Name="MediaStepBox" Grid.Column="1" Width="110" VerticalAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding VoiceMediaStep}" />
                        </Grid>

                        <Border Height="1" Margin="0,6,0,14" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.musicOn}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.musicOnHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MusicOnBox" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding VoiceMusicOn}" />
                                <Grid Tag="Command" Style="{StaticResource MusicOnPart}" Margin="0,8,0,0">
                                    <ComboBox x:Name="MusicOnCommandBox" ItemsSource="{Binding Source={x:Static v:Lookups.CommandList}}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding VoiceMusicOnCommand}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="420" />
                                    <TextBlock Style="{StaticResource ComboHint}" DataContext="{Binding ElementName=MusicOnCommandBox}" Text="{l:Tr common.chooseCommand}" />
                                </Grid>
                                <Grid Tag="Program" Style="{StaticResource MusicOnPart}" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding VoiceMusicOnProgram, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr settings.musicProgramPlaceholder}" />
                                    <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.chooseFile}"
                                               AutomationProperties.Name="{l:Tr editor.chooseFile}" Click="OnBrowseMusicProgram" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{l:Tr settings.musicOff}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.musicOffHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="MusicOffBox" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding VoiceMusicOff}" />
                                <Grid Tag="Command" Style="{StaticResource MusicOffPart}" Margin="0,8,0,0">
                                    <ComboBox x:Name="MusicOffCommandBox" ItemsSource="{Binding Source={x:Static v:Lookups.CommandList}}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding VoiceMusicOffCommand}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="420" />
                                    <TextBlock Style="{StaticResource ComboHint}" DataContext="{Binding ElementName=MusicOffCommandBox}" Text="{l:Tr common.chooseCommand}" />
                                </Grid>
                                <Border Tag="Program" Style="{StaticResource MusicOffPart}" Margin="0,8,0,0">
                                    <ComboBox IsEditable="True" Text="{Binding VoiceMusicOffProcess, UpdateSourceTrigger=PropertyChanged}"
                                              v:Placeholder.Text="{l:Tr common.processPlaceholder}" DropDownOpened="OnMusicProcessDropDown" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border Style="{StaticResource InfoBox}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.mediaExamples}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr settings.mediaNotes}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Disabled in -->
            <Border Style="{StaticResource Card}" Tag="disabledIn">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.disabledIn}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:Tr settings.disabledInHint}" />
                    <ItemsControl ItemsSource="{Binding DisabledIn}" ItemTemplate="{StaticResource ProcessChip}" ItemsPanel="{StaticResource Wrap}" />
                    <Border Height="1" Margin="0,6,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="DisabledInBox" IsEditable="True" Width="240" v:Placeholder.Text="{l:Tr common.processPlaceholder}" DropDownOpened="OnProcessDropDown" DropDownClosed="OnProcessPicked" KeyDown="OnProcessKeyDown" />
                        <ui:Button MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddDisabledIn" />
                        <ui:Button MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickDisabledIn" ToolTip="{l:Tr picker.tooltip}" />
                    </StackPanel>
                    <Border Height="1" Margin="0,14,0,6" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock TextWrapping="Wrap" Text="{l:Tr settings.disabledInHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.disabledInHotkeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="DisabledInHotkeyButton" VerticalAlignment="Stretch" MinHeight="36" MinWidth="200" Click="OnCaptureDisabledInHotkey" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" x:Name="DisabledInHotkeyClear" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearDisabledInHotkey" />
                            <v:IconToggle Width="38" Height="36" Margin="6,0,0,0" IsChecked="{Binding DisabledInBlockKey}" OnSymbol="LockClosed24" OffSymbol="LockOpen24"
                                          Title="{l:Tr commands.blockKey}" Hint="{l:Tr commands.blockKeyHint}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Side buttons (same section as «Desactivar en»: both are lists of applications) -->
            <Border Style="{StaticResource Card}" Tag="disabledIn">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="{l:Tr settings.sideButtons}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.sideButtonsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BlockSideButtons}" />
                    </Grid>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding BlockSideButtonsIn}" ItemTemplate="{StaticResource ProcessChip}" ItemsPanel="{StaticResource Wrap}" />
                    <Border Height="1" Margin="0,6,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SideButtonsBox" IsEditable="True" Width="240" v:Placeholder.Text="{l:Tr common.processPlaceholder}" DropDownOpened="OnProcessDropDown" DropDownClosed="OnProcessPicked" KeyDown="OnProcessKeyDown" />
                        <ui:Button MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddSideButtons" />
                        <ui:Button MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Stretch" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickSideButtons" ToolTip="{l:Tr picker.tooltip}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Captures (5.0.262: a section of its own) -->
            <Border Style="{StaticResource Card}" Tag="capture">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.capture}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr settings.captureFolder}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding CaptureFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr settings.captureFolderHint}" />
                        <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr editor.browse}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseCaptureFolder" />
                        <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="2" Margin="8,0,0,0" Content="{l:Tr settings.openFolder}" Icon="{ui:SymbolIcon Open24}" Click="OnOpenCaptureFolder"
                                   AutomationProperties.Name="{l:Tr settings.openCaptureFolder}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr settings.captureName}" />
                    <ui:TextBox x:Name="CaptureNameBox" Text="{Binding CaptureName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr settings.captureName}" />
                    <!-- What can go in the name, added where the text cursor is -->
                    <WrapPanel Margin="0,8,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Padding" Value="10,4" />
                            </Style>
                        </WrapPanel.Resources>
                        <ui:Button Tag="{}{date}" Content="{l:Tr settings.captureNameAdd.date}" Icon="{ui:SymbolIcon Add16}" Click="OnCaptureNameToken" />
                        <ui:Button Tag="{}{time}" Content="{l:Tr settings.captureNameAdd.time}" Icon="{ui:SymbolIcon Add16}" Click="OnCaptureNameToken" />
                        <ui:Button Tag="{}{app}" Content="{l:Tr settings.captureNameAdd.app}" Icon="{ui:SymbolIcon Add16}" Click="OnCaptureNameToken" />
                        <ui:Button Tag="{}{title}" Content="{l:Tr settings.captureNameAdd.title}" Icon="{ui:SymbolIcon Add16}" Click="OnCaptureNameToken" />
                    </WrapPanel>
                    <TextBlock x:Name="CaptureNameExample" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <Grid Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.captureFormat}" />
                        <UniformGrid x:Name="CaptureFormatPicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <RadioButton Style="{StaticResource PickTile}" Tag="Png" GroupName="CaptureFormat" Checked="OnCaptureFormat" AutomationProperties.Name="PNG">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="PNG" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.captureFormat.Png}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Jpg" GroupName="CaptureFormat" Checked="OnCaptureFormat" AutomationProperties.Name="JPG">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="JPG" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.captureFormat.Jpg}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="WebP" GroupName="CaptureFormat" Checked="OnCaptureFormat" AutomationProperties.Name="WebP">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="WebP" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.captureFormat.WebP}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <Grid>
                        <!-- Only JPG has a quality -->
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource SettingRow}">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaptureFormat}" Value="{x:Static m:ImageFileFormat.Jpg}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.captureQuality}" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="30" Maximum="100" Value="{Binding CaptureQuality}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:Tr settings.captureQuality}" />
                            <TextBlock Grid.Column="1" MinWidth="56" TextAlignment="Right" Text="{Binding CaptureQuality, StringFormat={}{0} %}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.captureDelay}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.captureDelayHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="0" Maximum="10" Value="{Binding CaptureDelay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:Tr settings.captureDelay}" />
                            <TextBlock x:Name="CaptureDelayText" Grid.Column="1" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.captureAlwaysCopy}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.captureAlwaysCopyHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CaptureAlwaysCopy}" AutomationProperties.Name="{l:Tr settings.captureAlwaysCopy}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.captureCursor}" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CaptureCursor}" AutomationProperties.Name="{l:Tr settings.captureCursor}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.captureSound}" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CaptureSound}" AutomationProperties.Name="{l:Tr settings.captureSound}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.captureFlash}" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CaptureFlash}" AutomationProperties.Name="{l:Tr settings.captureFlash}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio recordings (5.0.262: a section of its own) -->
            <Border Style="{StaticResource Card}" Tag="recording">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.recordings}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr settings.recordFolder}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding RecordFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr settings.recordFolderHint}" />
                        <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr editor.browse}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseRecordFolder" />
                        <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="2" Margin="8,0,0,0" Content="{l:Tr settings.openFolder}" Icon="{ui:SymbolIcon Open24}" Click="OnOpenRecordFolder"
                                   AutomationProperties.Name="{l:Tr settings.openRecordFolder}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.recordFormat}" />
                        <UniformGrid x:Name="RecordFormatPicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <RadioButton Style="{StaticResource PickTile}" Tag="Wav" GroupName="RecordFormat" Checked="OnRecordFormat" AutomationProperties.Name="WAV">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="WAV" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.recordFormat.Wav}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Mp3" GroupName="RecordFormat" Checked="OnRecordFormat" AutomationProperties.Name="MP3">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="MP3" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.recordFormat.Mp3}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Opus" GroupName="RecordFormat" Checked="OnRecordFormat" AutomationProperties.Name="Opus">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="Opus" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.recordFormat.Opus}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.recordMicVolume}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.recordMicVolumeHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="25" Maximum="400" Value="{Binding RecordMicVolume}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:Tr settings.recordMicVolume}" />
                            <TextBlock Grid.Column="1" MinWidth="56" TextAlignment="Right" Text="{Binding RecordMicVolume, StringFormat={}{0} %}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.recordSplit}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.recordSplitHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="0" Maximum="120" Value="{Binding RecordSplitMinutes}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:Tr settings.recordSplit}" />
                            <TextBlock x:Name="RecordSplitText" Grid.Column="1" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The last seconds, kept in memory -->
            <Border Style="{StaticResource Card}" Tag="recording">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2" Text="{l:Tr settings.audioReplay}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.audioReplayHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AudioReplay}" AutomationProperties.Name="{l:Tr settings.audioReplay}" />
                    </Grid>
                    <WrapPanel IsEnabled="{Binding AudioReplay}" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr settings.audioReplaySeconds}" />
                            <ui:TextBox Width="120" Text="{Binding AudioReplaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.recordSource}" />
                            <ComboBox Width="260" ItemsSource="{x:Static v:Lookups.AudioSources}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding AudioReplaySource}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Magnifier (5.0.262: a section of its own) -->
            <Border Style="{StaticResource Card}" Tag="zoom">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.zoom}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.zoomLevel}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.zoomHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="1.25" Maximum="6" Value="{Binding ZoomLevel}" TickFrequency="0.25" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:Tr settings.zoomLevel}" />
                            <TextBlock Grid.Column="1" MinWidth="56" TextAlignment="Right" Text="{Binding ZoomLevel, StringFormat=×{0:0.##}}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.zoomMode}" />
                        <!-- Three tiles, each with a drawing of the shape -->
                        <UniformGrid x:Name="ZoomModePicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <RadioButton Style="{StaticResource PickTile}" Tag="Lens" GroupName="ZoomMode" Checked="OnZoomMode" AutomationProperties.Name="{l:Tr enum.zoomMode.Lens}" ToolTip="{l:Tr enum.zoomMode.Lens}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="32" Height="20" CornerRadius="5" BorderThickness="2" VerticalAlignment="Center"
                                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomShape.Lens}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Circle" GroupName="ZoomMode" Checked="OnZoomMode" AutomationProperties.Name="{l:Tr enum.zoomMode.Circle}" ToolTip="{l:Tr enum.zoomMode.Circle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Ellipse Width="24" Height="24" StrokeThickness="2" VerticalAlignment="Center"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomShape.Circle}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="FullScreen" GroupName="ZoomMode" Checked="OnZoomMode" AutomationProperties.Name="{l:Tr enum.zoomMode.FullScreen}" ToolTip="{l:Tr enum.zoomMode.FullScreen}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <!-- A monitor: the screen and its stand -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="34" Height="21" CornerRadius="3" BorderThickness="2"
                                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Border Width="14" Height="3" Margin="0,2,0,0" CornerRadius="1.5"
                                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomShape.FullScreen}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <Grid Style="{StaticResource LensOnlyRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.zoomLensSize}" />
                        <!-- Three tiles, a bigger lens each -->
                        <UniformGrid x:Name="ZoomSizePicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <RadioButton Style="{StaticResource PickTile}" Tag="Small" GroupName="ZoomSize" Checked="OnZoomSize" AutomationProperties.Name="{l:Tr enum.zoomLensSize.Small}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Ellipse Width="12" Height="12" StrokeThickness="2" VerticalAlignment="Center"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr enum.zoomLensSize.Small}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Medium" GroupName="ZoomSize" Checked="OnZoomSize" AutomationProperties.Name="{l:Tr enum.zoomLensSize.Medium}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Ellipse Width="18" Height="18" StrokeThickness="2" VerticalAlignment="Center"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr enum.zoomLensSize.Medium}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Large" GroupName="ZoomSize" Checked="OnZoomSize" AutomationProperties.Name="{l:Tr enum.zoomLensSize.Large}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Ellipse Width="25" Height="25" StrokeThickness="2" VerticalAlignment="Center"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr enum.zoomLensSize.Large}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <ui:Button x:Name="ZoomTestButton" MinHeight="36" Margin="0,12,0,0" HorizontalAlignment="Left" Content="{l:Tr settings.zoomTest}" Icon="{ui:SymbolIcon ZoomIn24}" Click="OnZoomTest" />
                </StackPanel>
            </Border>

            <!-- How the lupa looks -->
            <Border Style="{StaticResource Card}" Tag="zoom">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.zoomLook}" />
                    <Grid Style="{StaticResource LensOnlyRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.zoomBorder}" />
                        <!-- Four tiles, a thicker frame each -->
                        <UniformGrid x:Name="ZoomBorderPicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <RadioButton Style="{StaticResource PickTile}" Tag="0" GroupName="ZoomBorder" Checked="OnZoomBorder" AutomationProperties.Name="{l:Tr settings.zoomBorder.0}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Rectangle Width="30" Height="20" RadiusX="5" RadiusY="5" StrokeThickness="1.5" StrokeDashArray="2 2" VerticalAlignment="Center"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomBorder.0}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="3" GroupName="ZoomBorder" Checked="OnZoomBorder" AutomationProperties.Name="{l:Tr settings.zoomBorder.3}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="30" Height="20" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center" BorderBrush="{Binding ZoomBorderBrush, RelativeSource={RelativeSource AncestorType=local:SettingsPage}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomBorder.3}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="6" GroupName="ZoomBorder" Checked="OnZoomBorder" AutomationProperties.Name="{l:Tr settings.zoomBorder.6}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="30" Height="20" CornerRadius="5" BorderThickness="3" VerticalAlignment="Center" BorderBrush="{Binding ZoomBorderBrush, RelativeSource={RelativeSource AncestorType=local:SettingsPage}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomBorder.6}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="10" GroupName="ZoomBorder" Checked="OnZoomBorder" AutomationProperties.Name="{l:Tr settings.zoomBorder.10}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="30" Height="20" CornerRadius="6" BorderThickness="5" VerticalAlignment="Center" BorderBrush="{Binding ZoomBorderBrush, RelativeSource={RelativeSource AncestorType=local:SettingsPage}}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr settings.zoomBorder.10}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <Grid>
                        <!-- No border (or full screen): no colour to choose -->
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource LensOnlyRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoomBorder}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.zoomBorderColor}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="ZoomColorSwatch" Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand"
                                          ToolTip="{l:Tr settings.zoomBorderColor}" AutomationProperties.Name="{l:Tr settings.zoomBorderColor}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Edge" CornerRadius="8" BorderThickness="1" Padding="3"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource Kd.Subtle}">
                                            <Border CornerRadius="5" Background="{Binding ZoomBorderBrush, RelativeSource={RelativeSource AncestorType=local:SettingsPage}}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox Width="100" VerticalAlignment="Center" MaxLength="7" FontFamily="Consolas" x:Name="ZoomColorBox"
                                     TextChanged="OnZoomColorTyped" AutomationProperties.Name="{l:Tr settings.zoomBorderColor}" />
                            <Popup IsOpen="{Binding IsChecked, ElementName=ZoomColorSwatch}" PlacementTarget="{Binding ElementName=ZoomColorSwatch}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Padding="10" CornerRadius="8" BorderThickness="1" Width="236"
                                        Background="{DynamicResource Kd.MenuTintOpaque}" BorderBrush="{DynamicResource Kd.MenuBorder}">
                                    <ItemsControl ItemsSource="{x:Static local:SettingsPage.BorderColors}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="24" Height="24" Margin="2" Cursor="Hand" Tag="{Binding}" Click="OnPickZoomColor"
                                                        ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Dot" CornerRadius="5" Background="{Binding}" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr settings.zoomColors}" />
                        <!-- «Aa» as each one shows it -->
                        <UniformGrid x:Name="ZoomColorsPicker" Grid.Column="1" Rows="1" Margin="-5,0">
                            <RadioButton Style="{StaticResource PickTile}" Tag="Normal" GroupName="ZoomColors" Checked="OnZoomColors" AutomationProperties.Name="{l:Tr enum.zoomColors.Normal}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" Text="Aa" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr enum.zoomColors.Normal}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="Inverted" GroupName="ZoomColors" Checked="OnZoomColors" AutomationProperties.Name="{l:Tr enum.zoomColors.Inverted}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border CornerRadius="4" Padding="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                        <TextBlock Style="{StaticResource TileBig}" Foreground="{DynamicResource ApplicationBackgroundBrush}" Text="Aa" />
                                    </Border>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr enum.zoomColors.Inverted}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PickTile}" Tag="HighContrast" GroupName="ZoomColors" Checked="OnZoomColors" AutomationProperties.Name="{l:Tr enum.zoomColors.HighContrast}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource TileBig}" FontWeight="Black" Text="Aa" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{l:Tr enum.zoomColors.HighContrast}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.zoomSmooth}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.zoomSmoothHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ZoomSmooth}" AutomationProperties.Name="{l:Tr settings.zoomSmooth}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- How the lupa behaves -->
            <Border Style="{StaticResource Card}" Tag="zoom">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.zoomBehaviour}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.zoomFollowText}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.zoomFollowTextHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ZoomFollowText}" AutomationProperties.Name="{l:Tr settings.zoomFollowText}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.zoomCtrlWheel}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.zoomCtrlWheelHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ZoomCtrlWheel}" AutomationProperties.Name="{l:Tr settings.zoomCtrlWheel}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.zoomAutoOff}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.zoomAutoOffHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Margin="0,0,14,0" Minimum="0" Maximum="60" Value="{Binding ZoomAutoOff}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:Tr settings.zoomAutoOff}" />
                            <TextBlock x:Name="ZoomAutoOffText" Grid.Column="1" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Card}" Tag="data">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.data}" />
                    <!-- Where the data is, as a link that opens it -->
                    <!-- Like the link to the documentation in «Control remoto»: the accent colour, also under the mouse -->
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap">
                        <Hyperlink x:Name="DataPathLink" Click="OnOpenData" ToolTip="{l:Tr settings.openDataTip}" Foreground="{DynamicResource Kd.AccentText}"><Run x:Name="DataPathText" /></Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" Text="{l:Tr settings.exportHint}" />
                    <WrapPanel>
                        <ui:Button MinHeight="36" Margin="0,0,8,8" Content="{l:Tr settings.export}" Icon="{ui:SymbolIcon ArrowUpload24}" Click="OnExport" />
                        <ui:Button MinHeight="36" Margin="0,0,8,8" Content="{l:Tr settings.import}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnImport" />
                        <ui:Button MinHeight="36" Margin="0,0,8,8" Content="{l:Tr settings.openLog}" Icon="{ui:SymbolIcon DocumentText24}" Click="OnOpenLog" />
                    </WrapPanel>
                    <Border Height="1" SnapsToDevicePixels="True" Margin="0,10,0,6" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr settings.autoBackup}" />
                            <TextBlock x:Name="AutoBackupStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoBackup}" AutomationProperties.Name="{l:Tr settings.autoBackup}" />
                    </Grid>
                    <StackPanel IsEnabled="{Binding AutoBackup}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.autoBackupDays}" />
                            <v:NumberField Grid.Column="1" Minimum="1" Maximum="365" Value="{Binding AutoBackupDays}" AutomationProperties.Name="{l:Tr settings.autoBackupDays}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr settings.autoBackupKeep}" />
                            <v:NumberField Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding AutoBackupKeep}" AutomationProperties.Name="{l:Tr settings.autoBackupKeep}" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="{l:Tr settings.autoBackupFolder}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="BackupFolderBox" Text="{Binding AutoBackupFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr settings.autoBackupFolder}" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr editor.browse}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseBackupFolder" />
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" Grid.Column="2" Margin="8,0,0,0" Content="{l:Tr settings.openFolder}" Icon="{ui:SymbolIcon Open24}" Click="OnOpenBackups"
                                       AutomationProperties.Name="{l:Tr settings.openBackups}" />
                        </Grid>
                    </StackPanel>
                    <ui:Button MinHeight="36" Margin="0,4,0,8" HorizontalAlignment="Left" Content="{l:Tr settings.backupNow}" Icon="{ui:SymbolIcon Save24}" Click="OnBackupNow" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr settings.autoBackupHint}" />
                </StackPanel>
            </Border>

            <!-- Achievements and statistics, apart: it can't be undone -->
            <Border Style="{StaticResource Card}" Tag="data">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}" Margin="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr ach.reset}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.resetAchHint}" />
                        </StackPanel>
                        <ui:Button MinHeight="36" Grid.Column="1" Margin="12,0,0,0" Appearance="Danger" Content="{l:Tr ach.resetButton}" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnResetAchievements" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Tag="updates">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr settings.updates}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="UpdateCurrentText" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="UpdateLastCheckText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ui:Button MinHeight="36" x:Name="UpdateCheckButton" Grid.Column="1" Content="{l:Tr updates.check}" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdates" />
                    </Grid>
                    <!-- A newer version: what it brings and the button to install it -->
                    <Border x:Name="UpdatePanel" Style="{StaticResource InfoBox}" Margin="0,4,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateTitleText" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="UpdateProgress" Margin="0,12,0,0" Height="4" Maximum="1" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button MinHeight="36" x:Name="UpdateInstallButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnInstallUpdate" />
                                <ui:Button MinHeight="36" x:Name="UpdateCancelButton" Margin="8,0,0,0" Content="{l:Tr common.cancel}" Click="OnCancelUpdate" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="UpdatePortableText" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="{l:Tr updates.notPortable}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr updates.mode}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr updates.modeHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.UpdateModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding UpdateMode}"
                                  AutomationProperties.Name="{l:Tr updates.mode}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Text="{l:Tr updates.check.when}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.UpdateChecks}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding UpdateCheck}"
                                  AutomationProperties.Name="{l:Tr updates.check.when}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" MaxWidth="400" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr updates.url}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr updates.urlHint}" />
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button MinHeight="36" VerticalAlignment="Stretch" DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowReset24}" ToolTip="{l:Tr updates.urlReset}"
                                       AutomationProperties.Name="{l:Tr updates.urlReset}" Click="OnResetUpdateUrl" />
                            <ui:TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=LostFocus}" PlaceholderText="{x:Static m:AppSettings.DefaultUpdateUrl}" />
                        </DockPanel>
                    </Grid>
                    <!-- The installed assistants: their new versions are only offered (stage 9.5); rows made in code -->
                    <StackPanel x:Name="AssistantUpdatesBlock" Visibility="Collapsed">
                        <Border Height="1" SnapsToDevicePixels="True" Margin="0,14,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr assistantUpdates.title}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantUpdates.hint}" />
                        <TextBlock x:Name="AssistantUpdatesHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel x:Name="AssistantUpdatesRows" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Assistant -->
            <local:AssistantGeneralSection Tag="assistant" />
            <local:AssistantListSection x:Name="AssistantsSection" Tag="assistants" />
            <local:AssistantCatalogSection Tag="catalog" />
            <local:AssistantBrainSection Tag="brain" />
            <local:AssistantVoiceSection Tag="speech" Part="speech" />
            <local:AssistantVoiceSection Tag="speech/voices" Part="speech/voices" />
            <local:VoiceProfilesSection Tag="speech/profiles" />
            <local:AssistantMemorySection Tag="memory" />
            <local:AssistantNotesSection Tag="notes" />
            <local:AssistantKnowledgeSection Tag="knowledge" />
            <local:AssistantToolsSection Tag="tools" Part="tools" />
            <local:AssistantToolsSection Tag="tools/builtin" Part="tools/builtin" />
            <local:AssistantToolsSection x:Name="SubjectSection" Tag="tools/subject" Part="tools/subject" />
            <local:AssistantToolsSection Tag="tools/files" Part="tools/files" />
            <local:AssistantToolsSection x:Name="FileSection" Tag="tools/file" Part="tools/file" />
            <local:AssistantToolsSection Tag="tools/servers" Part="tools/servers" />
            <local:AssistantToolsSection x:Name="ServerSection" Tag="tools/server" Part="tools/server" />
            <local:AssistantToolsSection Tag="tools/secrets" Part="tools/secrets" />
            <local:AssistantToolsSection Tag="tools/share" Part="tools/share" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
