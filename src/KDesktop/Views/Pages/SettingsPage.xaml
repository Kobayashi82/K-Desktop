<UserControl x:Class="KDesktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <UserControl.Resources>
        <!-- Removable process chip; Tag of the button = the list it belongs to -->
        <DataTemplate x:Key="ProcessChip">
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                    <ui:Button Style="{StaticResource IconButton}" Padding="4" Margin="4,0,0,0" Click="OnRemoveChip"
                               Tag="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,24">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.settings}" Margin="0,0,0,18" />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr settings.appearance}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.theme}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.themeHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.Themes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.language}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.languageHint}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr settings.general}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.startWithWindows}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.startWithWindowsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Click="OnStartupToggle" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.trayIcon}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.trayIconHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTrayIcon}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.showHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.showHotkeyHint}" />
                        </StackPanel>
                        <ui:Button x:Name="ShowHotkeyButton" Grid.Column="1" MinWidth="200" Content="{Binding ShowWindowHotkey}" Click="OnCaptureShowHotkey" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.exitHotkey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.exitHotkeyHint}" />
                        </StackPanel>
                        <ui:Button x:Name="ExitHotkeyButton" Grid.Column="1" MinWidth="200" Content="{Binding ExitHotkey}" Click="OnCaptureExitHotkey" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.startupSound}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.startupSoundHint}" />
                        </StackPanel>
                        <ComboBox x:Name="StartupSoundBox" Grid.Column="1" IsEditable="True" Text="{Binding StartupSound, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.startupMessage}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.startupMessageHint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Text="{Binding StartupMessage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OSD -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr settings.osd}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{l:Tr settings.osdPosition}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static v:Lookups.OsdPositions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding OsdPosition}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{l:Tr settings.osdDuration}" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                            <Slider Minimum="0.5" Maximum="6" Value="{Binding OsdSeconds}" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding OsdSeconds, StringFormat={}{0:0.0} s}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <ui:Button Margin="0,6,0,0" Content="{l:Tr settings.osdTest}" Icon="{ui:SymbolIcon Chat24}" Click="OnTestOsd" />
                </StackPanel>
            </Border>

            <!-- Remote -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr settings.remote}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.udpEnabled}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpEnabledHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpEnabled}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.udpRemote}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.udpRemoteHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UdpAllowRemote}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr settings.udpPort}" />
                            <TextBlock x:Name="IpText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Text="{Binding UdpPort, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Disabled in -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr settings.disabledIn}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:Tr settings.disabledInHint}" />
                    <ItemsControl ItemsSource="{Binding DisabledIn}" ItemTemplate="{StaticResource ProcessChip}" ItemsPanel="{StaticResource Wrap}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox x:Name="DisabledInBox" IsEditable="True" Width="240" DropDownOpened="OnProcessDropDown" />
                        <ui:Button Margin="8,0,0,0" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddDisabledIn" />
                        <ui:Button Margin="8,0,0,0" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickDisabledIn" ToolTip="{l:Tr picker.tooltip}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Side buttons -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{l:Tr settings.sideButtons}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.sideButtonsHint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BlockSideButtons}" />
                    </Grid>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding BlockSideButtonsIn}" ItemTemplate="{StaticResource ProcessChip}" ItemsPanel="{StaticResource Wrap}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox x:Name="SideButtonsBox" IsEditable="True" Width="240" DropDownOpened="OnProcessDropDown" />
                        <ui:Button Margin="8,0,0,0" Content="{l:Tr common.add}" Icon="{ui:SymbolIcon Add24}" Click="OnAddSideButtons" />
                        <ui:Button Margin="8,0,0,0" Content="{l:Tr picker.button}" Icon="{ui:SymbolIcon Cursor24}" Click="OnPickSideButtons" ToolTip="{l:Tr picker.tooltip}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr settings.data}" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,8" Content="{l:Tr settings.openData}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenData" />
                        <ui:Button Margin="0,0,8,8" Content="{l:Tr settings.export}" Icon="{ui:SymbolIcon ArrowExport24}" Click="OnExport" />
                        <ui:Button Margin="0,0,8,8" Content="{l:Tr settings.import}" Icon="{ui:SymbolIcon ArrowImport24}" Click="OnImport" />
                        <ui:Button Margin="0,0,8,8" Content="{l:Tr settings.reimportLegacy}" Icon="{ui:SymbolIcon History24}" Click="OnReimportLegacy" />
                        <ui:Button Margin="0,0,8,8" Content="{l:Tr settings.openLog}" Icon="{ui:SymbolIcon DocumentText24}" Click="OnOpenLog" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
