<UserControl x:Class="KDesktop.Views.Pages.AssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:a="clr-namespace:KDesktop.Views.Assistant">
    <UserControl.Resources>
        <!-- A label and its value in the status card -->
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,24,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── The assistants, as the lists of the other pages: K-Desktop first, the active ones marked ── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.assistant}" />
                <Border x:Name="CountChip" Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}"
                        ToolTip="{l:Tr assistantPanel.activeCount}">
                    <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <ui:Button x:Name="ChooseButton" HorizontalAlignment="Stretch" Content="{l:Tr assistantPanel.choose}"
                           Icon="{ui:SymbolIcon PeopleCommunity24}" Click="OnChoose" />
                <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="{l:Tr assistantPanel.options}"
                           Icon="{ui:SymbolIcon Settings24}" Click="OnOptions" />
                <!-- The models out of the graphics card; only when there is something in it -->
                <ui:Button x:Name="FreeBrainButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="{l:Tr assistantMenu.freeBrain}"
                           Icon="{ui:SymbolIcon Broom24}" Click="OnFreeBrain" IsEnabled="False" />
            </StackPanel>
            <ListBox x:Name="AssistantList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource CardRowItem}"
                     SelectionChanged="OnAssistantSelected" AutomationProperties.Name="{l:Tr assistantPanel.whom}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Margin="0,0,12,0" CornerRadius="9" Background="{DynamicResource Kd.ChipBackground}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Bot24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}"
                                                   Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                    <Image Source="{Binding Icon}" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,1,0,0" Text="{Binding StateText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Margin="6,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource Kd.Success}"
                                     Visibility="{Binding IsOnDesktop, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    <!-- As wide as the window up to 980, like the sections of Opciones -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,24,24">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="980" /></Grid.ColumnDefinitions>
        <StackPanel MinWidth="520">
            <!-- The module is off -->
            <Border x:Name="OffPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Margin="0,20" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource Kd.AccentSoft}" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Bot24" FontSize="38" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                    <TextBlock Margin="0,16,0,6" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:Tr assistantPanel.offTitle}" />
                    <TextBlock Style="{StaticResource Caption}" MaxWidth="460" TextAlignment="Center" Text="{l:Tr assistantPanel.offHint}" />
                    <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon Power24}"
                               Content="{l:Tr assistantPanel.turnOn}" Click="OnTurnOn" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="OnPanel">
                <!-- The one chosen in the list -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="16" Background="{DynamicResource Kd.ChipBackground}" VerticalAlignment="Top">
                            <Grid>
                                <ui:SymbolIcon x:Name="HeroFallback" Symbol="Bot24" FontSize="38" Foreground="{DynamicResource Kd.AccentText}" />
                                <Image x:Name="HeroIcon" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="HeroByline" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Ellipse x:Name="HeroDot" Width="9" Height="9" Margin="0,5,8,0" VerticalAlignment="Top" />
                                <TextBlock x:Name="HeroState" Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <!-- What it is doing now and its model, in one short line (5.0.289: no longer a card of its own); the icon centred
                                 under the dot above and the text where the state text starts (17 px) -->
                            <StackPanel x:Name="NowRow" Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:SymbolIcon x:Name="NowIcon" FontSize="14" Margin="-2,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                                <TextBlock x:Name="NowText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ui:Button x:Name="SettingsButton" Margin="0,0,0,8" HorizontalAlignment="Stretch" Content="{l:Tr assistantPanel.settings}"
                                       Icon="{ui:SymbolIcon Options24}" Click="OnAssistantSettings" />
                            <ui:Button x:Name="HideButton" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon EyeOff24}" Click="OnHide" />
                            <ui:Button x:Name="PutButton" HorizontalAlignment="Stretch" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Click="OnPut" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Only when something went wrong -->
                <Border x:Name="ErrorPanel" Margin="0,0,0,12" CornerRadius="8" Padding="12,10" Visibility="Collapsed"
                        Background="{DynamicResource Kd.DangerSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.Danger}" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <!-- 5.0.289: the conversation (the same for all of them) and, apart, its own panel (panel.json) -->
                <StackPanel x:Name="Tabs" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="TalkTab" Style="{StaticResource Pill}" IsChecked="True" Checked="OnTab" AutomationProperties.Name="{l:Tr assistantPanel.talkTab}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Chat24" FontSize="16" Margin="0,0,7,0" />
                            <TextBlock Text="{l:Tr assistantPanel.talkTab}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OwnTab" Style="{StaticResource Pill}" Checked="OnTab">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="16" Margin="0,0,7,0" />
                            <TextBlock x:Name="OwnTabText" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Its own cards (panel.json) -->
                <a:AssistantPanelView x:Name="OwnPanel" Visibility="Collapsed" />

                <StackPanel x:Name="TalkPanel">
                <!-- Talking with it (stage 3.6) -->
                <a:AssistantChatView x:Name="Chat" />

                <!-- What it did (or everyone), with undo (stage 3.3) -->
                <a:ActivityView x:Name="Activity" />

                <!-- The process, what it uses and its log -->
                <ui:CardExpander x:Name="TechExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Wrench24}" Expanded="OnTechExpanded"
                                 AutomationProperties.Name="{l:Tr assistantPanel.tech}">
                    <ui:CardExpander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{l:Tr assistantPanel.tech}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource StatusLabel}" Text="{l:Tr assistantPanel.process}" />
                            <TextBlock x:Name="ProcessText" Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatusLabel}" Text="{l:Tr assistantPanel.memory}" />
                            <TextBlock x:Name="MemoryText" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatusLabel}" Text="{l:Tr assistantPanel.cpu}" />
                            <TextBlock x:Name="CpuText" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusValue}" />
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <ui:Button x:Name="RestartButton" Margin="0,0,8,0" Content="{l:Tr assistantPanel.restart}"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRestart" />
                            <ui:Button Content="{l:Tr assistantPanel.log}" Icon="{ui:SymbolIcon DocumentText24}" Click="OnOpenLog" />
                        </WrapPanel>
                    </StackPanel>
                </ui:CardExpander>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
