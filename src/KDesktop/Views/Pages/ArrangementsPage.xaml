<UserControl x:Class="KDesktop.Views.Pages.ArrangementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:m="clr-namespace:KDesktop.Core.Model;assembly=KDesktop.Core">
    <UserControl.Resources>
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── List ──────────────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="0,0,16,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.arrangements}" />
                    <Border Margin="10,6,0,0" Padding="8,1" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </Border>
                </StackPanel>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr arrangement.search}" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="OnSearchChanged" ClearButtonEnabled="True" Margin="0,0,0,10" />
                <ui:Button Margin="0,0,0,10" Content="{l:Tr arrangement.new}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnNew" HorizontalAlignment="Stretch" />
            </StackPanel>

            <ListBox x:Name="ArrangementList" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource CardRowItem}"
                     SelectionChanged="OnSelected" PreviewMouseRightButtonUp="OnRightClick" KeyDown="OnListKey">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:WindowArrangement}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="WindowApps24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,1,0,0" Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Editor ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="0,0,24,16">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" MaxWidth="520">
                <ui:SymbolIcon Symbol="WindowApps24" FontSize="56" Foreground="{DynamicResource Kd.Accent}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,4" Text="{l:Tr arrangement.emptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{l:Tr arrangement.emptyText}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ListEmpty" Margin="0,8,0,0" Text="{l:Tr arrangement.listEmpty}" Style="{StaticResource Caption}" TextAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="Editor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="EditorShift" />
                </ScrollViewer.RenderTransform>
                <StackPanel>
                    <!-- Header: the name, save as they are now, try it, a command for it, duplicate, delete (as in Macros) -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="10" VerticalAlignment="Top" Background="{DynamicResource Kd.AccentSoft}">
                                <ui:SymbolIcon Symbol="WindowApps24" FontSize="28" Foreground="{DynamicResource Kd.AccentText}" />
                            </Border>
                            <Grid Grid.Column="1" Margin="16,0,0,0" v:ResponsiveHeader.MinNameWidth="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBox x:Name="NameBox" ClearButtonEnabled="False" FontSize="16" FontWeight="SemiBold" PlaceholderText="{l:Tr arrangement.namePlaceholder}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr arrangement.namePlaceholder}"
                                            GotKeyboardFocus="OnNameFocus" LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" v:ResponsiveHeader.IsSide="True">
                                    <ui:Button MinHeight="34" Content="{l:Tr arrangement.capture}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="OnCapture"
                                               ToolTip="{l:Tr arrangement.captureHint}" Margin="0,0,8,0" />
                                    <ui:Button MinHeight="34" Content="{l:Tr macro.test}" Icon="{ui:SymbolIcon Play24}" Click="OnTest" ToolTip="{l:Tr arrangement.testHint}" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon FlashAdd20, FontSize=18}" ToolTip="{l:Tr arrangement.createCommand}"
                                               AutomationProperties.Name="{l:Tr arrangement.createCommand}" Click="OnCreateCommand" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Copy24, FontSize=18}" ToolTip="{l:Tr common.duplicate}"
                                               AutomationProperties.Name="{l:Tr common.duplicate}" Click="OnDuplicate" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon Delete24, FontSize=18}" ToolTip="{l:Tr arrangement.delete}"
                                               AutomationProperties.Name="{l:Tr arrangement.delete}" Click="OnDelete" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <TextBlock x:Name="NameError" Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{l:Tr arrangement.nameRequired}"
                                               Foreground="{DynamicResource Kd.Danger}" Visibility="Collapsed" />
                                    <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- The windows: one row each, as a command's row; switched off, it is left where it is -->
                    <ui:CardExpander x:Name="WindowsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Window24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr arrangement.windows}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr arrangement.windows}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock x:Name="NoWindows" Style="{StaticResource Caption}" Text="{l:Tr arrangement.windowsEmpty}" TextWrapping="Wrap" />
                            <ItemsControl x:Name="WindowRows" ItemsSource="{Binding Windows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:ArrangedWindow}">
                                        <Grid x:Name="Root" Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" Margin="0,0,12,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Kd.AccentSoft}">
                                                <ui:SymbolIcon Symbol="Window24" FontSize="16" Foreground="{DynamicResource Kd.AccentText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Margin="0,1,0,0" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Title}" />
                                                <TextBlock Margin="0,1,0,0" Text="{Binding Where}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Kd.AccentText}" ToolTip="{Binding Exact}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" IsChecked="{Binding Enabled}"
                                                             ToolTip="{l:Tr arrangement.windowOn}" AutomationProperties.Name="{l:Tr arrangement.windowOn}" />
                                            <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Center" Click="OnRemoveWindow" Tag="{Binding}"
                                                       ToolTip="{l:Tr arrangement.removeWindow}" AutomationProperties.Name="{l:Tr arrangement.removeWindow}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                            </ui:Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Options (folded unless opened by hand, as in Comandos) -->
                    <ui:CardExpander x:Name="OptionsExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Options24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.options}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.options}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding OpenMissing}" Content="{l:Tr arrangement.openMissing}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr arrangement.openMissingHint}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{l:Tr arrangement.monitorsHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Notes (foldable, as in Comandos) -->
                    <ui:CardExpander x:Name="NotesExpander" Margin="0,0,0,12" Icon="{ui:SymbolIcon Note24}" HorizontalContentAlignment="Stretch"
                                     Expanded="OnSectionFolded" Collapsed="OnSectionFolded" AutomationProperties.Name="{l:Tr commands.notes}">
                        <ui:CardExpander.Header>
                            <TextBlock FontWeight="SemiBold" Text="{l:Tr commands.notes}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:CardExpander.Header>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 AutomationProperties.Name="{l:Tr commands.notes}" />
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
