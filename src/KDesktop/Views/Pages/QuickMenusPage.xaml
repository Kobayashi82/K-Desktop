<UserControl x:Class="KDesktop.Views.Pages.QuickMenusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <Grid Margin="24,12,24,24">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.quickmenus}" Margin="0,0,0,18" />
            <ComboBox x:Name="MenuBox" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Name" />
            <ui:Button Margin="0,12,0,0" Content="{l:Tr qm.test}" Icon="{ui:SymbolIcon Play24}" Click="OnTest" />
        </StackPanel>
    </Grid>
</UserControl>
