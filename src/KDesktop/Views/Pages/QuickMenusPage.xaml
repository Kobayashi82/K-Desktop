<UserControl x:Class="KDesktop.Views.Pages.QuickMenusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:v="clr-namespace:KDesktop.Views"
             xmlns:s="clr-namespace:KDesktop.Services"
             xmlns:qe="clr-namespace:KDesktop.Views.QuickMenuEditor"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Focusable="True"
             PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <v:CommandIconConverter x:Key="CommandIcon" />
        <v:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <v:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <v:BoolToCollapsedConverter x:Key="BoolToVisibleInv" Invert="True" />

        <!-- The menu's size, as the real menu shows it (set from the code when the size changes) -->
        <sys:Double x:Key="Qm.FontSize">13</sys:Double>
        <sys:Double x:Key="Qm.IconSize">18</sys:Double>
        <sys:Double x:Key="Qm.RowHeight">30.5</sys:Double>

        <!-- ── A row of the menu canvas ─────────────────────────────── -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type qe:QmRow}">
            <Grid x:Name="Row" Background="Transparent" AllowDrop="True" Margin="0,1"
                  PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseMove="OnRowMouseMove" MouseLeftButtonUp="OnRowMouseUp"
                  MouseRightButtonUp="OnRowRightClick" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                <!-- separator -->
                <Border x:Name="Sep" Height="1" Margin="10,5" Background="{DynamicResource Kd.MenuSeparator}" Visibility="Collapsed" />

                <Grid x:Name="Content" Height="{DynamicResource Qm.RowHeight}" MinWidth="220">
                    <Border x:Name="Bg" CornerRadius="5" Background="Transparent" />
                    <Border x:Name="TitleBand" CornerRadius="5" Background="{DynamicResource Kd.MenuTitle}" Visibility="Collapsed" />
                    <Border x:Name="Outline" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Kd.Accent}" Opacity="0" />
                    <Border x:Name="Found" CornerRadius="5" Background="{DynamicResource Kd.Accent}" Opacity="0" IsHitTestVisible="False" />
                    <Grid Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="{DynamicResource Qm.IconSize}" Height="{DynamicResource Qm.IconSize}" Margin="0,0,10,0" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToCollapsed}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="280"
                                       Foreground="{DynamicResource Kd.MenuText}"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibleInv}}" />
                            <TextBox x:Name="RenameBox" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Padding="4,1"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToCollapsed}}"
                                     KeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisible" />
                        </StackPanel>
                        <Path x:Name="Chevron" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Data="M0,0 L4,4 L0,8"
                              Stroke="{DynamicResource Kd.MenuTextSecondary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToCollapsed}}" />
                    </Grid>
                </Grid>

                <!-- drop indicators -->
                <Border x:Name="DropInto" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Kd.Accent}"
                        Background="{DynamicResource Kd.AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="DropBefore" Height="3" CornerRadius="1.5" VerticalAlignment="Top" Margin="4,-2,4,0"
                        Background="{DynamicResource Kd.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="DropAfter" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="4,0,4,-2"
                        Background="{DynamicResource Kd.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="Sep" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Content" Property="Height" Value="11" />
                    <Setter TargetName="Content" Property="Opacity" Value="0.01" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTitle}" Value="True">
                    <Setter TargetName="TitleBand" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kd.Danger}" />
                    <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisabledCommand}" Value="True">
                    <Setter TargetName="Content" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Kd.MenuHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Kd.MenuHover}" />
                    <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Kd.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Outline" Property="Opacity" Value="1" />
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFound}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard BeginTime="0:0:0.25">
                                <DoubleAnimation Storyboard.TargetName="Found" Storyboard.TargetProperty="Opacity" From="0" To="0.45"
                                                 Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="3x" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropHint}" Value="Before">
                    <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DropHint}" Value="After">
                    <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DropHint}" Value="Into">
                    <Setter TargetName="DropInto" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── A column (menu level) ────────────────────────────────── -->
        <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type qe:QmColumn}">
            <StackPanel Margin="0,0,14,0" VerticalAlignment="Top" Loaded="OnColumnLoaded">
                <TextBlock Text="{Binding Title}" Margin="6,0,0,6" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                <Border x:Name="Surface" CornerRadius="8" Padding="4" MinWidth="230" MinHeight="44" AllowDrop="True"
                        Background="{DynamicResource Kd.MenuTintOpaque}" BorderBrush="{DynamicResource Kd.MenuBorder}" BorderThickness="1"
                        DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop" MouseRightButtonUp="OnColumnRightClick"
                        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="{DynamicResource Qm.FontSize}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.22" />
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="{l:Tr qm.dropHere}" Margin="12,10" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsed}}" />
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                    </Grid>
                </Border>
                <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left" Appearance="Transparent" Icon="{ui:SymbolIcon Add24}"
                           Content="{l:Tr common.add}" Click="OnColumnAdd" Tag="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav.quickmenus}" Margin="0,0,0,14" />

        <!-- ── Toolbar ───────────────────────────────────────────────── -->
        <WrapPanel Grid.Row="1" Margin="0,0,24,12">
            <ComboBox x:Name="MenuBox" Width="240" DisplayMemberPath="Name" SelectionChanged="OnMenuSelected" Margin="0,0,6,6" />
            <ui:Button Icon="{ui:SymbolIcon Add24}" ToolTip="{l:Tr qm.newMenu}" Click="OnNewMenu" Margin="0,0,6,6" />
            <ui:Button Icon="{ui:SymbolIcon Rename24}" ToolTip="{l:Tr qm.renameMenu}" Click="OnRenameMenu" Margin="0,0,6,6" />
            <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:Tr qm.duplicateMenu}" Click="OnDuplicateMenu" Margin="0,0,6,6" />
            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Tr qm.deleteMenu}" Click="OnDeleteMenu" Margin="0,0,18,6" />

            <TextBlock Text="{l:Tr qm.size}" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="SizeBox" Width="80" SelectionChanged="OnSizeChanged" Margin="0,0,18,6" />

            <ui:Button x:Name="UndoButton" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="{l:Tr qm.undo}" Click="OnUndo" Margin="0,0,6,6" IsEnabled="False" />
            <ui:Button x:Name="RedoButton" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="{l:Tr qm.redo}" Click="OnRedo" Margin="0,0,18,6" IsEnabled="False" />

            <ui:Button Content="{l:Tr qm.test}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Click="OnTest" Margin="0,0,6,6" />
        </WrapPanel>

        <!-- ── Body ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Canvas -->
            <Border CornerRadius="8" Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    AllowDrop="True" DragOver="OnCanvasDragOver" Drop="OnCanvasDrop">
                <ScrollViewer x:Name="Canvas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="18" Focusable="True"
                              MouseLeftButtonDown="OnCanvasClick">
                    <ItemsControl x:Name="ColumnsControl" ItemTemplate="{StaticResource ColumnTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Palette -->
            <DockPanel Grid.Column="1" Margin="14,0,24,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr qm.palette}" Margin="2,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Border x:Name="NewSubmenuChip" Style="{StaticResource Chip}" Padding="10,5" Cursor="SizeAll" Tag="Submenu"
                                PreviewMouseLeftButtonDown="OnChipMouseDown" PreviewMouseMove="OnChipMouseMove">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource ChipText}" Text="{l:Tr qm.kind.Submenu}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Padding="10,5" Cursor="SizeAll" Tag="Title"
                                PreviewMouseLeftButtonDown="OnChipMouseDown" PreviewMouseMove="OnChipMouseMove">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextHeader124" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource ChipText}" Text="{l:Tr qm.kind.Title}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Padding="10,5" Cursor="SizeAll" Tag="Separator"
                                PreviewMouseLeftButtonDown="OnChipMouseDown" PreviewMouseMove="OnChipMouseMove">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SplitHorizontal24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource ChipText}" Text="{l:Tr qm.kind.Separator}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <ui:Button Content="{l:Tr qm.quickCommand}" Icon="{ui:SymbolIcon DocumentAdd24}" HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="OnQuickCommand" />
                    <ui:TextBox x:Name="PaletteSearch" PlaceholderText="{l:Tr commands.search}" Icon="{ui:SymbolIcon Search24}" TextChanged="OnPaletteSearch" Margin="0,0,0,8" />
                </StackPanel>
                <ListBox x:Name="Palette" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}"
                         PreviewMouseLeftButtonDown="OnPaletteMouseDown" PreviewMouseMove="OnPaletteMouseMove" MouseDoubleClick="OnPaletteDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource CommandIcon}">
                                            <Binding />
                                            <Binding Path="(s:IconProvider.Revision)" />
                                            <Binding Path="Icon" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="2,10,24,16" Text="{l:Tr qm.editorHint}" />
    </Grid>
</UserControl>
