<UserControl x:Class="KDesktop.Views.Pages.AssistantVoiceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Options → Assistant → Voice (stage 5.4; DataContext: the settings, from the options page) -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr assistantVoice.title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{l:Tr assistantVoice.intro}" />

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.engine}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.engineHint}" />
                </StackPanel>
                <ComboBox x:Name="EngineBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnEngineChanged" AutomationProperties.Name="{l:Tr assistantVoice.engine}" />
            </Grid>

            <!-- Which voice really speaks now -->
            <Border Style="{StaticResource InfoBox}" Margin="0,4,0,8">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonVoice24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                    <TextBlock x:Name="StateText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Pocket TTS: the natural voice, downloaded for the language -->
            <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="Pocket TTS" />
            <TextBlock x:Name="PocketText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button x:Name="DownloadButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnDownload" />
                <ui:Button x:Name="CancelButton" Margin="8,0,0,0" Content="{l:Tr common.cancel}" Click="OnCancelDownload" />
                <ui:Button x:Name="DeleteButton" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="{l:Tr assistantVoice.delete}" Click="OnDelete" />
            </StackPanel>
            <ProgressBar x:Name="DownloadBar" Height="4" Margin="0,10,0,0" Maximum="1" />

            <Grid Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.pocketVoice}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.pocketVoiceHint}" />
                </StackPanel>
                <ComboBox x:Name="PocketVoiceBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnPocketVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.pocketVoice}" />
            </Grid>

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.windowsVoice}" />
                    <TextBlock x:Name="WindowsHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.windowsVoiceHint}" />
                </StackPanel>
                <ComboBox x:Name="WindowsVoiceBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnWindowsVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.windowsVoice}" />
            </Grid>

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr assistantVoice.speed}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Margin="0,0,14,0" Minimum="0.5" Maximum="2" Value="{Binding AssistantVoiceSpeed}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            SmallChange="0.05" LargeChange="0.25" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr assistantVoice.speed}" />
                    <TextBlock Grid.Column="1" MinWidth="44" TextAlignment="Right" Text="{Binding AssistantVoiceSpeed, StringFormat={}{0:0.00}×}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr assistantVoice.volume}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Margin="0,0,14,0" Minimum="0" Maximum="100" Value="{Binding AssistantVoiceVolume}" TickFrequency="5" IsSnapToTickEnabled="True"
                            SmallChange="5" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr assistantVoice.volume}" />
                    <TextBlock Grid.Column="1" MinWidth="44" TextAlignment="Right" Text="{Binding AssistantVoiceVolume, StringFormat={}{0} %}" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Test it -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TestBox" PlaceholderText="{l:Tr assistantVoice.testPlaceholder}" KeyDown="OnTestKey"
                            AutomationProperties.Name="{l:Tr assistantVoice.testPlaceholder}" />
                <ui:Button x:Name="TestButton" Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon Play24}" Content="{l:Tr assistantVoice.test}" Click="OnTest" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
