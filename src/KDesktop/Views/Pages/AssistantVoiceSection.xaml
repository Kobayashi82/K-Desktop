<UserControl x:Class="KDesktop.Views.Pages.AssistantVoiceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Options → Assistant → Voice (stages 5.4–5.6; DataContext: the settings, from the options page). Two pages of one control
         (5.0.279, «Part»): «speech», how they speak (engine, profile, speed, volume, test, when), and «speech/voices», the voices of
         each engine (Kokoro and Piper downloaded here, the user's folders, Windows' voices). -->
    <StackPanel>
    <Border x:Name="GeneralCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr assistantVoice.title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{l:Tr assistantVoice.intro}" />

            <!-- The language they speak in, whatever you speak to them in: the voices offered are of it (5.0.280: from General) -->
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.language}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantOptions.languageHint}" />
                </StackPanel>
                <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnLanguageChanged" AutomationProperties.Name="{l:Tr assistantOptions.language}" />
            </Grid>

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.engine}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.engineHint}" />
                </StackPanel>
                <ComboBox x:Name="EngineBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnEngineChanged" AutomationProperties.Name="{l:Tr assistantVoice.engine}" />
            </Grid>

            <!-- Profile, speed, volume and the test: only while they speak (not with «No hablar») -->
            <Grid x:Name="ProfileRow" Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.profile}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.profileHint}" />
                </StackPanel>
                <ComboBox x:Name="ProfileBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnProfileChanged" AutomationProperties.Name="{l:Tr assistantVoice.profile}" />
            </Grid>

            <!-- Which voice really speaks now -->
            <Border Style="{StaticResource InfoBox}" Margin="0,4,0,8">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonVoice24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
                    <TextBlock x:Name="StateText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="SpeedRow" Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr assistantVoice.speed}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Margin="0,0,14,0" Minimum="0.5" Maximum="2" Value="{Binding AssistantVoiceSpeed}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            SmallChange="0.05" LargeChange="0.25" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr assistantVoice.speed}" />
                    <TextBlock Grid.Column="1" MinWidth="44" TextAlignment="Right" Text="{Binding AssistantVoiceSpeed, StringFormat={}{0:0.00}×}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid x:Name="VolumeRow" Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr assistantVoice.volume}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Margin="0,0,14,0" Minimum="0" Maximum="100" Value="{Binding AssistantVoiceVolume}" TickFrequency="5" IsSnapToTickEnabled="True"
                            SmallChange="5" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr assistantVoice.volume}" />
                    <TextBlock Grid.Column="1" MinWidth="44" TextAlignment="Right" Text="{Binding AssistantVoiceVolume, StringFormat={}{0} %}" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Test it: who says it and in which mood (stage 5.6); not when they do not speak -->
            <StackPanel x:Name="TestBlock">
            <TextBlock Margin="0,16,0,2" FontWeight="SemiBold" Text="{l:Tr assistantVoice.testTitle}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TestBox" PlaceholderText="{l:Tr assistantVoice.testPlaceholder}" KeyDown="OnTestKey"
                            AutomationProperties.Name="{l:Tr assistantVoice.testPlaceholder}" />
                <ui:Button MinHeight="36" x:Name="TestButton" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Play24}" Content="{l:Tr assistantVoice.test}" Click="OnTest" />
                <ui:Button x:Name="StopButton" Grid.Column="2" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Stretch" Click="OnStopTest"
                           ToolTip="{l:Tr assistantVoice.testStop}" AutomationProperties.Name="{l:Tr assistantVoice.testStop}">
                    <ui:SymbolIcon Symbol="RecordStop24" FontSize="16" />
                </ui:Button>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4" Text="{l:Tr assistantVoice.testWho}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Margin="0,0,0,4" Text="{l:Tr assistantVoice.testMood}" />
                <ComboBox x:Name="WhoBox" Grid.Row="1" DisplayMemberPath="Name" AutomationProperties.Name="{l:Tr assistantVoice.testWho}" />
                <ComboBox x:Name="MoodBox" Grid.Row="1" Grid.Column="2" DisplayMemberPath="Name" AutomationProperties.Name="{l:Tr assistantVoice.testMood}" />
            </Grid>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- When they speak aloud (stage 5.6) -->
    <Border x:Name="WhenCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr assistantVoice.whenTitle}" />

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.fullscreen}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.fullscreenHint}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AssistantVoiceFullscreen}" AutomationProperties.Name="{l:Tr assistantVoice.fullscreen}" />
            </Grid>

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.night}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.nightHint}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AssistantVoiceNight}" AutomationProperties.Name="{l:Tr assistantVoice.night}" />
            </Grid>

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.pan}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.panHint}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AssistantVoicePan}" AutomationProperties.Name="{l:Tr assistantVoice.pan}" />
            </Grid>
        </StackPanel>
    </Border>

    <!-- Kokoro: the natural voice, downloaded once (espeak-ng apart for the languages that need it) -->
    <Border x:Name="KokoroCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Kokoro" />
            <TextBlock x:Name="KokoroText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <TextBlock x:Name="EspeakText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel x:Name="DownloadRow" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button MinHeight="36" x:Name="DownloadButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnDownload" />
                <ui:Button MinHeight="36" x:Name="CancelButton" Margin="8,0,0,0" Content="{l:Tr common.cancel}" Click="OnCancelDownload" />
                <ui:Button MinHeight="36" x:Name="DeleteButton" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="{l:Tr assistantVoice.delete}" Click="OnDelete" />
            </StackPanel>
            <ProgressBar x:Name="DownloadBar" Height="4" Margin="0,10,0,0" Maximum="1" />

            <!-- 5.0.282: folders with the user's own Kokoro voices (.pt or .bin; they count as downloaded, nothing there is touched) -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.piperFolders}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.kokoroFoldersHint}" />
                </StackPanel>
                <ui:Button Appearance="Primary" MinHeight="36" Grid.Column="1" VerticalAlignment="Center" Icon="{ui:SymbolIcon FolderAdd24}" Content="{l:Tr assistantVoice.piperAddFolder}" Click="OnKokoroAddFolder" />
            </Grid>
            <StackPanel x:Name="KokoroFolderRows" Margin="0,6,0,0" />

            <StackPanel x:Name="KokoroVoices">
                <Grid Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr assistantVoice.kokoroVoice}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.kokoroVoiceHint}" />
                    </StackPanel>
                    <ComboBox x:Name="KokoroVoiceBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                              SelectionChanged="OnKokoroVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.kokoroVoice}" />
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr assistantVoice.mixWith}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.mixWithHint}" />
                    </StackPanel>
                    <ComboBox x:Name="MixVoiceBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                              SelectionChanged="OnKokoroVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.mixWith}" />
                </Grid>
                <Grid x:Name="MixRow" Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MixLabel" VerticalAlignment="Center" Margin="0,0,24,0" TextWrapping="Wrap" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Slider x:Name="MixSlider" Margin="0,0,14,0" Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True"
                                SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="OnMixChanged"
                                AutomationProperties.Name="{l:Tr assistantVoice.mixShare}" />
                        <TextBlock x:Name="MixValue" Grid.Column="1" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </StackPanel>
            <!-- Hear it: the test sentence with this voice, plain (5.0.280) -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button MinHeight="36" x:Name="KokoroTestButton" Tag="kokoro" Icon="{ui:SymbolIcon Play24}" Content="{l:Tr assistantVoice.testVoice}" Click="OnTestEngine" />
                <ui:Button Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Stretch" Click="OnStopTest" ToolTip="{l:Tr assistantVoice.testStop}"
                           AutomationProperties.Name="{l:Tr assistantVoice.testStop}">
                    <ui:SymbolIcon Symbol="RecordStop24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Piper: a model per voice, downloaded when chosen (5.0.110); it needs espeak-ng, shared with Kokoro -->
    <Border x:Name="PiperCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Piper" />
            <TextBlock x:Name="PiperText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <TextBlock x:Name="PiperNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr assistantVoice.piperNote}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button MinHeight="36" x:Name="PiperDownloadButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnPiperDownload" />
                <ui:Button MinHeight="36" x:Name="PiperCancelButton" Margin="8,0,0,0" Content="{l:Tr common.cancel}" Click="OnPiperCancel" />
                <ui:Button MinHeight="36" x:Name="PiperDeleteButton" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="{l:Tr assistantVoice.delete}" Click="OnPiperDelete" />
                <ui:Button MinHeight="36" x:Name="PiperDeleteOthersButton" Margin="8,0,0,0" Icon="{ui:SymbolIcon Broom24}" Click="OnPiperDeleteOthers" />
            </StackPanel>
            <ProgressBar x:Name="PiperBar" Height="4" Margin="0,10,0,0" Maximum="1" />

            <!-- Stage 12: folders with the user's own voices (they count as downloaded; nothing there is downloaded or deleted) -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.piperFolders}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.piperFoldersHint}" />
                </StackPanel>
                <ui:Button Appearance="Primary" MinHeight="36" Grid.Column="1" VerticalAlignment="Center" Icon="{ui:SymbolIcon FolderAdd24}" Content="{l:Tr assistantVoice.piperAddFolder}" Click="OnPiperAddFolder" />
            </Grid>
            <StackPanel x:Name="PiperFolderRows" Margin="0,6,0,0" />

            <Grid Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.piperVoice}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.piperVoiceHint}" />
                </StackPanel>
                <ComboBox x:Name="PiperVoiceBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnPiperVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.piperVoice}" />
            </Grid>
            <Grid x:Name="PiperSpeakerRow" Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.piperSpeaker}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.piperSpeakerHint}" />
                </StackPanel>
                <ComboBox x:Name="PiperSpeakerBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnPiperVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.piperSpeaker}" />
            </Grid>
            <!-- Hear it: the test sentence with this voice, plain (5.0.280) -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button MinHeight="36" x:Name="PiperTestButton" Tag="piper" Icon="{ui:SymbolIcon Play24}" Content="{l:Tr assistantVoice.testVoice}" Click="OnTestEngine" />
                <ui:Button Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Stretch" Click="OnStopTest" ToolTip="{l:Tr assistantVoice.testStop}"
                           AutomationProperties.Name="{l:Tr assistantVoice.testStop}">
                    <ui:SymbolIcon Symbol="RecordStop24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- The voices Windows has -->
    <Border x:Name="WindowsCard" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr assistantVoice.windowsTitle}" />
            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantVoice.windowsVoice}" />
                    <TextBlock x:Name="WindowsHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantVoice.windowsVoiceHint}" />
                </StackPanel>
                <ComboBox x:Name="WindowsVoiceBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnWindowsVoiceChanged" AutomationProperties.Name="{l:Tr assistantVoice.windowsVoice}" />
            </Grid>
            <!-- Hear it: the test sentence with this voice, plain (5.0.280) -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button MinHeight="36" x:Name="WindowsTestButton" Tag="windows" Icon="{ui:SymbolIcon Play24}" Content="{l:Tr assistantVoice.testVoice}" Click="OnTestEngine" />
                <ui:Button Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Stretch" Click="OnStopTest" ToolTip="{l:Tr assistantVoice.testStop}"
                           AutomationProperties.Name="{l:Tr assistantVoice.testStop}">
                    <ui:SymbolIcon Symbol="RecordStop24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Border>
    </StackPanel>
</UserControl>
