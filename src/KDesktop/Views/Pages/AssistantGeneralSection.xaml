<UserControl x:Class="KDesktop.Views.Pages.AssistantGeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- Options → Assistant → General (DataContext: the settings, from the options page) -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr assistantOptions.general}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:Tr assistantOptions.intro}" />

            <Grid Style="{StaticResource SettingRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.enable}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr assistantOptions.enableHint}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AssistantEnabled}" AutomationProperties.Name="{l:Tr assistantOptions.enable}" />
            </Grid>

            <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AssistantEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.sound}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Tr assistantOptions.soundHint}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AssistantSound}" AutomationProperties.Name="{l:Tr assistantOptions.sound}" />
            </Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource SettingRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AssistantEnabled}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            <DataTrigger Binding="{Binding AssistantSound}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,24,0" Text="{l:Tr assistantOptions.volume}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Margin="0,0,14,0" Minimum="0" Maximum="100" Value="{Binding AssistantVolume}" TickFrequency="5" IsSnapToTickEnabled="True"
                            SmallChange="5" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr assistantOptions.volume}" />
                    <TextBlock Grid.Column="1" MinWidth="40" TextAlignment="Right" Text="{Binding AssistantVolume, StringFormat={}{0} %}" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- The word «for the assistant»: to whoever answers what is not addressed to anyone (stage 5.1) -->
            <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AssistantEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.anyWake}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantOptions.anyWakeHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="AnyWakeBox" MinWidth="190" MaxWidth="260" VerticalAlignment="Center" DisplayMemberPath="Name"
                              SelectionChanged="OnAnyWakeChanged" AutomationProperties.Name="{l:Tr assistantOptions.anyWake}" />
                    <ui:Button Margin="6,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon Record24}" Click="OnRecordAnyWake"
                               ToolTip="{l:Tr assistantOptions.wakeRecord}" AutomationProperties.Name="{l:Tr assistantOptions.wakeRecord}" />
                </StackPanel>
            </Grid>

            <!-- Hold to talk to the assistant (stage 5.2) -->
            <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AssistantEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.talkKey}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantOptions.talkKeyHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="TalkKeyButton" MinWidth="200" Click="OnCaptureTalkKey" AutomationProperties.Name="{l:Tr assistantOptions.talkKey}" />
                    <ui:Button x:Name="TalkKeyClear" Margin="8,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:Tr common.remove}"
                               AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearTalkKey" />
                </StackPanel>
            </Grid>

            <!-- How orders are shown (stage 6.7) -->
            <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AssistantEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.manoeuvres}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantOptions.manoeuvresHint}" />
                </StackPanel>
                <ComboBox x:Name="ManoeuvresBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnManoeuvresChanged" AutomationProperties.Name="{l:Tr assistantOptions.manoeuvres}" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AssistantEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.animate}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantOptions.animateHint}" />
                </StackPanel>
                <ComboBox x:Name="AnimateBox" Grid.Column="1" MinWidth="230" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="OnAnimateChanged" AutomationProperties.Name="{l:Tr assistantOptions.animate}" />
            </Grid>
            <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AssistantEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{l:Tr assistantOptions.adorn}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr assistantOptions.adornHint}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AssistantAdorn}" AutomationProperties.Name="{l:Tr assistantOptions.adorn}" />
            </Grid>

            <!-- How the module is doing, with a way to the panel -->
            <Border x:Name="StatePanel" Style="{StaticResource InfoBox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="2,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StateText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button x:Name="PanelButton" Grid.Column="2" Margin="12,0,0,0" Content="{l:Tr assistantOptions.openPanel}"
                               Icon="{ui:SymbolIcon Bot24}" Click="OnOpenPanel" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
