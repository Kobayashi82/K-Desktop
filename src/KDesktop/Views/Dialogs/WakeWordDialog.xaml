<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.WakeWordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="560" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <!-- Microphone level -->
        <Style x:Key="Meter" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Time left of a fixed recording: only while it records -->
        <Style x:Key="TimeBar" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Result" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel Margin="24,0,24,20">
        <ui:TitleBar x:Name="TitleBarControl" Title="{l:Tr wake.title}" ShowMinimize="False" ShowMaximize="False" Margin="-24,0,-24,4" />

        <!-- Steps -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StepTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel x:Name="StepDots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="StepHost" MinHeight="250">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StepShift" />
            </Grid.RenderTransform>

            <!-- 0 · Name -->
            <StackPanel x:Name="Step0">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr wake.nameText}" />
                <ui:TextBox x:Name="NameBox" Margin="0,14,0,0" FontSize="16" PlaceholderText="{l:Tr wake.namePlaceholder}" TextChanged="OnNameChanged" />
                <TextBlock Style="{StaticResource Result}" Text="{l:Tr wake.nameTips}" />
                <TextBlock x:Name="MicText" Style="{StaticResource Result}" />
            </StackPanel>

            <!-- 1 · Silence -->
            <StackPanel x:Name="Step1" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr wake.silenceText}" />
                <ui:Button x:Name="SilenceButton" Margin="0,16,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Record24}" Content="{l:Tr wake.start}" Click="OnSilence" />
                <ProgressBar x:Name="SilenceTime" Style="{StaticResource TimeBar}" />
                <Grid Margin="0,12,0,0" ToolTip="{l:Tr wake.level}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Mic24" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ProgressBar x:Name="SilenceLevel" Grid.Column="1" Style="{StaticResource Meter}" />
                </Grid>
                <TextBlock x:Name="SilenceResult" Style="{StaticResource Result}" />
            </StackPanel>

            <!-- 2 · The word, several times -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock x:Name="WordText" Style="{StaticResource StepText}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button x:Name="RecordButton" Appearance="Primary" Icon="{ui:SymbolIcon Mic24}" Click="OnRecordTake" />
                    <TextBlock x:Name="TakeCount" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                </StackPanel>
                <Grid Margin="0,12,0,0" ToolTip="{l:Tr wake.level}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Mic24" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ProgressBar x:Name="WordLevel" Grid.Column="1" Style="{StaticResource Meter}" />
                </Grid>
                <ItemsControl x:Name="TakeList" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{Binding Brush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="4" ToolTip="{l:Tr common.remove}"
                                           Click="OnRemoveTake" Visibility="{Binding RemoveVisibility}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 3 · Normal speech -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr wake.speechText}" />
                <Border Style="{StaticResource InfoBox}" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Caption}" FontStyle="Italic" Text="{l:Tr wake.speechSample}" />
                </Border>
                <ui:Button x:Name="SpeechButton" Margin="0,14,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Record24}" Content="{l:Tr wake.start}" Click="OnSpeech" />
                <ProgressBar x:Name="SpeechTime" Style="{StaticResource TimeBar}" />
                <Grid Margin="0,12,0,0" ToolTip="{l:Tr wake.level}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Mic24" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ProgressBar x:Name="SpeechLevel" Grid.Column="1" Style="{StaticResource Meter}" />
                </Grid>
                <TextBlock x:Name="SpeechResult" Style="{StaticResource Result}" />
            </StackPanel>

            <!-- 4 · Try it -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <TextBlock x:Name="TestText" Style="{StaticResource StepText}" />
                <ui:Button x:Name="TestButton" Margin="0,16,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Mic24}" Content="{l:Tr wake.test}" Click="OnTest" />
                <Grid Margin="0,12,0,0" ToolTip="{l:Tr wake.level}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Mic24" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ProgressBar x:Name="TestLevel" Grid.Column="1" Style="{StaticResource Meter}" />
                </Grid>
                <Border x:Name="TestCard" Margin="0,14,0,0" Padding="14,12" CornerRadius="8" Visibility="Collapsed"
                        Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="TestIcon" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TestVerdict" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TestDetail" Margin="0,3,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Kd.Warning}" Visibility="Collapsed" />

        <!-- Footer -->
        <Grid Margin="0,18,0,0">
            <ui:Button x:Name="CancelButton" HorizontalAlignment="Left" Content="{l:Tr common.cancel}" Click="OnCancel" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BackButton" Content="{l:Tr wake.back}" Icon="{ui:SymbolIcon ArrowLeft24}" Click="OnBack" Margin="0,0,8,0" />
                <ui:Button x:Name="NextButton" Appearance="Primary" Click="OnNext" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:FluentWindow>
