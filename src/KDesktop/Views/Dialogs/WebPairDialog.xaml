<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.WebPairDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="440" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <StackPanel Margin="24,0,24,20">
        <ui:TitleBar Title="{l:Tr web.pairTitle}" ShowMinimize="False" ShowMaximize="False" Margin="-24,0,-24,4" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr web.pairHint}" />

        <Border x:Name="QrCard" Margin="0,16,0,0" HorizontalAlignment="Center" Background="White" CornerRadius="14" Padding="14"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="QrScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
            <Image x:Name="QrImage" Width="236" Height="236" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock x:Name="CodeText" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold"
                   FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Kd.AccentText}" />
        <TextBlock x:Name="UrlText" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource Caption}" />
        <TextBlock x:Name="WarnText" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                   FontSize="12" Foreground="{DynamicResource Kd.Warning}" />

        <ProgressBar x:Name="TimeBar" Margin="0,16,0,0" Height="4" Minimum="0" Maximum="1" Value="1" />
        <TextBlock x:Name="TimeText" Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="{l:Tr web.newCode}" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnNewCode" Margin="0,0,8,0" />
            <ui:Button Content="{l:Tr common.close}" Appearance="Primary" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
