<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.SubscriptionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="540" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <!-- A .ics subscription, new or to change (Opciones › Calendario): its name, its address and how often it is read. -->
    <StackPanel Margin="20,0,20,20">
        <ui:TitleBar x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{l:Tr calendars.subscriptionsIntro}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr calendars.name}" />
        <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" PlaceholderText="{l:Tr calendars.subscriptionName}" ClearButtonEnabled="False" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr calendars.url}" />
        <ui:TextBox x:Name="UrlBox" Margin="0,0,0,4" PlaceholderText="webcal://… · https://….ics" ClearButtonEnabled="False" />
        <TextBlock x:Name="GuideLine" Margin="0,0,0,12" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr calendars.refresh}" />
        <ComboBox x:Name="EveryBox" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Value" HorizontalAlignment="Stretch" />

        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Kd.Danger}" Visibility="Collapsed" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
            <ui:Button x:Name="SaveButton" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
