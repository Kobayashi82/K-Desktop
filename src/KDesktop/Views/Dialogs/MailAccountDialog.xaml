<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.MailAccountDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="620" SizeToContent="Height" MaxHeight="860"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <!-- A mail account (Opciones › Correo): address, how it signs in, servers, what for and what is told; «Probar» signs in
         to IMAP and SMTP. The form is made in code. -->
    <DockPanel Margin="20,0,20,20">
        <ui:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <Grid>
                <ui:Button x:Name="TestButton" HorizontalAlignment="Left" Icon="{ui:SymbolIcon PlugConnected24}" Content="{l:Tr mailOptions.test}" Click="OnTest" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
                    <ui:Button Content="{l:Tr agenda.save}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="OnSave" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel x:Name="Form" />
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
