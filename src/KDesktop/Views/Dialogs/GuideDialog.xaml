<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.GuideDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="600" SizeToContent="Height" MaxHeight="820"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <!-- Step-by-step guide for something done once outside K-Desktop (an app of Google, an app password, a
         secret .ics address): numbered steps, each with its page and what to paste there. The steps are made in code. -->
    <DockPanel Margin="20,0,20,20">
        <ui:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />
        <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0" Content="{l:Tr common.close}" Appearance="Primary" IsDefault="True" IsCancel="True" Click="OnClose" />
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel x:Name="Steps" />
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
