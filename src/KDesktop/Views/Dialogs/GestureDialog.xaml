<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.GestureDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="640" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <!-- A drawing to choose: as the tiles of Options (OsdTile / PickTile), the drawing in its colour, gold when chosen -->
        <Style x:Key="GestureTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="4,8,4,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Kd.OsdTrack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Kd.OsdTrack}" Background="{DynamicResource Kd.Subtle}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kd.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Kd.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel Margin="24,0,24,20">
        <ui:TitleBar Title="{l:Tr commands.addGesture}" ShowMinimize="False" ShowMaximize="False" Margin="-24,0,-24,4" />
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14" />

        <!-- The built-in drawings and the user's -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr gesture.builtIn}" />
        <WrapPanel x:Name="BuiltInTiles" Margin="0,2,-8,6" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr gesture.mine}" />
        <WrapPanel x:Name="MineTiles" Margin="0,2,-8,6">
            <ui:Button x:Name="NewButton" Width="88" Height="80" Margin="0,0,8,8" Click="OnNew" AutomationProperties.Name="{l:Tr gesture.new}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Add24" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="{l:Tr gesture.new}" />
                </StackPanel>
            </ui:Button>
        </WrapPanel>

        <!-- Drawing one of the user's: its name and how many times it has been drawn -->
        <StackPanel x:Name="TeachPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <ui:TextBox x:Name="NameBox" PlaceholderText="{l:Tr gesture.newName}" MaxLength="24" TextChanged="OnNameChanged" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TeachText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock x:Name="TeachCount" Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
            </Grid>
        </StackPanel>

        <!-- Where to try a drawing (or to teach one): with the left button -->
        <Border x:Name="Pad" Height="190" Margin="0,10,0,0" CornerRadius="8" BorderThickness="1" ClipToBounds="True" Cursor="Pen"
                Background="{DynamicResource Kd.Subtle}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                MouseLeftButtonDown="OnPadDown" MouseMove="OnPadMove" MouseLeftButtonUp="OnPadUp" LostMouseCapture="OnPadLost">
            <Grid>
                <TextBlock x:Name="PadHint" Style="{StaticResource Caption}" Margin="24,0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Text="{l:Tr gesture.pad}" />
                <Canvas x:Name="PadCanvas" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <TextBlock x:Name="ResultText" Style="{StaticResource Caption}" Margin="0,8,0,0" MinHeight="16" />

        <!-- Footer -->
        <Grid Margin="0,14,0,0">
            <ui:Button x:Name="CancelButton" HorizontalAlignment="Left" Content="{l:Tr common.cancel}" Click="OnCancel" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="SaveButton" Content="{l:Tr gesture.save}" Icon="{ui:SymbolIcon Save24}" Click="OnSave" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" />
                <ui:Button x:Name="AcceptButton" Content="{l:Tr common.accept}" Appearance="Primary" Click="OnAccept" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:FluentWindow>
