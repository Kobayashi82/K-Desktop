<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.CommandPicker"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 xmlns:v="clr-namespace:KDesktop.Views"
                 xmlns:s="clr-namespace:KDesktop.Services"
                 Title="K-Desktop"
                 Width="460" Height="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <v:CommandIconConverter x:Key="CommandIcon" />
    </ui:FluentWindow.Resources>
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="{l:Tr qm.pickCommand}" ShowMinimize="False" ShowMaximize="False" Margin="-16,0,-16,0" />
        <Grid Grid.Row="1" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:Tr commands.search}" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="OnSearch" PreviewKeyDown="OnSearchKey" />
            <!-- The hidden ones too, as in Comandos -->
            <ToggleButton x:Name="ShowHiddenToggle" Grid.Column="1" Margin="8,0,0,0" Padding="9,6" VerticalAlignment="Stretch" ToolTip="{l:Tr commands.showHidden}"
                          AutomationProperties.Name="{l:Tr commands.showHidden}" Checked="OnShowHidden" Unchecked="OnShowHidden">
                <ui:SymbolIcon>
                    <!-- Checked, the button turns accent-coloured: the icon goes dark on it to stay visible -->
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="EyeOff24" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                    <Setter Property="Symbol" Value="Eye24" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </ToggleButton>
        </Grid>
        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}"
                 MouseDoubleClick="OnAccept" KeyDown="OnListKey">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource CommandIcon}">
                                    <Binding />
                                    <Binding Path="(s:IconProvider.Revision)" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- «Nuevo comando», only where a new one can be made right away (events): instead of picking one -->
        <ui:Button x:Name="NewButton" Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                   Content="{l:Tr event.newCommand}" Icon="{ui:SymbolIcon DocumentAdd24}" ToolTip="{l:Tr event.newCommandHint}" Click="OnNew" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
            <ui:Button x:Name="AcceptButton" Content="{l:Tr common.add}" Appearance="Primary" Click="OnAccept" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
