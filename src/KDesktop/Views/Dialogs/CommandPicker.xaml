<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.CommandPicker"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 xmlns:v="clr-namespace:KDesktop.Views"
                 Title="K-Desktop"
                 Width="460" Height="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <v:CommandIconConverter x:Key="CommandIcon" />
    </ui:FluentWindow.Resources>
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{l:Tr qm.pickCommand}" ShowMinimize="False" ShowMaximize="False" Margin="-16,0,-16,0" />
        <ui:TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,4,0,10" PlaceholderText="{l:Tr commands.search}" Icon="{ui:SymbolIcon Search24}"
                    TextChanged="OnSearch" PreviewKeyDown="OnSearchKey" />
        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource CleanListBox}" ItemContainerStyle="{StaticResource RowItem}"
                 MouseDoubleClick="OnAccept" KeyDown="OnListKey">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource CommandIcon}">
                                    <Binding />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
            <ui:Button Content="{l:Tr common.add}" Appearance="Primary" Click="OnAccept" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
