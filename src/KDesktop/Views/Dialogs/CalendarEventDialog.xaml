<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.CalendarEventDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:KDesktop.Views"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="620" SizeToContent="Height" MaxHeight="900"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <DockPanel Margin="20,0,20,20">
        <ui:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" Title="{l:Tr agenda.dialogNew}" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />

        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <ui:Button x:Name="DeleteButton" HorizontalAlignment="Left" Icon="{ui:SymbolIcon Delete24}" Content="{l:Tr common.delete}"
                       Foreground="{DynamicResource Kd.Danger}" Click="OnDelete" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
                <ui:Button x:Name="SaveButton" Content="{l:Tr agenda.save}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Form">
                <Border x:Name="ReadOnlyBox" Style="{StaticResource InfoBox}" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ReadOnlyText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.title}" />
                <ui:TextBox x:Name="TitleBox" Margin="0,0,0,12" PlaceholderText="{l:Tr agenda.field.titleHint}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.calendar}" />
                <ComboBox x:Name="CalendarBox" Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox x:Name="AllDayCheck" Content="{l:Tr agenda.field.allDay}" Margin="0,0,0,8" Checked="OnAllDayChanged" Unchecked="OnAllDayChanged" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.start}" />
                        <StackPanel Orientation="Horizontal">
                            <v:DateField x:Name="StartDate" />
                            <v:TimeField x:Name="StartTime" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.end}" />
                        <StackPanel Orientation="Horizontal">
                            <v:DateField x:Name="EndDate" />
                            <v:TimeField x:Name="EndTime" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ZoneText" Style="{StaticResource Caption}" Margin="0,-6,0,12" Visibility="Collapsed" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.repeat}" />
                <ComboBox x:Name="RepeatBox" Margin="0,0,0,8" DisplayMemberPath="Name" SelectionChanged="OnRepeatChanged" />
                <StackPanel x:Name="RepeatPanel" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{l:Tr agenda.field.every}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <v:NumberField x:Name="IntervalBox" Minimum="1" Maximum="99" Value="1" />
                        <TextBlock x:Name="IntervalUnit" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <v:WeekDaysPicker x:Name="DaysPicker" Margin="0,0,0,4" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Tr agenda.field.ends}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="EndsBox" MinWidth="160" DisplayMemberPath="Name" SelectionChanged="OnEndsChanged" />
                        <v:DateField x:Name="UntilDate" Margin="8,0,0,0" Visibility="Collapsed" />
                        <v:NumberField x:Name="CountBox" Margin="8,0,0,0" Minimum="1" Maximum="999" Value="10" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="CustomText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.reminder}" />
                <ComboBox x:Name="ReminderBox" Margin="0,0,0,12" DisplayMemberPath="Name" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.location}" />
                <ui:TextBox x:Name="LocationBox" Margin="0,0,0,12" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.meeting}" />
                <ui:TextBox x:Name="MeetingBox" Margin="0,0,0,12" PlaceholderText="https://teams.microsoft.com/…" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr agenda.field.notes}" />
                <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
