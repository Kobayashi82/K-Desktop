<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.RecurringScopeDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="420" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <!-- A cita that repeats: which appearances a change or a delete touches. -->
    <StackPanel Margin="20,0,20,20">
        <ui:TitleBar x:Name="TitleBar" Title="{l:Tr agenda.scope.change}" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />
        <RadioButton x:Name="ThisOption" Content="{l:Tr agenda.scope.this}" Margin="0,4,0,8" IsChecked="True" />
        <RadioButton x:Name="FollowingOption" Content="{l:Tr agenda.scope.following}" Margin="0,0,0,8" />
        <RadioButton x:Name="AllOption" Content="{l:Tr agenda.scope.all}" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
            <ui:Button x:Name="OkButton" Content="{l:Tr common.accept}" Appearance="Primary" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
