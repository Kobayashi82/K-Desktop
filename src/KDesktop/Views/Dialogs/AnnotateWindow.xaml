<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.AnnotateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 xmlns:d="clr-namespace:KDesktop.Views.Dialogs"
                 Title="K-Desktop"
                 Width="1000" Height="720" MinWidth="720" MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="True">
    <ui:FluentWindow.Resources>
        <!-- A tool: as the segments of the icon picker (Kd.AccentSoft when chosen) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="6" Padding="10,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colour swatch, as in the icon picker -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{l:Tr annotate.title}" ShowMinimize="False" />

        <!-- Tools, colour, thickness, undo / redo -->
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,12">
            <Border CornerRadius="6" Padding="2" Background="{DynamicResource Kd.Subtle}" VerticalAlignment="Center" Margin="0,0,16,4">
                <StackPanel x:Name="Tools" Orientation="Horizontal" />
            </Border>
            <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4" />
            <!-- The thickness, as the size of a QuickMenu: a slider and its value -->
            <TextBlock Text="{l:Tr annotate.width}" VerticalAlignment="Center" Margin="6,0,10,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="WidthSlider" Width="140" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,0,4"
                    ValueChanged="OnWidthChanged" AutomationProperties.Name="{l:Tr annotate.width}" />
            <TextBlock x:Name="WidthText" MinWidth="44" Margin="10,0,12,4" VerticalAlignment="Center" Foreground="{DynamicResource Kd.AccentText}" />
            <ui:Button x:Name="UndoButton" Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon ArrowUndo24, FontSize=18}" ToolTip="{l:Tr annotate.undo}"
                       AutomationProperties.Name="{l:Tr annotate.undo}" Click="OnUndo" IsEnabled="False" Margin="0,0,6,4" />
            <ui:Button x:Name="RedoButton" Style="{StaticResource SquareButton}" Icon="{ui:SymbolIcon ArrowRedo24, FontSize=18}" ToolTip="{l:Tr annotate.redo}"
                       AutomationProperties.Name="{l:Tr annotate.redo}" Click="OnRedo" IsEnabled="False" Margin="0,0,0,4" />
        </StackPanel>

        <!-- Size, hint and what to do with it -->
        <Grid DockPanel.Dock="Bottom" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="SizeText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="HintText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button MinHeight="34" Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
                <ui:Button x:Name="CopyButton" MinHeight="34" Content="{l:Tr annotate.copy}" Icon="{ui:SymbolIcon Copy24}" Click="OnCopy" ToolTip="Ctrl+C" Margin="0,0,8,0" />
                <ui:Button x:Name="SaveButton" MinHeight="34" Content="{l:Tr annotate.save}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="OnSave" ToolTip="Ctrl+S" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="16,0,16,0" Padding="0" ClipToBounds="True">
            <Grid>
                <d:AnnotateSurface x:Name="Surface" Focusable="True" />
                <!-- The text being written, over the picture -->
                <Canvas x:Name="TextLayer" />
            </Grid>
        </Border>
    </DockPanel>
</ui:FluentWindow>
