<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.QuickCommandDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="560" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <StackPanel Margin="20,0,20,20">
        <ui:TitleBar Title="{l:Tr qm.quickCommand}" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" Text="{l:Tr qm.quickCommandHint}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr qm.quickTarget}" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TargetBox" PlaceholderText="{l:Tr qm.quickTargetHint}" TextChanged="OnTargetChanged" />
            <ui:Button VerticalAlignment="Stretch" Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon Document24}" ToolTip="{l:Tr editor.chooseFile}" Click="OnBrowseFile" />
            <ui:Button VerticalAlignment="Stretch" Grid.Column="2" Margin="6,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.chooseFolder}" Click="OnBrowseFolder" />
        </Grid>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr qm.quickName}" />
        <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <CheckBox x:Name="AdminCheck" Content="{l:Tr editor.runAsAdmin}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
            <ui:Button Content="{l:Tr qm.create}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="OnCreate" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
