<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.TelegramContactDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="600" SizeToContent="Height" MinHeight="0" MaxHeight="820"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <!-- A Telegram contact (Opciones › Cuentas › Telegram): what they may do, whether K-Desktop may write to them, and
         the commands and tools they may use. The form is made in code. -->
    <DockPanel Margin="20,0,20,20">
        <ui:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
            <ui:Button Content="{l:Tr agenda.save}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="OnSave" IsDefault="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel x:Name="Form" />
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
