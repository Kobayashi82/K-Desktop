<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 xmlns:v="clr-namespace:KDesktop.Views"
                 Title="K-Desktop"
                 Width="680" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- A feature of «Qué es K-Desktop»: icon, name and one line -->
        <Style x:Key="Feature" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Kd.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="FeatureIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,1,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource Kd.AccentText}" />
        </Style>
        <Style x:Key="FeatureName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FeatureText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel Margin="28,0,28,22">
        <ui:TitleBar x:Name="TitleBarControl" Title="{l:Tr welcome.title}" ShowMinimize="False" ShowMaximize="False" Margin="-28,0,-28,4" />

        <!-- Step title and dots -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="StepDots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="StepHost" MinHeight="340">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StepShift" />
            </Grid.RenderTransform>

            <!-- 0 · Welcome: language and theme -->
            <StackPanel x:Name="Step0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Image x:Name="Logo" Source="pack://application:,,,/KDesktop;component/Assets/Icons/KDesktop.ico" Width="72" Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Width="480" Style="{StaticResource StepText}" Text="{l:Tr welcome.intro}" />
                </StackPanel>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr settings.language}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.languageHint}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Code"
                              AutomationProperties.Name="{l:Tr settings.language}" SelectionChanged="OnLanguageChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr settings.theme}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr settings.themeHint}" />
                    </StackPanel>
                    <WrapPanel x:Name="ThemePills" Grid.Column="1" VerticalAlignment="Center" Margin="0,6,-6,0">
                        <RadioButton Style="{StaticResource Pill}" GroupName="Theme" Tag="System" Content="{l:Tr enum.theme.System}" Checked="OnThemePicked" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Theme" Tag="Light" Content="{l:Tr enum.theme.Light}" Checked="OnThemePicked" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Theme" Tag="Dark" Content="{l:Tr enum.theme.Dark}" Checked="OnThemePicked" />
                    </WrapPanel>
                </Grid>
            </StackPanel>

            <!-- 1 · What K-Desktop does -->
            <StackPanel x:Name="Step1" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr welcome.whatText}" Margin="0,0,0,14" />
                <UniformGrid x:Name="Features" Columns="2" Margin="0,0,-10,0">
                    <Border Style="{StaticResource Feature}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Flash24" Style="{StaticResource FeatureIcon}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FeatureName}" Text="{l:Tr welcome.featCommands}" />
                                <TextBlock Style="{StaticResource FeatureText}" Text="{l:Tr welcome.featCommandsText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="TextBulletListTree24" Style="{StaticResource FeatureIcon}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FeatureName}" Text="{l:Tr welcome.featMenus}" />
                                <TextBlock Style="{StaticResource FeatureText}" Text="{l:Tr welcome.featMenusText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Search24" Style="{StaticResource FeatureIcon}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FeatureName}" Text="{l:Tr welcome.featLauncher}" />
                                <TextBlock Style="{StaticResource FeatureText}" Text="{l:Tr welcome.featLauncherText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Mic24" Style="{StaticResource FeatureIcon}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FeatureName}" Text="{l:Tr welcome.featVoice}" />
                                <TextBlock Style="{StaticResource FeatureText}" Text="{l:Tr welcome.featVoiceText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" Style="{StaticResource FeatureIcon}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FeatureName}" Text="{l:Tr welcome.featKBoard}" />
                                <TextBlock Style="{StaticResource FeatureText}" Text="{l:Tr welcome.featKBoardText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Feature}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Bot24" Style="{StaticResource FeatureIcon}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FeatureName}" Text="{l:Tr welcome.featAssistants}" />
                                <TextBlock Style="{StaticResource FeatureText}" Text="{l:Tr welcome.featAssistantsText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- 2 · The basics: start with Windows, hotkeys -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr welcome.basicsText}" Margin="0,0,0,8" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr welcome.startup}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.startupHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnStartupToggle"
                                     AutomationProperties.Name="{l:Tr welcome.startup}" />
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr welcome.launcherKey}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.launcherKeyHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button v:TrimmedTip.IsEnabled="True" x:Name="LauncherKeyButton" MinWidth="160" Icon="{ui:SymbolIcon Keyboard24}" Click="OnCaptureLauncherKey"
                                   AutomationProperties.Name="{l:Tr welcome.launcherKey}" />
                        <ui:Button x:Name="LauncherKeyClear" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="{l:Tr common.remove}"
                                   AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearLauncherKey">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr welcome.showKey}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.showKeyHint}" />
                    </StackPanel>
                    <Border x:Name="ShowKeyChip" Grid.Column="1" Style="{StaticResource Chip}" Padding="10,4" Margin="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ShowKeyText" Style="{StaticResource ChipText}" />
                    </Border>
                </Grid>
                <Border Style="{StaticResource InfoBox}">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.trayTip}" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- 3 · Voice (optional) -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr welcome.voiceText}" Margin="0,0,0,8" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr welcome.voiceOn}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.voiceOnHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="VoiceToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnVoiceToggle"
                                     AutomationProperties.Name="{l:Tr welcome.voiceOn}" />
                </Grid>
                <StackPanel x:Name="VoicePanel">
                    <Border Style="{StaticResource InfoBox}" Margin="0,4,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="ModelsIcon" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModelsText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ui:Button x:Name="DownloadButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                                               Content="{l:Tr welcome.voiceDownload}" Click="OnDownload" />
                                    <ui:Button x:Name="CancelDownloadButton" Content="{l:Tr common.cancel}" Click="OnCancelDownload" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="ModelsProgress" Margin="0,10,0,0" Height="6" Minimum="0" Maximum="1" />
                        </StackPanel>
                    </Border>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{l:Tr welcome.voiceKey}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.voiceKeyHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button v:TrimmedTip.IsEnabled="True" x:Name="VoiceKeyButton" MinWidth="160" Icon="{ui:SymbolIcon Keyboard24}" Click="OnCaptureVoiceKey"
                                       AutomationProperties.Name="{l:Tr welcome.voiceKey}" />
                            <ui:Button x:Name="VoiceKeyClear" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="{l:Tr common.remove}"
                                       AutomationProperties.Name="{l:Tr common.remove}" Click="OnClearVoiceKey">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{l:Tr welcome.voiceLater}" />
                </StackPanel>
            </StackPanel>

            <!-- 4 · Assistants (optional) -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr welcome.assistantsText}" Margin="0,0,0,8" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{l:Tr welcome.assistantsOn}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.assistantsOnHint}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AssistantToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnAssistantToggle"
                                     AutomationProperties.Name="{l:Tr welcome.assistantsOn}" />
                </Grid>
                <Border Style="{StaticResource InfoBox}">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="AppsAddIn24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Kd.AccentText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:Tr welcome.assistantsBrain}" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- 5 · Ready -->
            <StackPanel x:Name="Step5" Visibility="Collapsed">
                <ui:SymbolIcon x:Name="DoneIcon" Symbol="CheckmarkCircle24" Filled="True" FontSize="56" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Kd.Success}" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <ScaleTransform x:Name="DoneScale" />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
                <TextBlock Style="{StaticResource StepText}" Text="{l:Tr welcome.doneText}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" Text="{l:Tr welcome.again}" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Margin="0,20,0,0">
            <ui:Button x:Name="SkipButton" HorizontalAlignment="Left" Appearance="Transparent" Content="{l:Tr welcome.skip}" Click="OnSkip" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BackButton" Content="{l:Tr wake.back}" Icon="{ui:SymbolIcon ArrowLeft24}" Click="OnBack" Margin="0,0,8,0" />
                <ui:Button x:Name="NextButton" Appearance="Primary" Click="OnNext" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:FluentWindow>
