<ui:FluentWindow x:Class="KDesktop.Views.Dialogs.CalendarPickDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop"
                 Width="420" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <!-- Which calendar: where a .ics goes, which one is exported. -->
    <StackPanel Margin="20,0,20,20">
        <ui:TitleBar Title="{l:Tr agenda.pickCalendar}" ShowMinimize="False" ShowMaximize="False" Margin="-20,0,-20,4" />
        <TextBlock x:Name="Question" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <ComboBox x:Name="CalendarBox" Margin="0,0,0,16">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{l:Tr common.cancel}" Click="OnCancel" Margin="0,0,8,0" />
            <ui:Button Content="{l:Tr common.accept}" Appearance="Primary" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
