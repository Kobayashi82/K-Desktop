<ui:FluentWindow x:Class="KDesktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 Title="K-Desktop 5.0"
                 Width="1300" Height="840"
                 MinWidth="1000" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="K-Desktop 5.0" ShowHelp="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ─────────────────────────────────────────── -->
            <DockPanel Grid.Column="0" Margin="12,4,8,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,22">
                    <Image x:Name="Logo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="K-Desktop" FontSize="19" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="5.0" FontSize="12" Foreground="{DynamicResource Kd.AccentText}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Status (bottom) -->
                <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="12,10" Background="{DynamicResource Kd.Subtle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="HookDot" Width="8" Height="8" Fill="{DynamicResource Kd.Success}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HookText" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="UdpDot" Width="8" Height="8" Fill="{DynamicResource Kd.Success}" VerticalAlignment="Center" />
                            <TextBlock x:Name="UdpText" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavigate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="commands">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.commands}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="quickmenus">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.quickmenus}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="macros">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Record24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.macros}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="kboard">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.kboard}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="achievements">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.achievements}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.settings}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" />
                            <TextBlock Text="{l:Tr nav.about}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- ── Content ─────────────────────────────────────────── -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <DockPanel>
                    <StackPanel x:Name="Banners" DockPanel.Dock="Top" Margin="24,16,24,0" />
                    <ContentControl x:Name="PageHost" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageShift" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
