<ui:FluentWindow x:Class="KDesktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:KDesktop.Localization"
                 xmlns:core="clr-namespace:KDesktop.Core;assembly=KDesktop.Core"
                 Title="{x:Static core:AppPaths.AppName}"
                 Width="1340" Height="860"
                 MinWidth="1180" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <ui:FluentWindow.Resources>
        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static core:AppPaths.AppName}" ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/KDesktop;component/Assets/Icons/KDesktop.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ─────────────────────────────────────────── -->
            <DockPanel Grid.Column="0" Margin="12,4,8,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,22">
                    <Image x:Name="Logo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI">
                        <Run Text="K-Desktop" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Run Text=" " /><Run Text="{x:Static core:AppPaths.ShortVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Kd.AccentText}" />
                    </TextBlock>
                </StackPanel>

                <!-- Status (bottom): one icon per service; tooltip with the details, click to its options -->
                <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="4" Background="{DynamicResource Kd.Subtle}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <UniformGrid x:Name="StatusGrid" Columns="4">
                        <Button x:Name="PauseStatus" Style="{StaticResource StatusButton}" Click="OnPauseStatus">
                            <ui:SymbolIcon x:Name="PauseIcon" Symbol="Power24" FontSize="18" />
                        </Button>
                        <Button x:Name="UdpStatus" Style="{StaticResource StatusButton}" Click="OnUdpStatus">
                            <ui:SymbolIcon x:Name="UdpIcon" Symbol="PlugConnected24" FontSize="18" />
                        </Button>
                        <Button x:Name="WebStatus" Style="{StaticResource StatusButton}" Click="OnWebStatus">
                            <ui:SymbolIcon x:Name="WebIcon" Symbol="Phone24" FontSize="18" />
                        </Button>
                        <Button x:Name="VoiceStatus" Style="{StaticResource StatusButton}" Click="OnVoiceStatus">
                            <ui:SymbolIcon x:Name="VoiceIcon" Symbol="MicOff24" FontSize="18" />
                        </Button>
                        <!-- Only while the assistant module is on -->
                        <Button x:Name="AssistantStatus" Style="{StaticResource StatusButton}" Click="OnAssistantStatus" Visibility="Collapsed">
                            <Grid>
                                <ui:SymbolIcon x:Name="AssistantIcon" Symbol="Bot24" FontSize="18" />
                                <!-- A model of the brain in the graphics card: a dot on its corner -->
                                <Ellipse x:Name="BrainBadge" Width="8" Height="8" Margin="0,-3,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{DynamicResource Kd.Accent}" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </UniformGrid>
                </Border>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavigate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="commands">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.commands}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="events">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowForwardDownLightning24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.events}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="quickmenus">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TextBulletListTree24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.quickmenu}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="kboard">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.kboard}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="macros">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Record24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.macros}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="AssistantNav" Tag="assistant" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Bot24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.assistant}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="history">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.history}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.settings}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="achievements">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.achievements}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="18" Foreground="{DynamicResource Kd.AccentText}" />
                            <TextBlock Text="{l:Tr nav.about}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- ── Content ─────────────────────────────────────────── -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                <DockPanel>
                    <StackPanel x:Name="Banners" DockPanel.Dock="Top" Margin="24,16,24,0" />
                    <ContentControl x:Name="PageHost" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageShift" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </DockPanel>
                <!-- What answers something done in this window (a name already taken, a copy made…): here, not on the OSD -->
                <Border x:Name="NoticeBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" Padding="16,10" MaxWidth="640"
                        CornerRadius="8" BorderThickness="1" Background="{DynamicResource Kd.MenuTintOpaque}" BorderBrush="{DynamicResource Kd.MenuBorder}"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.3" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NoticeShift" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="NoticeIcon" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" MaxWidth="580" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
