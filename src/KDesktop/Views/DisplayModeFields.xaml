<UserControl x:Class="KDesktop.Views.DisplayModeFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- «Pantalla › Resolución»: the monitor, and below its resolution and refresh rate (the native and current ones marked) -->
    <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.monitor}" />
        <ComboBox x:Name="MonitorBox" Margin="0,0,0,12" DisplayMemberPath="Display" SelectionChanged="OnMonitorPicked"
                  AutomationProperties.Name="{l:Tr editor.monitor}" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.resolution}" />
                <ComboBox x:Name="ResolutionBox" DisplayMemberPath="Name" SelectionChanged="OnResolutionPicked" MaxDropDownHeight="420"
                          AutomationProperties.Name="{l:Tr editor.resolution}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr editor.refreshRate}" />
                <ComboBox x:Name="FrequencyBox" DisplayMemberPath="Name" SelectionChanged="OnFrequencyPicked" MaxDropDownHeight="420"
                          AutomationProperties.Name="{l:Tr editor.refreshRate}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
