<UserControl x:Class="KDesktop.Views.SoundPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:local="clr-namespace:KDesktop.Views">
    <!-- Sound chooser: built-in sounds or a .wav file, with preview. Choosing one in the list plays it. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="Box" IsEditable="True" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" local:Placeholder.Text="{l:Tr sound.placeholder}"
                  DropDownOpened="OnDropDownOpened" DropDownClosed="OnDropDownClosed" />
        <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon Play24}" ToolTip="{l:Tr editor.preview}" Click="OnPlay" />
        <ui:Button x:Name="BrowseButton" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}" Click="OnBrowse" />
    </Grid>
</UserControl>
