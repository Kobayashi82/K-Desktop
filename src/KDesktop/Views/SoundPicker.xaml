<UserControl x:Class="KDesktop.Views.SoundPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization"
             xmlns:local="clr-namespace:KDesktop.Views">
    <!-- Sound chooser: built-in sounds or a .wav file (Browse), with preview. Choosing one in the list plays it. -->
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="Box" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged"
                  DropDownOpened="OnDropDownOpened" DropDownClosed="OnDropDownClosed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- A file chosen with Browse is not in the list: nothing is selected and its name shows here, over the combo -->
        <TextBlock x:Name="FileName" Margin="11,0,34,0" FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Play24}" ToolTip="{l:Tr editor.preview}" Click="OnPlay" />
        <ui:Button x:Name="BrowseButton" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:Tr editor.browse}" Click="OnBrowse" />
    </Grid>
</UserControl>
