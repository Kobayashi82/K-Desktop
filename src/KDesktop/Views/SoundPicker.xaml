<UserControl x:Class="KDesktop.Views.SoundPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:KDesktop.Localization">
    <!-- The sound chosen, as a field: a click opens «Elegir sonido» (SoundPickerDialog); the button beside it plays it -->
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button x:Name="Field" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="11,5,8,6" Click="OnOpen"
                   AutomationProperties.HelpText="{l:Tr editor.chooseSound}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="FieldIcon" Symbol="MusicNote224" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource Kd.AccentText}" />
                <TextBlock x:Name="FieldText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Normal" />
                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </ui:Button>
        <ui:Button x:Name="PlayButton" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Play24}" ToolTip="{l:Tr editor.preview}" Click="OnPlay" />
    </Grid>
</UserControl>
