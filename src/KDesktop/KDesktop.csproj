<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>KDesktop</RootNamespace>
    <AssemblyName>KDesktop</AssemblyName>
    <ApplicationIcon>Assets\Icons\KDesktop.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>KDesktop.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KDesktop.Core\KDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\Icons\*.ico" />
  </ItemGroup>

  <!--
    Every Release build also produces the portable copy: artifacts\portable\KDesktop.exe (self-contained, one file).
    It is a separate publish with its own bin/obj (see Directory.Build.props), so it never mixes with this build.
    Skip it with -p:BuildPortable=false.
  -->
  <Target Name="BuildPortable" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(PublishProfile)' != 'SelfContained' and '$(BuildPortable)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PortableDotNet>$(DOTNET_HOST_PATH)</_PortableDotNet>
      <_PortableDotNet Condition="'$(_PortableDotNet)' == ''">dotnet</_PortableDotNet>
    </PropertyGroup>
    <Message Importance="high" Text="KDesktop -&gt; creando el portable en artifacts\portable..." />
    <Exec Command="&quot;$(_PortableDotNet)&quot; publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -p:PublishProfile=SelfContained -nologo -v:minimal" />
  </Target>

  <!--
    The portable folder holds only the exe: clear what a previous publish left there. K-Desktop may be running from
    it: a running exe cannot be deleted but can be renamed, so it is moved aside (*.old, deleted by a later publish
    once it is closed) and the new one goes in its place.
  -->
  <Target Name="CleanPortableDir" BeforeTargets="PrepareForPublish" Condition="'$(PublishProfile)' == 'SelfContained'">
    <ItemGroup>
      <_PortableLeftovers Include="$(PublishDir)\**\*" />
    </ItemGroup>
    <Delete Files="@(_PortableLeftovers)" ContinueOnError="true" />
    <Move Condition="Exists('$(PublishDir)\KDesktop.exe')" SourceFiles="$(PublishDir)\KDesktop.exe"
          DestinationFiles="$(PublishDir)\KDesktop.exe.$([System.DateTime]::Now.ToString('yyyyMMddHHmmss')).old" />
  </Target>

</Project>
