<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>KDesktop</RootNamespace>
    <AssemblyName>KDesktop</AssemblyName>
    <ApplicationIcon>Assets\Icons\KDesktop.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>KDesktop.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KDesktop.Core\KDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\Icons\*.ico" />
    <Content Include="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
