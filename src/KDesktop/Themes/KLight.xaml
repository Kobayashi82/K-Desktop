<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- K-Desktop tokens, light variant. Keys must match KDark.xaml. -->
    <Color x:Key="Kd.AccentColor">#B57F00</Color>
    <SolidColorBrush x:Key="Kd.Accent" Color="#C58A00" />
    <SolidColorBrush x:Key="Kd.AccentSoft" Color="#29C58A00" />
    <SolidColorBrush x:Key="Kd.AccentText" Color="#8F6400" />

    <!-- QuickMenu -->
    <SolidColorBrush x:Key="Kd.MenuTint" Color="#C8F7F7F7" />
    <SolidColorBrush x:Key="Kd.MenuTintOpaque" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="Kd.MenuBorder" Color="#1A000000" />
    <SolidColorBrush x:Key="Kd.MenuText" Color="#E6000000" />
    <SolidColorBrush x:Key="Kd.MenuTextSecondary" Color="#8C000000" />
    <SolidColorBrush x:Key="Kd.MenuHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Kd.MenuPressed" Color="#08000000" />
    <SolidColorBrush x:Key="Kd.MenuSeparator" Color="#14000000" />
    <SolidColorBrush x:Key="Kd.MenuTitle" Color="#0A000000" />

    <!-- OSD -->
    <SolidColorBrush x:Key="Kd.OsdBackground" Color="#F2FBFBFB" />
    <SolidColorBrush x:Key="Kd.OsdBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="Kd.OsdText" Color="#FF1A1A1A" />

    <!-- Main window extras -->
    <SolidColorBrush x:Key="Kd.Subtle" Color="#08000000" />
    <SolidColorBrush x:Key="Kd.SubtleHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Kd.Selected" Color="#14000000" />
    <SolidColorBrush x:Key="Kd.ChipBackground" Color="#0F000000" />
    <SolidColorBrush x:Key="Kd.Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Kd.Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Kd.Warning" Color="#9D5D00" />
</ResourceDictionary>
