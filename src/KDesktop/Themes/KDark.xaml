<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- K-Desktop tokens, dark variant. Keys must match KLight.xaml. -->
    <Color x:Key="Kd.AccentColor">#E0A815</Color>
    <SolidColorBrush x:Key="Kd.Accent" Color="#E0A815" />
    <SolidColorBrush x:Key="Kd.AccentSoft" Color="#33E0A815" />
    <SolidColorBrush x:Key="Kd.AccentText" Color="#F2C14A" />

    <!-- QuickMenu -->
    <SolidColorBrush x:Key="Kd.MenuTint" Color="#B81C1C1E" />
    <SolidColorBrush x:Key="Kd.MenuTintOpaque" Color="#FF242426" />
    <SolidColorBrush x:Key="Kd.MenuBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Kd.MenuText" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Kd.MenuTextSecondary" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="Kd.MenuHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Kd.MenuPressed" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Kd.MenuSeparator" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Kd.MenuTitle" Color="#0FFFFFFF" />

    <!-- OSD -->
    <SolidColorBrush x:Key="Kd.OsdBackground" Color="#E6202022" />
    <SolidColorBrush x:Key="Kd.OsdBorder" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Kd.OsdText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Kd.OsdTextSecondary" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Kd.ToastBorder" Color="#66E0A815" />

    <!-- Achievements -->
    <SolidColorBrush x:Key="Kd.Locked" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Kd.Bar" Color="#E0A815" />
    <SolidColorBrush x:Key="Kd.BarTrack" Color="#14FFFFFF" />

    <!-- Main window extras -->
    <SolidColorBrush x:Key="Kd.Subtle" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Kd.SubtleHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Kd.Selected" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Kd.ChipBackground" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Kd.Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="Kd.DangerSoft" Color="#33FF6B6B" />
    <SolidColorBrush x:Key="Kd.KeyMapped" Color="#5CE0A815" />
    <SolidColorBrush x:Key="Kd.KeyDisabled" Color="#59FF6B6B" />
    <SolidColorBrush x:Key="Kd.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Kd.Warning" Color="#FCB33F" />
</ResourceDictionary>
