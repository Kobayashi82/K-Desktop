<Window x:Class="KDesktop.Launcher.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KDesktop.Launcher"
        xmlns:l="clr-namespace:KDesktop.Localization"
        Title="K-Desktop Clipboard"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="560"
        SizeToContent="Height"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <!-- The launcher's window (LauncherWindow) with a row of filters and the keys at the bottom: same surface, rows and animations -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

        <!-- A filter: the launcher's close button look, filled while it is the one chosen -->
        <Style x:Key="Filter" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="6" Padding="10,4" Background="Transparent">
                            <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="12" Foreground="{DynamicResource Kd.MenuTextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.MenuHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.MenuHover}" />
                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Kd.MenuText}" />
                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type local:ClipboardItem}">
            <Grid x:Name="Row" Height="48" Background="Transparent" Cursor="Hand" Margin="0,1">
                <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource Kd.MenuHover}" Opacity="0" />
                <Border x:Name="Pill" Width="3" Height="20" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0"
                        Background="{DynamicResource Kd.Accent}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PillScale" ScaleY="0" />
                    </Border.RenderTransform>
                </Border>
                <Grid Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Icon" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Source="{Binding Icon}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Kd.MenuText}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Kd.MenuTextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="Pin" Width="10" Height="14" Margin="0,0,8,0" Stretch="Uniform" Fill="{DynamicResource Kd.Accent}" Visibility="Collapsed"
                              Data="M2,0 L8,0 L7,5 L10,8 L5.6,8 L5,14 L4.4,8 L0,8 L3,5 Z" />
                        <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{DynamicResource Kd.MenuTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="Pin" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- A picture shows big in its tooltip -->
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter TargetName="Row" Property="ToolTip">
                        <Setter.Value>
                            <Image Source="{Binding Preview}" MaxWidth="360" MaxHeight="260" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Surface"
            Background="{DynamicResource Kd.MenuTint}"
            BorderBrush="{DynamicResource Kd.MenuBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
        <Grid x:Name="AnimatedRoot" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search box -->
            <Grid Height="48" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CloseButton" Grid.Column="2" Width="30" Height="30" Margin="8,0,-4,0" VerticalAlignment="Center"
                        Focusable="False" Cursor="Hand" ToolTip="{l:Tr common.close}" Click="OnCloseClick"
                        AutomationProperties.Name="{l:Tr common.close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="6" Background="Transparent">
                                <Path x:Name="X" Width="10" Height="10" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{DynamicResource Kd.MenuTextSecondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource Kd.MenuHover}" />
                                    <Setter TargetName="X" Property="Stroke" Value="{DynamicResource Kd.MenuText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Path x:Name="Lens" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" Stretch="Uniform"
                      Stroke="{DynamicResource Kd.Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M7,0 A7,7 0 1 1 6.99,0 M12,12 L17,17" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{x:Null}" VerticalAlignment="Center" FontSize="19"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{DynamicResource Kd.MenuText}" CaretBrush="{DynamicResource Kd.Accent}"
                         SelectionBrush="{DynamicResource Kd.Accent}" AutomationProperties.Name="{l:Tr clipboard.search}" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" VerticalAlignment="Center" FontSize="19" IsHitTestVisible="False"
                           Margin="2,0,0,0" Text="{l:Tr clipboard.search}" Foreground="{DynamicResource Kd.MenuTextSecondary}" />
            </Grid>

            <!-- Filters (Tab goes to the next one) -->
            <StackPanel x:Name="Filters" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,4">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Filter}" GroupName="ClipFilter" Content="{l:Tr clipboard.filter.all}" Tag="all" IsChecked="True" />
                <RadioButton Style="{StaticResource Filter}" GroupName="ClipFilter" Content="{l:Tr clipboard.filter.text}" Tag="text" />
                <RadioButton Style="{StaticResource Filter}" GroupName="ClipFilter" Content="{l:Tr clipboard.filter.images}" Tag="images" />
                <RadioButton Style="{StaticResource Filter}" GroupName="ClipFilter" Content="{l:Tr clipboard.filter.files}" Tag="files" />
                <RadioButton Style="{StaticResource Filter}" GroupName="ClipFilter" Content="{l:Tr clipboard.filter.pinned}" Tag="pinned" />
            </StackPanel>

            <Border x:Name="Divider" Grid.Row="2" Height="1" Margin="4,2,4,4" Background="{DynamicResource Kd.MenuSeparator}" />

            <ScrollViewer x:Name="Scroller" Grid.Row="3" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="ResultsControl" ItemTemplate="{StaticResource ItemTemplate}" Focusable="False" />
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="3" Margin="12,6,12,10" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Kd.MenuTextSecondary}" Visibility="Collapsed" />

            <TextBlock x:Name="KeysText" Grid.Row="4" Margin="12,6,12,2" FontSize="11" TextWrapping="Wrap" Text="{l:Tr clipboard.keys}"
                       Foreground="{DynamicResource Kd.MenuTextSecondary}" />
        </Grid>
    </Border>
</Window>
