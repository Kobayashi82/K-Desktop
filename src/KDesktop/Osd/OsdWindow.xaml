<Window x:Class="KDesktop.Osd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-Desktop OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <!-- Margin leaves room for the shadow -->
    <Grid x:Name="Root" Margin="28" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="Shift" Y="14" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="14"
                Background="{DynamicResource Kd.OsdBackground}"
                BorderBrush="{DynamicResource Kd.OsdBorder}"
                BorderThickness="1"
                Padding="18,11,22,11"
                MinWidth="160"
                MaxWidth="720">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource Kd.Accent}" />
                <TextBlock x:Name="MessageText"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Kd.OsdText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CountdownText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Kd.AccentText}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
