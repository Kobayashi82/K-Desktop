<Window x:Class="KDesktop.Osd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-Desktop OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Width="776"
        Height="300"
        UseLayoutRounding="True">
    <!-- The window never changes size (5.0.112): a window that follows its content is resized from its left edge and only
         then centred again, and the pill was seen jumping. The pill sits inside it, aligned as the position says
         (OsdWindow.Reposition), and grows from there in the same frame. Margin leaves room for the shadow. -->
    <Grid x:Name="Root" Margin="28" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="Shift" Y="14" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="14"
                Background="{DynamicResource Kd.OsdBackground}"
                BorderBrush="{DynamicResource Kd.OsdBorder}"
                BorderThickness="1"
                Padding="18,11,22,11"
                MinWidth="160"
                MaxWidth="720">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
            </Border.Effect>
            <!-- The text wraps (six lines at most, «…» after that); the dot, the meter and the countdown stay by its first line -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,6.5,12,0" VerticalAlignment="Top" Fill="{DynamicResource Kd.Accent}" />
                <!-- Voice: microphone level as five bars (only while listening) -->
                <StackPanel x:Name="Meter" Grid.Column="1" Orientation="Horizontal" Height="18" Margin="0,1,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <StackPanel.Resources>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="3" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Margin" Value="1.5,0" />
                            <Setter Property="RadiusX" Value="1.5" />
                            <Setter Property="RadiusY" Value="1.5" />
                            <Setter Property="Fill" Value="{DynamicResource Kd.AccentText}" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                </StackPanel>
                <TextBlock x:Name="MessageText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Kd.OsdText}"
                           TextWrapping="Wrap"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="20"
                           MaxHeight="120"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CountdownText"
                           Grid.Column="3"
                           Margin="12,0,0,0"
                           VerticalAlignment="Top"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Kd.AccentText}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
