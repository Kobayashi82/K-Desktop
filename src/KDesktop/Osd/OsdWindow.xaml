<Window x:Class="KDesktop.Osd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="K-Desktop OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Width="980"
        Height="420"
        UseLayoutRounding="True">
    <!-- The window never changes size (5.0.112): a window that follows its content is resized from its left edge and only
         then centred again, and the pill was seen jumping. The pills sit inside it, aligned as the position says
         (OsdWindow.Reposition), and grow from there in the same frame. Margin leaves room for the shadow. Big enough for
         the large size with two earlier messages stacked. -->
    <Grid x:Name="Root" Margin="28" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="SizeScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="0.96" ScaleY="0.96" />
                <TranslateTransform x:Name="Shift" Y="14" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Earlier messages that were still showing when a new one came: smaller, away from the screen edge -->
        <StackPanel x:Name="History" Grid.Row="0" />

        <Border x:Name="Pill"
                Grid.Row="1"
                CornerRadius="14"
                Background="{DynamicResource Kd.OsdBackground}"
                BorderBrush="{DynamicResource Kd.OsdBorder}"
                BorderThickness="1"
                Padding="12,10,20,10"
                MinWidth="160"
                MaxWidth="720">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
            </Border.Effect>
            <!-- The text wraps (six lines at most, «…» after that); the icon, the meter and the countdown stay by its first line -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- What it is about, in the colour of its kind -->
                <Border x:Name="Badge" Width="28" Height="28" CornerRadius="14" Margin="0,-4,11,-4" VerticalAlignment="Top">
                    <ui:SymbolIcon x:Name="BadgeIcon" Symbol="Info24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Voice: microphone level as five bars (only while listening) -->
                <StackPanel x:Name="Meter" Grid.Column="1" Orientation="Horizontal" Height="18" Margin="4,1,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <StackPanel.Resources>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="3" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Margin" Value="1.5,0" />
                            <Setter Property="RadiusX" Value="1.5" />
                            <Setter Property="RadiusY" Value="1.5" />
                            <Setter Property="Fill" Value="{DynamicResource Kd.AccentText}" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2" /></Rectangle.RenderTransform></Rectangle>
                </StackPanel>
                <TextBlock x:Name="MessageText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Kd.OsdText}"
                           TextWrapping="Wrap"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="20"
                           MaxHeight="120"
                           TextTrimming="CharacterEllipsis" />
                <!-- Volume, brightness…: how much, as a bar -->
                <Border x:Name="LevelTrack" Grid.Column="3" Width="132" Height="6" CornerRadius="3" Margin="16,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource Kd.OsdTrack}" Visibility="Collapsed">
                    <Border x:Name="LevelFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{DynamicResource Kd.Accent}" />
                </Border>
                <TextBlock x:Name="CountdownText"
                           Grid.Column="4"
                           Margin="12,0,0,0"
                           VerticalAlignment="Top"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Kd.AccentText}"
                           Visibility="Collapsed" />
                <!-- How long it stays: empties from the right -->
                <Border x:Name="TimeLine" Grid.Row="1" Grid.ColumnSpan="5" Height="2" CornerRadius="1" Margin="2,9,-10,-5"
                        Background="{DynamicResource Kd.Accent}" Opacity="0.45" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TimeScale" ScaleX="1" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
