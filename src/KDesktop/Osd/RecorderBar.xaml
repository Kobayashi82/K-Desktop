<Window x:Class="KDesktop.Osd.RecorderBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="K-Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="26" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="-24" />
        </Grid.RenderTransform>
        <Border CornerRadius="22" Background="{DynamicResource Kd.OsdBackground}" BorderBrush="{DynamicResource Kd.OsdBorder}" BorderThickness="1"
                Padding="16,8,12,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- Countdown -->
                <Grid x:Name="CountdownPanel" Width="26" Height="26" VerticalAlignment="Center">
                    <TextBlock x:Name="CountdownText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Kd.AccentText}" RenderTransformOrigin="0.5,0.5" FontFamily="Segoe UI Variable Display, Segoe UI">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <!-- Recording dot -->
                <Grid x:Name="DotPanel" Width="26" Height="26" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse x:Name="Halo" Width="22" Height="22" Fill="#55E5484D" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HaloScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#FFE5484D" />
                </Grid>
                <StackPanel Margin="10,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Kd.OsdText}"
                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <TextBlock x:Name="InfoText" FontSize="11.5" Foreground="{DynamicResource Kd.OsdTextSecondary}" />
                </StackPanel>
                <ui:Button x:Name="PauseButton" Appearance="Transparent" Padding="8" MinWidth="0" Click="OnPause" Margin="0,0,4,0" IsEnabled="False">
                    <ui:SymbolIcon x:Name="PauseIcon" Symbol="Pause24" FontSize="18" />
                </ui:Button>
                <ui:Button x:Name="StopButton" Appearance="Danger" Padding="12,7" Click="OnStop">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="RecordStop24" Filled="True" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock x:Name="StopText" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
