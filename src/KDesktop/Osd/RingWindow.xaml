<Window x:Class="KDesktop.Osd.RingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="K-Desktop OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Width="480"
        Height="440"
        UseLayoutRounding="True">
    <!-- Countdowns: a ring that empties with the seconds in the middle and the message
         below. Fixed size like the OSD, so nothing jumps; RingWindow.Reposition puts the ring's centre a little below the
         middle of the screen. Margin leaves room for the shadow. -->
    <StackPanel x:Name="Root" Margin="28" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.3">
        <StackPanel.LayoutTransform>
            <ScaleTransform x:Name="SizeScale" ScaleX="1" ScaleY="1" />
        </StackPanel.LayoutTransform>
        <StackPanel.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="0.9" ScaleY="0.9" />
        </StackPanel.RenderTransform>

        <Grid x:Name="Disc" Width="164" Height="164" HorizontalAlignment="Center">
            <Ellipse Fill="{DynamicResource Kd.OsdBackground}" Stroke="{DynamicResource Kd.OsdBorder}" StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Margin="14" Stroke="{DynamicResource Kd.OsdTrack}" StrokeThickness="8" />
            <!-- The time left, clockwise from the top -->
            <Path x:Name="Arc" Stroke="{DynamicResource Kd.Accent}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon x:Name="RingIcon" Symbol="Timer24" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,-2"
                               Foreground="{DynamicResource Kd.AccentText}" />
                <TextBlock x:Name="Number"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Kd.OsdText}" />
            </StackPanel>
        </Grid>

        <Border x:Name="Pill"
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                CornerRadius="14"
                Background="{DynamicResource Kd.OsdBackground}"
                BorderBrush="{DynamicResource Kd.OsdBorder}"
                BorderThickness="1"
                Padding="18,9"
                MaxWidth="400">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <TextBlock x:Name="MessageText"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Kd.OsdText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxHeight="80"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </StackPanel>
</Window>
