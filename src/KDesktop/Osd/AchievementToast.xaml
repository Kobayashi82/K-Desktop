<Window x:Class="KDesktop.Osd.AchievementToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="K-Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Cursor="Hand">
    <!-- Margin leaves room for the shadow and the burst -->
    <Grid x:Name="Root" Margin="30" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform x:Name="RootShift" X="70" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="16" Background="{DynamicResource Kd.OsdBackground}" BorderBrush="{DynamicResource Kd.ToastBorder}"
                BorderThickness="1" Width="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.38" Color="Black" />
            </Border.Effect>
            <Grid>
                <!-- Content, clipped so the shine stays inside the card -->
                <Grid x:Name="Card" ClipToBounds="True">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="CardClip" RadiusX="16" RadiusY="16" />
                    </Grid.Clip>

                    <!-- Warm glow from the left -->
                    <Border Opacity="0.55">
                        <Border.Background>
                            <RadialGradientBrush Center="0.12,0.5" GradientOrigin="0.12,0.5" RadiusX="0.55" RadiusY="1.3">
                                <GradientStop Color="#55E0A815" Offset="0" />
                                <GradientStop Color="#00E0A815" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="18,16,32,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Badge with burst ring -->
                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                            <Ellipse x:Name="Burst" Stroke="{DynamicResource Kd.Accent}" StrokeThickness="2.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="BurstScale" ScaleX="0.6" ScaleY="0.6" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid x:Name="Badge" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="BadgeScale" ScaleX="0" ScaleY="0" />
                                        <RotateTransform x:Name="BadgeRotate" Angle="-25" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFF6D365" Offset="0" />
                                            <GradientStop Color="#FFE0A815" Offset="0.55" />
                                            <GradientStop Color="#FFB7790B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Margin="4" Stroke="#66FFFFFF" StrokeThickness="1" />
                                <ui:SymbolIcon x:Name="BadgeIcon" Symbol="Trophy24" FontSize="30" Foreground="#FF3A2600"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Kicker" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Kd.AccentText}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI" />
                            <TextBlock x:Name="NameText" Margin="0,2,0,0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource Kd.OsdText}" />
                            <TextBlock x:Name="DescText" Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Kd.OsdTextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Shine sweep -->
                    <Rectangle x:Name="Shine" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#2EFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleX="-20" />
                                <TranslateTransform x:Name="ShineShift" X="-140" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- Remaining time -->
                    <Rectangle x:Name="TimeBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource Kd.Accent}" Opacity="0.85"
                               RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="TimeScale" ScaleX="1" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <!-- Close (stronger on hover of the card) -->
                <Button x:Name="CloseButton" Width="24" Height="24" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Cursor="Arrow" Opacity="0.45" Focusable="False" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="12" Background="Transparent">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource Kd.OsdText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#33808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
