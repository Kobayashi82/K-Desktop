<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The assistants' brain (phase 3): the AI providers (Ollama, llama-swap, OpenAI compatible), choosing the model,
    installing Ollama and downloading models, the way an order goes (fixed rules, then the AI with the assistant's
    persona) and later the memory. It runs in the assistant process (as the normal user), never in K-Desktop. Ported
    from Kobii.Brain.
  -->
  <PropertyGroup>
    <RootNamespace>KDesktop.Assistant.Brain</RootNamespace>
    <AssemblyName>KDesktop.Assistant.Brain</AssemblyName>
    <!-- LibraryImport (the job object that holds llama-server) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KDesktop.Core\KDesktop.Core.csproj" />
    <ProjectReference Include="..\KDesktop.Assistant.Tools\KDesktop.Assistant.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KDesktop.Assistant.Tests" />
  </ItemGroup>

</Project>
