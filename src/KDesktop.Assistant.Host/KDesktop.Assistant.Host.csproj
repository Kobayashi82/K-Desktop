<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The assistant process (assistant mode of KDesktop.exe, as the normal user): the overlay and its rendering, the world, the
    package loader and the client end of the pipe. It ships inside KDesktop.exe but is only loaded in that mode:
    with the module off, K-Desktop never touches this assembly.
  -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>KDesktop.Assistant.Host</RootNamespace>
    <AssemblyName>KDesktop.Assistant.Host</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF leaves System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Direct3D 11, Direct2D and DirectComposition for the overlay (the same as Lander and Kobii). MIT. -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KDesktop.Core\KDesktop.Core.csproj" />
    <ProjectReference Include="..\KDesktop.Assistant.Sdk\KDesktop.Assistant.Sdk.csproj" />
    <ProjectReference Include="..\KDesktop.Assistant.Brain\KDesktop.Assistant.Brain.csproj" />
    <ProjectReference Include="..\KDesktop.Assistant.Tools\KDesktop.Assistant.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KDesktop.Assistant.Tests" />
  </ItemGroup>

</Project>
