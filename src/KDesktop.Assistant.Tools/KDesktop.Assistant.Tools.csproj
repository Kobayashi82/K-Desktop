<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The assistants' tools (stage 3.3): what a tool is, the registry, the permissions, the activity with undo, and the
    built-in tools (ported from Kobii), the JSON tools and the MCP servers' tools. They run in the assistant process,
    as the normal user, never in K-Desktop.
  -->
  <PropertyGroup>
    <RootNamespace>KDesktop.Assistant.Tools</RootNamespace>
    <AssemblyName>KDesktop.Assistant.Tools</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows Search index (find_files, stage 8.2). -->
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
    <!-- MCP servers (stage 9.2): the official C# SDK, client only (Apache-2.0). -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- The text of a PDF the user gives an assistant (stage 14.1; Apache-2.0). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KDesktop.Core\KDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KDesktop.Assistant.Tests" />
  </ItemGroup>

</Project>
