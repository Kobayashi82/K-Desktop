<Project Sdk="Microsoft.NET.Sdk">

  <!-- A K-Desktop assistant. `dotnet build` makes bin\…\<id>-<version>.kai (see Package\assistant.json). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyAssistant</RootNamespace>
    <!-- Empty: the SDK from NuGet. Or the folder of KDesktop.Assistant.Sdk in a clone of K-Desktop, to build against it. -->
    <KDesktopAssistantSdk Condition="'$(KDesktopAssistantSdk)' == ''">SDK_FOLDER</KDesktopAssistantSdk>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <None Remove="Package\**" />
  </ItemGroup>

  <!-- The host provides the SDK: compile against it, never ship it. -->
  <ItemGroup Condition="'$(KDesktopAssistantSdk)' == ''">
    <PackageReference Include="KDesktop.Assistant.Sdk" Version="SDK_VERSION" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(KDesktopAssistantSdk)' != ''">
    <ProjectReference Include="$(KDesktopAssistantSdk)\KDesktop.Assistant.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <Import Condition="'$(KDesktopAssistantSdk)' != ''" Project="$(KDesktopAssistantSdk)\build\KDesktop.Assistant.Sdk.targets" />

</Project>
