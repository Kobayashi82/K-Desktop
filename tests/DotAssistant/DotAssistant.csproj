<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dot, the assistant of the tests (stage 13.12: it was the example until then; the examples are now the template and
    Pip): a dot that teleports, knows Communicate and React, and has an extra, one settings page and a panel with a card
    and a button. DOT_GESTURES and DOT_SPEECH change what it does in the tests. `dotnet build` makes bin\…\dot-x.y.z.kai.
  -->
  <PropertyGroup>
    <!-- Not the Windows 10 TFM of K-Desktop (Directory.Build.props): assistants compile against this. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>DotAssistant</RootNamespace>
    <AssemblyName>DotAssistant</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides the SDK: compile against it, never ship it. -->
    <ProjectReference Include="..\..\src\KDesktop.Assistant.Sdk\KDesktop.Assistant.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Package\**" />
  </ItemGroup>

  <Import Project="..\..\src\KDesktop.Assistant.Sdk\build\KDesktop.Assistant.Sdk.targets" />

</Project>
