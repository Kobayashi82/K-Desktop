<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the assistant module: contracts (pipe messages, package schemas), SDK, and later the router, the
       tools and the choreographer with DotAssistant. `dotnet test tests\KDesktop.Assistant.Tests`. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF leaves System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KDesktop.Assistant.Sdk\KDesktop.Assistant.Sdk.csproj" />
    <ProjectReference Include="..\..\src\KDesktop.Core\KDesktop.Core.csproj" />
    <ProjectReference Include="..\..\src\KDesktop.Assistant.Host\KDesktop.Assistant.Host.csproj" />
    <!-- Only built first: the process tests start the real KDesktop.exe in assistant mode. -->
    <ProjectReference Include="..\..\src\KDesktop\KDesktop.csproj" ReferenceOutputAssembly="false" />
    <!-- Its package (bin\…\package) is loaded by the package tests. -->
    <ProjectReference Include="..\..\samples\DotAssistant\DotAssistant.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The contract files live in docs\assistant: the tests read them from there. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DocsDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\docs\assistant</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KDesktopExe</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\KDesktop\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\KDesktop.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
