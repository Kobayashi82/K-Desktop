{
  "$schema": "../../../docs/assistant/esquemas/settings.schema.json",
  "pages": [
    {
      "title": { "es": "Dot", "en": "Dot", "fr": "Dot", "de": "Dot", "it": "Dot", "pt": "Dot" },
      "sections": [
        {
          "items": [
            {
              "type": "slider",
              "key": "size",
              "label": { "es": "Tamaño", "en": "Size", "fr": "Taille", "de": "Größe", "it": "Dimensione", "pt": "Tamanho" },
              "min": 12, "max": 64, "step": 2, "default": 28, "format": "{0} px"
            },
            {
              "type": "choice",
              "key": "color",
              "label": { "es": "Color", "en": "Colour", "fr": "Couleur", "de": "Farbe", "it": "Colore", "pt": "Cor" },
              "options": [
                { "value": "blue", "label": { "es": "Azul", "en": "Blue", "fr": "Bleu", "de": "Blau", "it": "Blu", "pt": "Azul" } },
                { "value": "orange", "label": { "es": "Naranja", "en": "Orange", "fr": "Orange", "de": "Orange", "it": "Arancione", "pt": "Laranja" } },
                { "value": "green", "label": { "es": "Verde", "en": "Green", "fr": "Vert", "de": "Grün", "it": "Verde", "pt": "Verde" } }
              ],
              "default": "blue"
            },
            {
              "type": "toggle",
              "key": "wander",
              "label": { "es": "Saltar solo de vez en cuando", "en": "Jump on its own now and then", "fr": "Sauter tout seul de temps en temps", "de": "Ab und zu von selbst springen", "it": "Saltare da solo ogni tanto", "pt": "Saltar sozinho de vez em quando" },
              "default": true
            },
            {
              "type": "button",
              "label": { "es": "Saltar ahora", "en": "Jump now", "fr": "Sauter maintenant", "de": "Jetzt springen", "it": "Salta ora", "pt": "Saltar agora" },
              "extra": "dot.jump"
            }
          ]
        },
        {
          "title": { "es": "Saltos", "en": "Jumps", "fr": "Sauts", "de": "Sprünge", "it": "Salti", "pt": "Saltos" },
          "items": [
            {
              "type": "button",
              "label": { "es": "Poner a cero los saltos", "en": "Reset the jumps", "fr": "Remettre les sauts à zéro", "de": "Sprünge zurücksetzen", "it": "Azzera i salti", "pt": "Zerar os saltos" },
              "description": { "es": "Borra el contador del panel.", "en": "Clears the counter on the panel.", "fr": "Efface le compteur du panneau.", "de": "Löscht den Zähler im Panel.", "it": "Cancella il contatore del pannello.", "pt": "Apaga o contador do painel." },
              "resetData": true
            }
          ]
        }
      ]
