{
  "$schema": "../../../docs/assistant/schemas/assistant.schema.json",
  "id": "pip",
  "name": "Pip",
  "version": "1.6.0",
  "author": "Kobayashi82",
  "description": {
    "es": "Ejemplo de asistente sin código: una gota que pasea por la barra de tareas y por tus ventanas. Solo imágenes y JSON.",
    "en": "Example assistant without code: a drop that strolls along the taskbar and your windows. Only images and JSON.",
    "fr": "Exemple d’assistant sans code : une goutte qui se promène sur la barre des tâches et vos fenêtres. Seulement des images et du JSON.",
    "de": "Beispielassistent ohne Code: ein Tropfen, der über die Taskleiste und deine Fenster spaziert. Nur Bilder und JSON.",
    "it": "Esempio di assistente senza codice: una goccia che passeggia sulla barra delle applicazioni e sulle tue finestre. Solo immagini e JSON.",
    "pt": "Exemplo de assistente sem código: uma gota que passeia pela barra de tarefas e pelas suas janelas. Só imagens e JSON."
  },
  "homepage": "https://github.com/Kobayashi82/K-Desktop",
  "license": "MIT",
  "sdk": "1.21",
  "entry": "character.json",
  "icon": "icon.png",
  "wakeWord": "Pip",
  "traits": {
    "travel": "walk",
    "travelSpeed": 70,
    "canMoveWindows": false,
    "canReachMaximized": false,
    "gestures": ["communicate", "react", "announce"]
  },
  "changes": {
    "es": "Ya no flota: sus pies tocan la barra de tareas y los bordes de las ventanas.",
    "en": "No longer floats: its feet touch the taskbar and the tops of the windows.",
    "fr": "Ne flotte plus : ses pieds touchent la barre des tâches et le haut des fenêtres.",
    "de": "Schwebt nicht mehr: Seine Füße berühren die Taskleiste und die Fensterkanten.",
    "it": "Non galleggia più: i suoi piedi toccano la barra delle applicazioni e i bordi delle finestre.",
    "pt": "Não flutua mais: seus pés tocam a barra de tarefas e o topo das janelas."
  },
