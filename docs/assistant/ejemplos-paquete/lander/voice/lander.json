{
  "$schema": "../../../schemas/voice.schema.json",
  "name": "Control de misión",
  "engine": { "type": "kokoro", "voice": "default", "speed": 1.05 },
  "chain": [
    { "fx": "pitch", "semitones": 2 },
    { "fx": "radio", "bandwidth": 3200, "noise": 0.03, "beep": true },
    { "fx": "ring", "freq": 40, "mix": 0.1 }
  ],
  "moods": {
    "error": [{ "fx": "glitch", "chance": 0.15 }],
    "far": [{ "fx": "radio", "bandwidth": 2400, "noise": 0.08, "beep": true }],
    "happy": [{ "fx": "pitch", "semitones": 2 }]
  }
}
