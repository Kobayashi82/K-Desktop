{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdesktop/assistant/tool.schema.json",
  "title": "JSON tool",
  "description": "A tool for the assistants without building anything: one file per tool in <data>\\Assistant\\Tools. It is reloaded on save. Guide in docs/assistant/herramientas.md.",
  "type": "object",
  "required": ["name", "type", "description"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^(?!mcp_)[a-z][a-z0-9_]{1,47}$",
      "description": "Its name for the model: lowercase letters, numbers and _ (OpenAI-compatible servers do not take dots). mcp_ is reserved"
    },
    "type": { "enum": ["http", "kdesktop", "routine", "script"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 400, "description": "For the model: what it does and when to use it, in one or two sentences" },
    "examples": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "description": "Sentences that ask for it; they decide whether it reaches the model"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 12,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$", "not": { "enum": ["result", "status"] } },
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The parameters the model must give; without this list, those without a default"
    },
    "risk": { "enum": ["safe", "askOnce", "askAlways"], "description": "safe: without asking; askOnce: the first time; askAlways: always. safe by default (script: askOnce)" },
    "readsOnly": { "type": "boolean", "description": "It only looks something up (the weather, a state): the model answers with what it returns" },
    "intent": { "type": "string", "maxLength": 160, "description": "What it is going to do, for the user (with {{parameters}}): «turn on the living room light»" },
    "say": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "string", "maxLength": 300 },
        "error": { "type": "string", "maxLength": 300 }
      },
      "description": "What the assistant says when it ends well or badly (with {{parameters}}, {{result}}, {{result.field}}, {{status}})"
    },
    "gesture": {
      "enum": ["waitForWindow", "tray", "clock", "typing"],
      "description": "What the character does while it works: waitForWindow = waits for the window of what it opens; tray = goes to the tray; clock = leaves a mark on the clock; typing = types in the window in front. Not needed in kdesktop ones: the command is already seen"
    },
    "enabled": { "type": "boolean" },
    "timeout": { "type": "number", "minimum": 1, "maximum": 300, "description": "Seconds at most (15 by default; script: 30)" },
    "request": { "$ref": "#/$defs/request" },
    "command": { "type": "string", "minLength": 1, "maxLength": 200, "description": "kdesktop: the name of one of the user's commands (accepts {{parameters}})" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/step" }
    },
    "script": { "$ref": "#/$defs/script" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "http" } } }, "then": { "required": ["request"] } },
    { "if": { "properties": { "type": { "const": "kdesktop" } } }, "then": { "required": ["command"] } },
    { "if": { "properties": { "type": { "const": "routine" } } }, "then": { "required": ["steps"] } },
    { "if": { "properties": { "type": { "const": "script" } } }, "then": { "required": ["script"] } }
  ],
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean"] },
        "description": { "type": "string", "maxLength": 300 },
        "enum": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "integer"] } },
        "default": { "type": ["string", "number", "integer", "boolean"] },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "strings": { "type": "object", "additionalProperties": { "type": "string" } },
    "request": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "url": { "type": "string", "pattern": "^https?://", "description": "Accepts {{parameters}} and {{secret:name}}" },
        "headers": { "$ref": "#/$defs/strings" },
        "query": { "$ref": "#/$defs/strings" },
        "body": { "description": "JSON; a string that is only \"{{parameter}}\" is replaced keeping its type (number, true/false)" },
        "bodyText": { "type": "string", "description": "The body as text, instead of body" },
        "contentType": { "type": "string" },
        "pick": { "type": "string", "description": "The part of the JSON answer given to the model: state, attributes.temperature, items.0.name" }
      },
      "not": { "required": ["body", "bodyText"] }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$", "description": "Another tool (built in or JSON, not another routine)" },
        "arguments": { "type": "object", "description": "Its arguments (they accept the routine's {{parameters}})" },
        "command": { "type": "string", "minLength": 1, "description": "One of the user's K-Desktop commands" },
        "wait": { "type": "number", "minimum": 0, "maximum": 30, "description": "Seconds to wait" },
        "continueOnError": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["tool"], "not": { "anyOf": [{ "required": ["command"] }, { "required": ["wait"] }] } },
        { "required": ["command"], "not": { "anyOf": [{ "required": ["tool"] }, { "required": ["wait"] }, { "required": ["arguments"] }] } },
        { "required": ["wait"], "not": { "anyOf": [{ "required": ["tool"] }, { "required": ["command"] }, { "required": ["arguments"] }] } }
      ]
    },
    "script": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "\\.(ps1|bat|cmd|py|js|exe)$", "description": "Path of the script (relative to the Tools folder, or full): .ps1, .bat, .cmd, .py (with uv if it is there), .js (node) or .exe" },
        "args": { "type": "array", "maxItems": 20, "items": { "type": "string" }, "description": "Its arguments (they accept {{parameters}})" },
        "env": { "$ref": "#/$defs/strings", "description": "Environment variables (the usual place for {{secret:…}})" }
      }
    }
  }
}
