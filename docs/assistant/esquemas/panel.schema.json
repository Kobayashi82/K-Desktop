{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdesktop/assistant/panel.schema.json",
  "title": "Panel de un asistente (panel.json)",
  "description": "Pestaña propia del asistente en Panel → Asistente. Los datos («bind») los publica el asistente con PublishPanel; los botones lanzan sus extras.",
  "type": "object",
  "required": ["cards"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
  },
  "$defs": {
    "text": { "$ref": "common.schema.json#/$defs/text" },
    "bind": { "$ref": "common.schema.json#/$defs/key" },
    "card": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["stat", "progress", "list", "achievements", "buttons", "text"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "stat" } } },
          "then": {
            "required": ["label", "bind"],
            "additionalProperties": false,
            "properties": {
              "type": true,
              "label": { "$ref": "#/$defs/text" },
              "bind": { "$ref": "#/$defs/bind" },
              "format": { "type": "string" },
              "icon": { "$ref": "common.schema.json#/$defs/icon" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "progress" } } },
          "then": {
            "required": ["label", "bind", "max"],
            "additionalProperties": false,
            "properties": {
              "type": true,
              "label": { "$ref": "#/$defs/text" },
              "bind": { "$ref": "#/$defs/bind" },
              "max": { "description": "Número fijo o clave publicada.", "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/bind" }] },
              "format": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": {
            "required": ["label", "bind"],
            "additionalProperties": false,
            "properties": {
              "type": true,
              "label": { "$ref": "#/$defs/text" },
              "bind": { "description": "Lista de textos.", "$ref": "#/$defs/bind" },
              "empty": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "achievements" } } },
          "then": {
            "required": ["bind"],
            "additionalProperties": false,
            "properties": {
              "type": true,
              "label": { "$ref": "#/$defs/text" },
              "bind": { "description": "Lista de { id, name, description, unlocked, progress (0…1), icon }.", "$ref": "#/$defs/bind" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "buttons" } } },
          "then": {
            "required": ["items"],
            "additionalProperties": false,
            "properties": {
              "type": true,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["label", "extra"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "$ref": "#/$defs/text" },
                    "extra": { "$ref": "common.schema.json#/$defs/id" },
                    "icon": { "$ref": "common.schema.json#/$defs/icon" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "label": { "$ref": "#/$defs/text" },
              "text": { "$ref": "#/$defs/text" },
              "bind": { "$ref": "#/$defs/bind" }
            },
            "oneOf": [{ "required": ["text"] }, { "required": ["bind"] }]
          }
        }
      ]
    }
  }
}
