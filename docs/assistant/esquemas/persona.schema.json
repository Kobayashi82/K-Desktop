{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdesktop/assistant/persona.schema.json",
  "title": "Personalidad de un asistente (persona/<idioma>.json)",
  "description": "Instrucciones para la IA y frases fijas (las que dice sin IA). Si falta una clave de frases, se usa la del módulo.",
  "type": "object",
  "required": ["prompt"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "prompt": {
      "description": "Cómo es y cómo habla. Corto: va en cada petición a la IA.",
      "type": "string",
      "minLength": 10,
      "maxLength": 1200
    },
    "phrases": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "properties": {
        "ok": { "$ref": "#/$defs/list" },
        "confirm": { "$ref": "#/$defs/list" },
        "notFound": { "$ref": "#/$defs/list" },
        "error": { "$ref": "#/$defs/list" },
        "greeting": { "$ref": "#/$defs/list" },
        "goodbye": { "$ref": "#/$defs/list" },
        "busy": { "$ref": "#/$defs/list" },
        "which": { "description": "Ante dos candidatos: «{0}» y «{1}».", "$ref": "#/$defs/list" },
        "cancelled": { "$ref": "#/$defs/list" }
      },
      "additionalProperties": { "$ref": "#/$defs/list" }
    }
  },
  "$defs": {
    "list": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
