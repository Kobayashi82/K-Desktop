<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>5.0.61</Version>
    <!-- The Android app has a version of its own: raise it only when android\ changes (see tools\android\build-apk.ps1). -->
    <AndroidVersion>1.0.1</AndroidVersion>
    <Authors>Kobayashi82</Authors>
    <Company>Kobayashi82</Company>
    <Product>K-Desktop</Product>
    <AssemblyTitle>K-Desktop</AssemblyTitle>
    <Description>K-Desktop: lanzador de acciones, atajos de teclado y control remoto para el escritorio.</Description>
    <Copyright>© Kobayashi82</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The recommended .NET analyzers everywhere; the rules that do not fit (Win32 names…) are in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- The portable publish (PublishProfile=SelfContained) builds in its own folders so it never mixes with the normal build. -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'SelfContained'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\build\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\build\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <!-- …and must not pick up the generated sources of the normal build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Release ships without PDBs: a smaller, cleaner output and one less thing for antivirus heuristics. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
